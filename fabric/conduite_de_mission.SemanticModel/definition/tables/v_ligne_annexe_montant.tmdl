	measure 'Tuile de l article' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = SELECTEDVALUE ( v_ligne_annexe_montant[article] ) VAR t = FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a && v_cellules_a_remplir[article] = ar ) VAR rem = MAXX ( t, v_cellules_a_remplir[cellules_a_remplir] ) VAR tot = MAXX ( t, v_cellules_a_remplir[cellules] ) RETURN IF ( ISBLANK ( ar ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( ISBLANK ( tot ), "sans cellule", FORMAT ( rem, "0" ) & " / " & FORMAT ( tot, "0" ) & IF ( tot > 1, " lignes", " ligne" ) ) )
		lineageTag: e91f13c0-81c5-42ec-9aed-7a6a72a71a76

	measure 'Fond tuile de l article' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = SELECTEDVALUE ( v_ligne_annexe_montant[article] ) VAR t = FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a && v_cellules_a_remplir[article] = ar ) VAR rem = MAXX ( t, v_cellules_a_remplir[cellules_a_remplir] ) VAR tot = MAXX ( t, v_cellules_a_remplir[cellules] ) RETURN IF ( ISBLANK ( tot ), "#F4F6F8", IF ( rem > 0, "#FBF4E4", "#F2F7F3" ) )
		lineageTag: 223da284-d141-4ec9-b477-ed9680a67e2d

	measure 'Encre tuile de l article' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = SELECTEDVALUE ( v_ligne_annexe_montant[article] ) VAR t = FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a && v_cellules_a_remplir[article] = ar ) VAR rem = MAXX ( t, v_cellules_a_remplir[cellules_a_remplir] ) VAR tot = MAXX ( t, v_cellules_a_remplir[cellules] ) RETURN IF ( ISBLANK ( tot ), "#5B6B7D", IF ( rem > 0, "#8A6710", "#1F6D4A" ) )
		lineageTag: d8d5e913-a116-4156-8795-fd7dbbc0d4b3

	measure 'Aide de la cellule' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = [Article choisi] VAR fe = [Saisie de l annexe fermee] VAR tc = FILTER ( ALL ( v_annexe_cellule ), v_annexe_cellule[entite] = e && v_annexe_cellule[arrete] = a && v_annexe_cellule[article] = ar ) VAR np = COUNTROWS ( FILTER ( tc, v_annexe_cellule[nature] IN { "texte", "source" } || v_annexe_cellule[etat] = "A_REMPLIR" ) ) + 0 VAR nr = COUNTROWS ( FILTER ( tc, v_annexe_cellule[etat] = "A_REMPLIR" ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", IF ( NOT ISBLANK ( fe ), fe, IF ( ISBLANK ( ar ), "", IF ( np = 0, "aucune cellule à remplir ni à saisir", FORMAT ( np, "0" ) & IF ( np > 1, " cellules proposées : ", " cellule proposée : " ) & FORMAT ( nr, "0" ) & " à remplir" ) ) ) )
		lineageTag: 4ab5f950-e74a-456a-b295-59fbd639c5a5

	measure 'Annexe colonnes de la ligne' = VAR ar = SELECTEDVALUE ( v_ligne_annexe_montant[article] ) VAR co = SELECTEDVALUE ( v_ligne_annexe_montant[code] ) RETURN SWITCH ( TRUE (), ar = "331-1" && co IN { "PRINCIPE" }, "|1|", ar = "332-1" && co IN { "STRATEGIE" }, "|1|", ar = "332-1" && co IN { "ACTIF_NET", "NB_PARTS", "VL_UNIT", "DIST_CESSION", "DIST_RESULTAT", "CAPITALISATION" }, "|1|2|3|4|5|", ar = "333-3" && co IN { "RENVOI_1" }, "|1|", ar = "334-3" && co IN { "TOTAL" }, "|1|2|3|4|5|6|", ar = "334-3" && co IN { "ASSIETTE", "REDEVANCES_N", "REDEVANCES_CUM", "RESTANT_1AN", "RESTANT_1_5ANS", "RESTANT_5ANS", "PRIX_RESIDUEL", "PRIX_RESIDUEL_1AN", "PRIX_RESIDUEL_1_5ANS", "PRIX_RESIDUEL_5ANS" }, "|1|", ar = "334-5" && co IN { "PARTS_2", "PARTS_3", "TOTAL", "TOTAL_HORS_FRAIS" }, "|1|2|3|4|5|6|", ar = "334-5" && co IN { "SECTEURS" }, "|1|", ar = "334-6" && co IN { "COMPTES_COURANTS", "ECHEANCE", "TOTAL" }, "|1|2|3|4|5|", ar = "335-10" && co IN { "PCT_ACTIF_NET_MOYEN" }, "|1|", ar = "335-10" && co IN { "FRAIS_EXTERNES_NATURE" }, "|1|", ar = "335-10" && co IN { "SURPERFORMANCE" }, "|1|", ar = "335-12" && co IN { "DETAIL_CATEGORIES" }, "|1|", ar = "335-2" && co IN { "CL", "CL_1", "CL_2", "CL_3", "CL_ST", "AC", "AC_1", "AC_2", "AC_3", "AC_4", "AC_5", "AC_6", "AC_ST", "TOTAL" }, "|1|2|", ar = "335-2" && co IN { "DEP_CL", "DEP_AC", "DEP_TOTAL" }, "|1|2|3|4|", ar = "335-4" && co IN { "EC", "EC_IMMO", "EC_NON_IMMO", "AUTRES", "AUTRES_IMMO", "AUTRES_NON_IMMO", "TOTAL" }, "|1|2|", ar = "335-4" && co IN { "TAUX_FIXE", "RATIOS" }, "|1|", ar = "335-8" && co IN { "DETAIL_NATURE" }, "|1|", ar = "332-2", "|1|", ar = "333-1", "|1|2|", ar = "333-2", "|1|3|4|", ar = "333-3", "|1|2|", ar = "334-1", "|1|", ar = "334-2", "|1|2|3|4|5|6|", ar = "334-7", "|1|2|3|4|", ar = "334-8", "|1|", ar = "335-1", "|1|", ar = "335-10", "|1|2|", ar = "335-11", "|1|", ar = "335-12", "|1|2|", ar = "335-3", "|1|2|3|4|", ar = "335-5", "|1|2|3|4|", ar = "335-6", "|1|2|", ar = "335-7", "|1|", ar = "335-8", "|1|2|", ar = "335-9", "|1|", ar = "336-1", "|1|", ar = "336-3", "|1|", "|1|2|" )
		lineageTag: 6f9c7c8f-a065-48ab-9db6-3451dd2014b1

	measure 'Legende des colonnes de l article' = VAR ar = [Article choisi] RETURN IF ( ISBLANK ( ar ), "", VAR x = SWITCH ( ar, "332-1", "Un tableau des éléments caractéristiques de l’OPCI au cours des cinq derniers exercices fait apparaître distinctement : : 1 Exercice N, 2 Exercice N-1, 3 Exercice N-2, 4 Exercice N-3, 5 Exercice N-4", "333-1", "Décomposition du poste « capitaux propres » au bilan : 1 Exercice N, 2 Exercice N-1", "333-2", "Souscriptions et rachats de l’exercice : 3 Nombre de parts ou actions, 1 Montants bruts (hors frais et commissions), 4 Frais et commissions*", "333-3", "Evolution de l’actif net (= capitaux propres) au cours de l’exercice : 1 Exercice N, 2 Exercice N-1", "334-2", "Ventilation par nature : 2 Exercice N-1, 3 Augmentations, 4 Diminutions, 5 Variation des différences d’estimation, 1 Exercice N, 6 Frais", "334-3", "Ventilation par contrat : 3 Assiette du contrat, 2 Exercice N-1, 4 Augmentations, 5 Diminutions, 6 Variation des différences d’estimation, 1 Exercice N | Information : 1 Montant", "334-5", "Évolution des parts et actions des sociétés visées à l’article L214-36 du code monétaire et financier (2° et 3° du I) : 2 Exercice N-1, 3 Cessions, 4 Acquisitions, 5 Variation des différences d’estimation, 1 Exercice N, 6 Frais", "334-6", "Ventilation par contrat : 2 Exercice N-1, 3 Augmentations, 4 Diminutions, 5 Variation des différences d’estimation, 1 Exercice N", "334-7", "Ventilation par nature : 3 Plus-values, 4 Moins-values, 1 Plus et moins-values N, 2 Plus et moins-values N-1", "335-10", "Frais de gestion et de fonctionnement externes : 1 Exercice N, 2 Exercice N-1", "335-12", "Tableau d’affectation des sommes distribuables : 1 Exercice N, 2 Exercice N-1", "335-2", "Décomposition des postes du bilan : 1 Exercice N, 2 Exercice N-1 | Evolution des dépréciations : 2 Situation N-1, 3 Dotations de l’exercice, 4 Reprises de l’exercice, 1 Situation N", "335-3", "Détail des provisions pour risques et charges : 2 Situation Exercice N-1, 3 Dotations de l’exercice, 4 Reprises de l’exercice, 1 Situation Exercice N", "335-4", "Détail des emprunts : 1 Exercice N, 2 Exercice N-1", "335-5", "Ventilation par maturité résiduelle : 1 Jusqu’à 1 an, 2 [1 - 5 ans], 3 > 5 ans, 4 Total", "335-6", "Décomposition du poste « Autres dettes d’exploitation » au bilan : 1 Exercice N, 2 Exercice N-1", "335-8", "Revenus financiers : 1 Exercice N, 2 Exercice N-1", "" ) RETURN IF ( x = "", "", "Colonnes du tableau, numéro et en-tête du document : " & x ) )
		lineageTag: 45ce7aba-a40e-45e5-81d8-aa03a0d5847a

	measure 'Annexe cellule 3' = VAR t = SELECTEDVALUE ( v_ligne_annexe_montant[type_ligne] ) VAR s = COUNTROWS ( FILTER ( v_ligne_annexe_montant, v_ligne_annexe_montant[a_saisir] = TRUE () ) ) > 0 VAR tx = MAX ( v_ligne_annexe_montant[valeur_saisie] ) & "" VAR fc = MAX ( v_ligne_annexe_montant[formule_calcul] ) & "" VAR fo = MAX ( v_ligne_annexe_montant[formule] ) & "" VAR ks = [Annexe colonnes de la ligne] VAR v = MAX ( v_ligne_annexe_montant[colonne_3] ) RETURN SWITCH ( TRUE (), ISBLANK ( t ), BLANK (), t = "RUBRIQUE", "", NOT CONTAINSSTRING ( ks, "|3|" ), "", CONTAINSSTRING ( fc, "; colonne 1 seule" ), "", s, "à remplir", NOT ISBLANK ( v ), FORMAT ( v, "#,##0.00" ), FALSE (), "", fc <> "" || fo <> "", "formule à évaluer par la base", "" )
		lineageTag: e7392459-40d9-41af-a7fa-7562ed0c9a96

