/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table maintien_mission
	lineageTag: 8bab0fb3-ea66-4424-808a-01b13ecf63e9

	measure 'Maintien vise du dernier annuel' = VAR d = CALCULATE ( MAX ( arrete_mission[arrete] ), arrete_mission[type_arrete] = "ANNUEL" ) RETURN IF ( CALCULATE ( COUNTROWS ( maintien_mission ), maintien_mission[Exercice] = d, maintien_mission[Statut] = "APPROUVE" ) > 0, "OUI" )
		displayFolder: Ecran 1 Client
		lineageTag: 3f0f809b-d256-48c0-b65f-94f9cb87e90b

	measure 'Cote maintien courant' = VAR c = [Client selectionne] RETURN CALCULATE ( MAXX ( TOPN ( 1, FILTER ( ALL ( maintien_mission ), FILTER ( ALL ( maintien_mission ), maintien_mission[entite] = c ) ), maintien_mission[arrete_conclu], DESC ), maintien_mission[cote_questionnaire] ) )
		displayFolder: Ecran 1 Client
		lineageTag: 6f889352-e600-49fc-9603-8c259dfea3f4

	measure 'Est client courant (maintiens)' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( maintien_mission ) ) RETURN IF ( SELECTEDVALUE ( maintien_mission[entite] ) = c, 1 )
		formatString: 0
		displayFolder: Ecran 1 Client
		lineageTag: 3e5a94dd-ac0e-4922-93bd-0646ac2b7479

	measure 'Libelle puce maintien' = VAR c = [Client selectionne] VAR a = CALCULATE ( MAX ( maintien_mission[Exercice] ), FILTER ( ALL ( maintien_mission ), maintien_mission[entite] = c ) ) RETURN IF ( ISBLANK ( a ), "Maintien (aucun ouvert)", "Maintien " & FORMAT ( a, "yyyy" ) )

