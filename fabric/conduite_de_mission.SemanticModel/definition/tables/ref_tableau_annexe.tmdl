/// Les tableaux de l'annexe du recueil, un par article : intitule, modele indicatif ou impose.
table ref_tableau_annexe
	lineageTag: 5a5838d2-6cd7-4ad4-b081-5da48d601605

	measure 'Faits de l article choisi' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = SELECTEDVALUE ( ref_tableau_annexe[article] ) VAR ind = SELECTEDVALUE ( ref_tableau_annexe[indicatif] ) VAR t = FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a && v_cellules_a_remplir[article] = ar ) VAR n = MAXX ( t, v_cellules_a_remplir[cellules] ) VAR rem = MAXX ( t, v_cellules_a_remplir[cellules_a_remplir] ) + 0 VAR att = MAXX ( t, v_cellules_a_remplir[en_attente] ) + 0 VAR lec = MAXX ( t, v_cellules_a_remplir[lecture] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || ISBLANK ( ar ), "", "Modèle " & IF ( ind = 1, "indicatif", "imposé" ) & " ; " & IF ( ISBLANK ( n ), "aucune cellule dans la dernière version de l’annexe", FORMAT ( n, "0" ) & IF ( n > 1, " cellules", " cellule" ) & IF ( rem + att > 0, ", dont " & IF ( rem > 0, FORMAT ( rem, "0" ) & " à remplir", "" ) & IF ( rem > 0 && att > 0, " et ", "" ) & IF ( att > 0, FORMAT ( att, "0" ) & " en attente", "" ), "" ) & " ; " & IF ( rem = 0 && att > 0, "incomplet, cellules en attente de calcul : le Word les imprime vides", lec ) ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: f9014da9-55ee-4481-888e-286e34d6a13c

