table lot_ecritures
	lineageTag: 2f3dbe93-3137-4ad2-990a-214192626c90

	/// Nombre de lots d'écritures.
	measure Lots = COUNTROWS(lot_ecritures)
		formatString: #,0
		displayFolder: Écritures
		lineageTag: 30f42893-4734-4ed0-8bee-205620a27bdd

	/// Lots en attente de visa.
	measure 'Lots proposes' = CALCULATE(COUNTROWS(lot_ecritures), lot_ecritures[statut] = "PROPOSE") + 0
		formatString: #,0
		displayFolder: Écritures
		lineageTag: 1c8b6b55-3bc3-4108-89f6-a604d2387edb

	/// Lots visés.
	measure 'Lots valides' = CALCULATE(COUNTROWS(lot_ecritures), lot_ecritures[statut] = "VALIDE") + 0
		formatString: #,0
		displayFolder: Écritures
		lineageTag: aec65ce8-2818-490d-81b2-4a129c412f52

	/// Part des lots visés.
	measure 'Part validee' = DIVIDE([Lots valides], [Lots])
		formatString: 0.0 %
		displayFolder: Écritures
		lineageTag: f1b83a0e-7b4e-459b-b48d-d2306839634b

	/// Jours moyens entre la création d'un lot et sa décision.
	measure 'Delai de visa' = AVERAGEX(FILTER(lot_ecritures, NOT ISBLANK(lot_ecritures[statut_le])), DATEDIFF(lot_ecritures[cree_le], lot_ecritures[statut_le], DAY))
		formatString: 0.0
		displayFolder: Écritures
		lineageTag: fde4d50f-2543-4ca1-a081-6f8e86919b2f

