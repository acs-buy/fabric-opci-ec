/// Differences par compte de difference d estimation du vehicule.
table v_ecran_differences_par_compte
	lineageTag: 313eeca6-58a0-4b90-9ca5-1dc2ed7d13ce

	/// reste à passer nul sur chaque compte, aucun lot DERIVABLE PROPOSE, périmé ou non, reste 275 nul, aucune conclusion VALO ou PART en attente ; un lot périmé puis visé ne compte pas ({c18}) : aucune action ne lèverait son blocage, [Lot annulable] ne valant que pour un lot PROPOSE et [Entite si generabl
	measure 'Valorisation etape 4 faite' = VAR n = COUNTROWS ( v_ecran_differences_par_compte ) VAR restes = CALCULATE ( COUNTROWS ( v_ecran_differences_par_compte ), ABS ( v_ecran_differences_par_compte[reste_a_passer] ) >= 0.005 ) + 0 VAR lots = CALCULATE ( COUNTROWS ( v_lots_perimetre ), v_lots_perimetre[Cycle] IN { "VALO", "PART" }, v_lots_perimetre[Statut du lot] = "PROPOSE" ) + 0 VAR r275 = ABS ( SUM ( v_reprise_275_a_passer[a_passer] ) + 0 ) VAR concl = CALCULATE ( COUNTROWS ( v_ecran_feuilles_valorisation ), v_ecran_feuilles_valorisation[conclusion_a_viser] = TRUE () ) + 0 RETURN IF ( n > 0 && restes + lots + concl = 0 && r275 < 0.005, 1, 0 )
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 9bc3fe84-f659-4c17-b145-5d6edf5c6132

	/// idem, étape 4
	measure 'Fond valorisation etape 4' = IF ( [Valorisation etape 4 faite] = 1, "#1F6D4A", "#D5DCE4" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 4f97ad46-a803-41fb-b08f-b3e47a02afb7

