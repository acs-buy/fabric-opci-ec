		annotation SummarizationSetBy = Automatic

	column 'Entrée par' = IF ( v_programme_selection[origine] = "TYPE", "le type", IF ( v_programme_selection[origine] = "AJOUT", "un ajout", "" ) )
		dataType: string
		lineageTag: c3fc564f-2197-4baa-9e09-9418dc08f7e0
