/// La rationalisation de l'actif net : ouverture, souscriptions, rachats, dividendes, resultats, valorisations, cloture calculee et rationalisee. Tableau de bord Valorisation. Ajoutee le 09/09/2026.
table v_rationalisation_opci
	lineageTag: f2d8c4d9-3476-48b7-bf9d-bbd8096e6036

	/// Actif net a l'ouverture de l'exercice.
	measure 'ANR d ouverture' = SUM(v_rationalisation_opci[actif_net_precedent])
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 763873b9-bcaf-494e-b84d-4d45dac5b79a

	/// Dividendes verses dans l'exercice.
	measure 'Dividendes verses' = SUM(v_rationalisation_opci[dividendes_verses])
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 6790b82f-580c-4777-8688-565df26585ab

	/// Resultat corporate de l'exercice.
	measure 'Resultat corporate' = SUM(v_rationalisation_opci[resultat_corporate])
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 7d4754ff-c64f-47e4-854c-c78f0f010452

	/// Resultat immobilier de l'exercice.
	measure 'Resultat immobilier' = SUM(v_rationalisation_opci[resultat_immobilier])
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 78e3ab3c-f73e-494a-b27d-9599a463dfdc

	/// Gain de valorisation de l'exercice.
	measure 'Gain de valorisation' = SUM(v_rationalisation_opci[gain_valorisations])
		formatString: #,0
		displayFolder: Parcours
		lineageTag: ab4a9797-0cc7-472a-b6fa-b3d224afd2d8

	/// Actif net calcule a la cloture.
	measure 'ANR calcule' = SUM(v_rationalisation_opci[actif_net_calcule])
		formatString: #,0
		displayFolder: Parcours
		lineageTag: b2fe23ff-15b7-43f8-8bcc-55d54621e8c1

	/// Calcule moins rationalise, attendu 0.
	measure 'Ecart de rationalisation' = SUM(v_rationalisation_opci[actif_net_calcule]) - SUM(v_rationalisation_opci[actif_net_rationalise])
		formatString: #,0.00
		displayFolder: Parcours
		lineageTag: 317f0224-546d-4452-965c-5047be8a3c03

	/// Ecart de rationalisation, entite et arrete affiches.
	measure 'Ecart de rationalisation du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Ecart de rationalisation], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0.00
		displayFolder: Le dossier
		lineageTag: 9511cd3e-4e29-4da8-bbb6-e2396e9ee2b7

	/// ANR d ouverture, entite et arrete affiches. Ajoutee le 12/09/2026 pour le panneau du deplacement de l'actif net.
	measure 'ANR d ouverture du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([ANR d ouverture], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 418affb7-3691-449d-9730-7f5792be30d8

	/// Dividendes verses, entite et arrete affiches. Ajoutee le 12/09/2026 pour le panneau du deplacement de l'actif net.
	measure 'Dividendes verses du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Dividendes verses], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 08ab73c6-107a-47bc-88db-e656b35e104e

	/// Resultat corporate, entite et arrete affiches. Ajoutee le 12/09/2026 pour le panneau du deplacement de l'actif net.
	measure 'Resultat corporate du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Resultat corporate], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 892f5287-b67b-413b-a0b9-6c0746ae8dd3

	/// Resultat immobilier, entite et arrete affiches. Ajoutee le 12/09/2026 pour le panneau du deplacement de l'actif net.
	measure 'Resultat immobilier du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Resultat immobilier], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 60d2a8b2-3943-44d8-8fc5-deb56796397a

	/// Gain de valorisation, entite et arrete affiches. Ajoutee le 12/09/2026 pour le panneau du deplacement de l'actif net.
	measure 'Gain de valorisation du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Gain de valorisation], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 41bb0371-ec34-4f6e-9e6e-9cddee5f7d88

	/// ANR calcule, entite et arrete affiches. Ajoutee le 12/09/2026 pour le panneau du deplacement de l'actif net.
	measure 'ANR calcule du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([ANR calcule], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 3d1f96ff-537b-4659-b377-0d6e8403429f

	/// Carte 3.5, Actif net rationalise. Arbitree le 15/09/2026 par la session de la base.
	measure 'R35 Actif net rationalise' = VAR lignes = COUNTROWS ( v_rationalisation_opci ) RETURN IF ( lignes = 1, SUM ( v_rationalisation_opci[actif_net_rationalise] ) )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 3d4d03c8-3c6a-4d44-81ac-b8e99695659f

	/// Carte 3.5, Actif net calcule. Arbitree le 15/09/2026 par la session de la base.
	measure 'R35 Actif net calcule' = VAR lignes = COUNTROWS ( v_rationalisation_opci ) RETURN IF ( lignes = 1, SUM ( v_rationalisation_opci[actif_net_calcule] ) )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 50c7f810-c199-4014-8ad4-6f74a9e6c144

	/// Carte 3.5, Ecart. Le nom porte « de rationalisation » parce qu'un ecart de VL existe aussi en 4.1 : deux grandeurs differentes ne partagent jamais un nom.. Arbitree le 15/09/2026 par la session de la base.
	measure 'R35 Ecart de rationalisation' = VAR arretes = COUNTROWS ( VALUES ( v_dim_arrete[arrete] ) ) RETURN IF ( arretes = 1, [R35 Actif net rationalise] - [R35 Actif net calcule] )
		formatString: #,0.00
		displayFolder: Rapports V2
		lineageTag: 24bfa5c4-dd87-43f5-aba7-c73187a7ffb7

