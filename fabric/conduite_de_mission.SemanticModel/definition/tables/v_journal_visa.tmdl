/// Le journal des visas : decisions (VISE, RENVOYE) et refus (REFUSE), horodates et attribues. Tableau de bord Revision et supervision. Ajoutee le 09/09/2026.
table v_journal_visa
	lineageTag: 009366fc-3fec-4585-89bd-2016dd429ba9

	/// Lignes du journal des visas.
	measure 'Lignes du journal' = COUNTROWS(v_journal_visa) + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 324c5a91-0e02-4daa-b3f4-cba63b03723f

	/// Refus traces au journal.
	measure 'Refus traces' = CALCULATE(COUNTROWS(v_journal_visa), v_journal_visa[genre] = "REFUS") + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: e3d64afb-acd7-46ac-b1d3-3588e89fea5e

	/// Refus traces, entite et arrete affiches.
	measure 'Refus du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Refus traces], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: d7dce49a-0f1a-444d-b3ae-1e5585d4d777

	/// Carte 2.3, Visas poses. Arbitree le 15/09/2026 par la session de la base.
	measure 'R23 Visas poses' = COUNTROWS ( v_journal_visa )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: f787881d-4699-4c9f-a0ee-2dcaa70be556

	/// Carte 2.3, Dernier geste. Arbitree le 15/09/2026 par la session de la base.
	measure 'R23 Dernier visa' = MAX ( v_journal_visa[horodatage] )
		formatString: dd/MM/yyyy HH:mm
		displayFolder: Rapports V2
		lineageTag: 3ccd57ce-05d8-4a95-beb3-7f6aac699554

