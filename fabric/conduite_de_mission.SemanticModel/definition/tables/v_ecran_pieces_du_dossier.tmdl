	/// La carte de la fiche du rattachement choisi, coupée à 182 px de chasse.
	measure 'Fiche retrait' = VAR t = [Fiche retrait texte] & "" VAR n = LEN ( t ) VAR pd = ADDCOLUMNS ( GENERATESERIES ( 1, MAX ( n, 1 ) ), "w", SWITCH ( UNICODE ( MID ( t, [Value], 1 ) ), 8239, 1.75, 46, 3.25, 44, 3.25, 59, 3.25, 58, 3.25, 183, 3.25, 105, 3.5, 106, 3.5, 108, 3.5, 39, 3.5, 8217, 3.5, 238, 3.5, 239, 3.5, 32, 3.75, 160, 3.75, 124, 3.75, 73, 4.0, 33, 4.0, 206, 4.0, 102, 4.5, 40, 4.5, 41, 4.5, 91, 4.5, 93, 4.5, 123, 4.5, 125, 4.5, 116, 4.75, 114, 5.0, 74, 5.25, 49, 5.25, 45, 5.25, 95, 5.5, 47, 5.5, 115, 5.75, 42, 5.75, 34, 5.75, 63, 6.0, 99, 6.25, 122, 6.25, 231, 6.25, 76, 6.5, 118, 6.75, 120, 6.75, 121, 6.75, 70, 6.75, 8211, 6.75, 97, 7.0, 101, 7.0, 107, 7.0, 69, 7.0, 233, 7.0, 232, 7.0, 234, 7.0, 235, 7.0, 224, 7.0, 226, 7.0, 228, 7.0, 201, 7.0, 200, 7.0, 202, 7.0, 83, 7.25, 84, 7.25, 55, 7.25, 171, 7.25, 187, 7.25, 48, 7.5, 50, 7.5, 51, 7.5, 53, 7.5, 54, 7.5, 56, 7.5, 57, 7.5, 8364, 7.5, 104, 7.75, 110, 7.75, 117, 7.75, 80, 7.75, 89, 7.75, 90, 7.75, 52, 7.75, 251, 7.75, 252, 7.75, 249, 7.75, 98, 8.0, 100, 8.0, 103, 8.0, 111, 8.0, 112, 8.0, 113, 8.0, 66, 8.0, 244, 8.0, 246, 8.0, 35, 8.0, 67, 8.25, 75, 8.25, 82, 8.25, 88, 8.25, 199, 8.25, 86, 8.5, 65, 9.0, 192, 9.0, 194, 9.0, 71, 9.25, 85, 9.25, 219, 9.25, 61, 9.25, 43, 9.25, 60, 9.25, 62, 9.25, 68, 9.5, 38, 9.5, 72, 9.75, 119, 10.0, 79, 10.0, 81, 10.0, 212, 10.0, 78, 10.25, 8230, 10.75, 37, 11.25, 109, 11.75, 77, 12.25, 339, 12.25, 338, 12.5, 64, 12.75, 87, 13.0, 10.0 ) ) VAR pc = ADDCOLUMNS ( pd, "c", VAR i = [Value] RETURN SUMX ( FILTER ( pd, [Value] <= i ), [w] ) ) VAR tot = IF ( n = 0, 0, SUMX ( pd, [w] ) ) VAR une = n = 0 || tot <= 171.25 VAR b1 = IF ( une, 0, MAXX ( FILTER ( pc, [Value] > 1 && MID ( t, [Value], 1 ) = " " && [c] - [w] <= 171.25 ), [Value] ) + 0 ) VAR h1 = IF ( une, 0, MAXX ( FILTER ( pc, [c] <= 171.25 ), [Value] ) + 0 ) VAR f1 = IF ( b1 > 1, b1 - 1, h1 ) VAR s2 = IF ( une, 0, IF ( b1 > 1, b1 + 1, h1 + 1 ) ) RETURN IF ( tot <= 182, t, LEFT ( t, f1 ) & "…" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 7016ea80-440d-5071-9742-1b2fc2e57fb0

	/// Rouge quand le rattachement choisi ne se retire pas.
	measure 'Encre fiche retrait' = IF ( [Fiche retrait texte] & "" IN { "", "possible" }, "#12233C", "#9A2A2A" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: dfa20792-71ec-5a16-bf7b-36d9a1fd49ac

	/// L'adresse SharePoint de la pièce du rattachement choisi, vide sinon.
	measure 'Adresse de la piece a retirer' = VAR k = [Rattachement a retirer] RETURN IF ( NOT ISBLANK ( k ), CALCULATE ( MAX ( v_ecran_pieces_du_dossier[Ouvrir la pièce] ), FILTER ( ALL ( v_ecran_pieces_du_dossier ), v_ecran_pieces_du_dossier[cle_ecran] = k ) ) )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: efde5401-6a95-5771-834c-e6f2e5cdb861

	measure 'Fond e3cBouton1' = IF ( ISBLANK ( [Adresse de la piece a retirer] ), "#E4E9EF", "#FFFFFF" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 4215c5bf-81c6-57c7-bcbf-ef66eddef32e

	measure 'Libelle e3cBouton1' = "Ouvrir la pièce"
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: c9209043-df3e-529d-af0a-79bdb7e6ad7f

	measure 'Infobulle e3cBouton1' = IF ( NOT ISBLANK ( [Adresse de la piece a retirer] ), "Ouvre le fichier dans SharePoint.", IF ( ISBLANK ( [Rattachement a retirer] ), "Aucune pièce du dossier choisie dans « Pièce à retirer ».", "La pièce choisie n'a pas d'adresse dans SharePoint." ) )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 268b597b-107c-5f38-89ba-a5547636b7c5

