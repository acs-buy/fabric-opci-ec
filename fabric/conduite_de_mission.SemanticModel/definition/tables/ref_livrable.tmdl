/// Les livrables du referentiel ; l'etape 6 produit ceux dont produit_etape_6 vaut 1.
table ref_livrable
	lineageTag: 78759ef4-9319-41ce-b4e9-8adfd6ac8d96

	measure 'Livrable choisi' = IF ( HASONEVALUE ( ref_livrable[code] ), SELECTEDVALUE ( ref_livrable[code] ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 8d8b7981-e954-4ab7-a406-604ac238b5ed

	measure 'Livrable comptes annuels' = "COMPTES_ANNUELS"
		displayFolder: Ecran 2 etape 6
		lineageTag: feb7e51b-5498-4a10-ac66-72ea9d2f145d

	measure 'Livrable rapport' = "ATTESTATION"
		displayFolder: Ecran 2 etape 6
		lineageTag: 75429abe-0258-4511-b3cf-fc6454d13c37

	measure 'Livrable DIP' = "DIP"
		displayFolder: Ecran 2 etape 6
		lineageTag: 44bb8ec0-7418-40bb-b741-2dbb41b4ba11

	measure 'Format Word' = "DOCX"
		displayFolder: Ecran 2 etape 6
		lineageTag: 0201365f-1992-40f9-9cce-12d0c40b0daf

	measure 'Format Excel' = "XLSX"
		displayFolder: Ecran 2 etape 6
		lineageTag: b2d666c8-1dd4-4bc7-945f-82a2802f75d5

	measure 'Obstacle a la production' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR u = USERPRINCIPALNAME () VAR j = TODAY () VAR connu = COUNTROWS ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ) ) + 0 VAR p6 = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), IF ( ref_livrable[produit_etape_6], 1, 0 ) ) + 0 VAR arr = COUNTROWS ( FILTER ( ALL ( ref_arrete ), ref_arrete[entite] = e && ref_arrete[Arrêté] = a ) ) + 0 VAR role = COUNTROWS ( FILTER ( ALL ( role_mission ), role_mission[entite] = e && ( role_mission[connexion] = u || role_mission[personne] = u ) && role_mission[du] <= j && ( ISBLANK ( role_mission[au] ) || role_mission[au] > j ) ) ) + 0 VAR due = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR rv = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), IF ( v_revision_indicateurs[revue_visee], 1, 0 ) ) + 0 VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) VAR vca = MAXX ( FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = "COMPTES_ANNUELS" ), document_produit[version] ) VAR dca = COUNTROWS ( FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = "COMPTES_ANNUELS" && demande_document[etat] = "PRODUITE" && demande_document[version] = vca ) ) + 0 VAR pca = COUNTROWS ( FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = "COMPTES_ANNUELS" && document_produit[version] = vca && NOT ISBLANK ( document_produit[perime_le] ) ) ) + 0 VAR sva = COUNTROWS ( FILTER ( ALL ( v_annexe_document ), v_annexe_document[entite] = e && v_annexe_document[arrete] = a && v_annexe_document[livrable] = "COMPTES_ANNUELS" && v_annexe_document[version] = vca && ISBLANK ( v_annexe_document[annexe_version] ) ) ) + 0 RETURN SWITCH ( TRUE (), ISBLANK ( l ) || connu = 0, "livrable inconnu : " & IF ( ISBLANK ( l ), "vide", l ) & ".", ISBLANK ( e ) || ISBLANK ( a ) || arr = 0, "arrêté inconnu pour cette entité.", role = 0, "cette personne ne tient aucun rôle de mission sur l'entité " & e & ".", p6 <> 1, "le livrable " & l & " n'est pas produit par la solution ; seuls les comptes annuels, le rapport de l'expert-comptable et le DIP le sont.", NOT due, "le livrable " & l & " n'est pas dû à l'arrêté " & a & ".", rv <> 1, "la revue de l'arrêté n'est pas visée.", cl = "VISE", "l'arrêté est validé pour le client ; une nouvelle production suppose sa réouverture.", l = "ATTESTATION" && ( ISBLANK ( vca ) || dca = 0 || pca > 0 || sva > 0 ), "les comptes annuels de l'arrêté ne sont pas produits, ou leur dernière version est périmée ; le rapport de l'expert-comptable les couvre.", l = "COMPTES_ANNUELS", MAXX ( FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ), v_annexe_produisible[message_obstacle] ), BLANK () )
		displayFolder: Ecran 2 etape 6
		lineageTag: 0a7ae80f-d23e-4b26-b887-fbf764fe720b

	measure 'Arrete a produire en Word' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR f = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR o = IF ( l = "ATTESTATION", [Obstacle a la production du rapport], [Obstacle a la production] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR dd = MAXX ( FILTER ( tq, demande_document[version] = dv ), demande_document[etat] ) VAR tf = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l && document_produit[version] = dv ) VAR nf = COUNTROWS ( tf ) + 0 VAR nfo = COUNTROWS ( FILTER ( tf, document_produit[format] = "DOCX" ) ) + 0 VAR npe = COUNTROWS ( FILTER ( tf, NOT ISBLANK ( document_produit[perime_le] ) ) ) + 0 VAR pr = MINX ( tf, document_produit[produit_le] ) VAR rl = MAXX ( FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ), v_etat_revue[decide_le] ) VAR deja = dd = "DEMANDEE" && nf > 0 && npe = 0 && NOT ISBLANK ( pr ) && NOT ISBLANK ( rl ) && pr > rl && nfo > 0 RETURN IF ( NOT ISBLANK ( l ) && NOT ISBLANK ( a ) && ISBLANK ( o ) && CONTAINSSTRING ( "," & f & ",", ",DOCX," ) && NOT deja, a )
		displayFolder: Ecran 2 etape 6
		lineageTag: 908aa110-0968-4ff9-90fa-2f8ef3d417d4

	measure 'Arrete a produire en Excel' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR f = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR o = [Obstacle a la production] VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR dd = MAXX ( FILTER ( tq, demande_document[version] = dv ), demande_document[etat] ) VAR tf = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l && document_produit[version] = dv ) VAR nf = COUNTROWS ( tf ) + 0 VAR nfo = COUNTROWS ( FILTER ( tf, document_produit[format] = "XLSX" ) ) + 0 VAR npe = COUNTROWS ( FILTER ( tf, NOT ISBLANK ( document_produit[perime_le] ) ) ) + 0 VAR pr = MINX ( tf, document_produit[produit_le] ) VAR rl = MAXX ( FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ), v_etat_revue[decide_le] ) VAR deja = dd = "DEMANDEE" && nf > 0 && npe = 0 && NOT ISBLANK ( pr ) && NOT ISBLANK ( rl ) && pr > rl && nfo > 0 RETURN IF ( NOT ISBLANK ( l ) && NOT ISBLANK ( a ) && ISBLANK ( o ) && CONTAINSSTRING ( "," & f & ",", ",XLSX," ) && NOT deja, a )
		displayFolder: Ecran 2 etape 6
		lineageTag: 3bdc153e-f40e-4430-aec1-8bbcffc694a3

	measure 'Arrete des comptes annuels a produire' = CALCULATE ( [Arrete a produire en Word], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "COMPTES_ANNUELS" )
		displayFolder: Ecran 2 etape 6
		lineageTag: b5872c76-07e1-4d90-aac5-ac62cb150b11

	measure 'Arrete du classeur a produire' = CALCULATE ( [Arrete a produire en Excel], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "COMPTES_ANNUELS" )
		displayFolder: Ecran 2 etape 6
		lineageTag: 1343c89d-63fa-4ca9-9736-c54df28c06bd

	measure 'Arrete du DIP a produire' = CALCULATE ( [Arrete a produire en Word], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "DIP" )
		displayFolder: Ecran 2 etape 6
		lineageTag: 65c63da2-35b2-4792-8b24-8e62fde78288

	measure 'Adresse du livrable choisi' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR w = MAXX ( FILTER ( tv, document_produit[format] = "DOCX" ), document_produit[web_url] ) VAR x = MINX ( FILTER ( tv, NOT ISBLANK ( document_produit[web_url] ) ), document_produit[web_url] ) VAR u0 = IF ( ISBLANK ( w ), x, w ) RETURN IF ( NOT ISBLANK ( l ) && NOT ISBLANK ( e ) && NOT ISBLANK ( a ), IF ( ISBLANK ( u0 ), BLANK (), ( VAR lsP1 = FIND ( "&action=", u0, 1, 0 ) VAR lsP = IF ( lsP1 > 0, lsP1, FIND ( "?action=", u0, 1, 0 ) ) VAR lsQ = IF ( lsP > 0, FIND ( "&", u0, lsP + 1, 0 ), 0 ) RETURN IF ( lsP > 0, LEFT ( u0, lsP ) & "action=view" & IF ( lsQ > 0, MID ( u0, lsQ, 4000 ), "" ), u0 & IF ( FIND ( "?", u0, 1, 0 ) > 0, "&", "?" ) & "action=view" ) ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: e9c6843a-2077-442a-837b-1e651296a41c

	measure 'Adresse du classeur choisi' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR w = MAXX ( FILTER ( tv, document_produit[format] = "XLSX" ), document_produit[web_url] ) RETURN IF ( NOT ISBLANK ( l ) && NOT ISBLANK ( e ) && NOT ISBLANK ( a ), IF ( ISBLANK ( w ), BLANK (), ( VAR lsP1 = FIND ( "&action=", w, 1, 0 ) VAR lsP = IF ( lsP1 > 0, lsP1, FIND ( "?action=", w, 1, 0 ) ) VAR lsQ = IF ( lsP > 0, FIND ( "&", w, lsP + 1, 0 ), 0 ) RETURN IF ( lsP > 0, LEFT ( w, lsP ) & "action=view" & IF ( lsQ > 0, MID ( w, lsQ, 4000 ), "" ), w & IF ( FIND ( "?", w, 1, 0 ) > 0, "&", "?" ) & "action=view" ) ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: fdc67c27-a3e9-4683-8347-aabf07cc9119

