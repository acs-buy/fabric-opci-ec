		lineageTag: 3413d24c-2f7c-4e63-9b6e-2850d66cc28b

	/// limite_texte de la limite cochée ; vide sans exactement 1 limite cochée, test HASONEVALUE ( ref_ratio_memoire[code] )
	measure 'Fiche limite du texte' = IF ( HASONEVALUE ( ref_ratio_memoire[code] ), SELECTEDVALUE ( ref_ratio_memoire[limite_texte] ) ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 5aef7aae-bbbe-48f7-8f38-ec815818db33

	/// article_calcul ; vide quand le texte n’en fixe pas ; vide sans exactement 1 limite cochée, test HASONEVALUE ( ref_ratio_memoire[code] )
	measure 'Fiche limite calcul' = IF ( HASONEVALUE ( ref_ratio_memoire[code] ), SELECTEDVALUE ( ref_ratio_memoire[article_calcul] ) ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 35bbaa00-f0f1-4480-89cd-2150d7d55231

	/// « sans objet pour ce véhicule » quand [Statut de la limite] est « sans objet » (pour un OPCI professionnel, limite que R. 214-197 à R. 214-200 écartent ; pour un FPI, le 51 %) ; sinon dates_respect_professionnel pour un véhicule marqué OPCI professionnel quand la colonne est renseignée, dates_respec
	measure 'Fiche limite dates de respect' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) VAR dp = SELECTEDVALUE ( ref_ratio_memoire[dates_respect_professionnel] ) VAR d = SELECTEDVALUE ( ref_ratio_memoire[dates_respect] ) VAR x = IF ( pro && NOT ISBLANK ( dp ) && dp <> "", dp, d ) RETURN IF ( vide, BLANK (), ( IF ( NOT une, "", IF ( so, "sans objet pour ce véhicule", IF ( ISBLANK ( x ) || x = "", "aucune date fixée par le texte", x ) ) ) ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: c4804200-c9e8-46a9-b386-8529b900b4f2

	/// citation du texte de la limite cochée ; vide sans exactement 1 limite cochée, test HASONEVALUE ( ref_ratio_memoire[code] )
	measure 'Fiche limite citation' = IF ( HASONEVALUE ( ref_ratio_memoire[code] ), SELECTEDVALUE ( ref_ratio_memoire[citation] ) ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 28c0c072-0512-4f3c-a4fe-6e9b76be33e9

	/// gris quand [Blocage conclure la limite] n’est pas « conditions réunies » ou quand [Avis limite cochee] n’est pas vide ; couleur d’action sinon, limite cochée ou non
	measure 'Fond conclure la limite' = IF ( [Blocage conclure la limite] <> "conditions réunies" || [Avis limite cochee] <> "", "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 6e9645d9-9b73-4cce-97c0-de98c4a57ff1

