/// Les ratios du CMF a l'arrete, avec seuil, sens, valeur, numerateur, denominateur, article et conclusion en clair. Script 141.
table v_client_ratio
	lineageTag: b2d1163a-8b92-4f5e-859f-71484162ebaf

	measure 'Ratios calcules' = COUNTROWS ( v_client_ratio )
		formatString: #,0
		lineageTag: abe42c23-897d-443a-9779-46b0bfe845d0

	measure 'Ratios respectes' = SUMX ( v_client_ratio, IF ( v_client_ratio[respecte], 1, 0 ) )
		formatString: #,0
		lineageTag: 3aa73711-4256-4d2a-90bc-ff0fa38eb3b4

	measure 'Ratios non respectes' = SUMX ( v_client_ratio, IF ( v_client_ratio[respecte], 0, 1 ) )
		formatString: #,0
		lineageTag: 4671054f-4607-4e57-8047-3929ce70a23a

	measure 'Valeur du ratio' = MAX ( v_client_ratio[Valeur] )
		formatString: 0.00 %
		lineageTag: 55f51215-98f8-48ab-ba8d-08931a4c40db

	measure 'Seuil du ratio' = MAX ( v_client_ratio[Seuil] )
		formatString: 0.00 %
		lineageTag: 9f803e55-022d-4a23-9236-2742e754226c

	/// Sert a colorer la conclusion dans le tableau des ratios.
	measure 'Ratio respecte (0 ou 1)' = IF ( COUNTROWS ( FILTER ( v_client_ratio, v_client_ratio[respecte] ) ) > 0, 1, 0 )
		formatString: 0
		isHidden
		lineageTag: 5e01cb95-1360-422f-8a90-5f91977fb80f

	column cle_arrete
		dataType: string
		isHidden
