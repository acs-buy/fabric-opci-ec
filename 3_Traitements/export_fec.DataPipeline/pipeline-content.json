{
  "properties": {
    "activities": [
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": "SELECT TOP 1\ne.siren,\ne.denomination,\ne.forme_vehicule\nFROM dbo.ref_entite e\nWHERE e.code = '@{pipeline().parameters.entite}'\nAND e.siren IS NOT NULL;",
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "DossierOPCI",
              "properties": {
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "artifactId": "e75236e3-ceab-b437-4253-1d4f3ade2222",
                  "workspaceId": "00000000-0000-0000-0000-000000000000"
                },
                "externalReferences": {
                  "connection": "482cb3e5-3b43-4cf8-aec2-6eb6e2243c9e"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": true
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "identite_de_l_entite",
        "description": "Rend le Siren du referentiel. Le filtre siren IS NOT NULL fait echouer l'execution pour une entite sans personnalite morale, un FPI, plutot que de nommer le fichier avec un Siren vide : point ouvert 1 du paragraphe 3.1 de la conception.",
        "dependsOn": []
      },
      {
        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": "SELECT\n      s.JournalCode,\n      s.JournalLib,\n      s.EcritureNum,\n      CONVERT(CHAR(8), s.EcritureDate, 112) AS EcritureDate,\n      s.CompteNum,\n      s.CompteLib,\n      s.CompAuxNum,\n      s.CompAuxLib,\n      s.PieceRef,\n      CONVERT(CHAR(8), s.PieceDate, 112) AS PieceDate,\n      s.EcritureLib,\n      REPLACE(CONVERT(VARCHAR(24), s.Debit), '.', ',') AS Debit,\n      REPLACE(CONVERT(VARCHAR(24), s.Credit), '.', ',') AS Credit,\n      s.EcritureLet,\n      CONVERT(CHAR(8), s.DateLet, 112) AS DateLet,\n      CONVERT(CHAR(8), s.ValidDate, 112) AS ValidDate,\n      REPLACE(CONVERT(VARCHAR(24), s.Montantdevise), '.', ',') AS Montantdevise,\n      s.Idevise\n  FROM dbo.v_fec_standard s\n  JOIN dbo.lot_ecritures l ON l.id = s.lot_id\n  WHERE l.entite = '@{pipeline().parameters.entite}'\n    AND l.arrete = '@{pipeline().parameters.arrete}'\n  ORDER BY s.EcritureNum, s.EcritureDate;",
            "partitionOption": "None",
            "queryTimeout": "02:00:00",
            "datasetSettings": {
              "type": "FabricSqlDatabaseTable",
              "schema": [],
              "connectionSettings": {
                "name": "DossierOPCI",
                "properties": {
                  "type": "FabricSqlDatabase",
                  "typeProperties": {
                    "artifactId": "e75236e3-ceab-b437-4253-1d4f3ade2222",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "externalReferences": {
                    "connection": "482cb3e5-3b43-4cf8-aec2-6eb6e2243c9e"
                  },
                  "annotations": []
                }
              },
              "annotations": []
            }
          },
          "sink": {
            "type": "DelimitedTextSink",
            "formatSettings": {
              "type": "DelimitedTextWriteSettings",
              "quoteAllText": false,
              "fileExtension": ".txt"
            },
            "storeSettings": {
              "type": "AzureBlobStorageWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            },
            "datasetSettings": {
              "type": "DelimitedText",
              "typeProperties": {
                "location": {
                  "type": "LakehouseLocation",
                  "folderPath": "fec_sortant",
                  "fileName": {
                    "value": "@concat(activity('identite_de_l_entite').output.firstRow.siren, 'FEC', replace(pipeline().parameters.arrete, '-', ''))",
                    "type": "Expression"
                  }
                },
                "columnDelimiter": "\t",
                "rowDelimiter": "\n",
                "encodingName": "UTF-8",
                "quoteChar": "",
                "escapeChar": "",
                "firstRowAsHeader": true
              },
              "schema": [],
              "linkedService": {
                "name": "Coffre",
                "properties": {
                  "type": "Lakehouse",
                  "typeProperties": {
                    "artifactId": "4a1d428b-490a-4bdf-813e-5bc1bd5e4e2b",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "rootFolder": "Files"
                  },
                  "annotations": []
                }
              },
              "annotations": []
            }
          },
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "typeConversionSettings": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          },
          "enableStaging": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "ecrire_le_profil_fiscal",
        "description": "Les 18 champs de la section VII de l'article A47 A-1, dans leur ordre, mis en forme par la requete source. Le nom du fichier suit SirenFECAAAAMMJJ, le Siren venant de dbo.ref_entite par l'activite de recherche et la date etant l'arrete, dont les 2 traits d'union sont retires.",
        "dependsOn": [
          {
            "activity": "identite_de_l_entite",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": "SELECT\n      a.JournalCode,\n      a.JournalLib,\n      a.EcritureNum,\n      CONVERT(CHAR(8), a.EcritureDate, 112) AS EcritureDate,\n      a.CompteNum,\n      a.CompteLib,\n      a.CompAuxNum,\n      a.CompAuxLib,\n      a.PieceRef,\n      CONVERT(CHAR(8), a.PieceDate, 112) AS PieceDate,\n      a.EcritureLib,\n      REPLACE(CONVERT(VARCHAR(24), a.Debit), '.', ',') AS Debit,\n      REPLACE(CONVERT(VARCHAR(24), a.Credit), '.', ',') AS Credit,\n      a.EcritureLet,\n      CONVERT(CHAR(8), a.DateLet, 112) AS DateLet,\n      CONVERT(CHAR(8), a.ValidDate, 112) AS ValidDate,\n      REPLACE(CONVERT(VARCHAR(24), a.Montantdevise), '.', ',') AS Montantdevise,\n      a.Idevise,\n      a.entite,\n      a.code_actif,\n      a.code_projet,\n      a.code_lot\n  FROM dbo.v_fec_analytique a\n  JOIN dbo.lot_ecritures l ON l.id = a.lot_id\n  WHERE l.entite = '@{pipeline().parameters.entite}'\n    AND l.arrete = '@{pipeline().parameters.arrete}'\n  ORDER BY a.EcritureNum, a.EcritureDate;",
            "partitionOption": "None",
            "queryTimeout": "02:00:00",
            "datasetSettings": {
              "type": "FabricSqlDatabaseTable",
              "schema": [],
              "connectionSettings": {
                "name": "DossierOPCI",
                "properties": {
