/// Les sommes distribuables par arrete. Tableau de bord Arrete et livrables. Ajoutee le 09/09/2026.
table v_sommes_distribuables
	lineageTag: 6b655178-853a-4fd3-9d20-29c8b1accc0c

	/// Sommes distribuables de l'arrete.
	measure 'Total distribuable' = SUM(v_sommes_distribuables[total_distribuable])
		formatString: #,0.00
		displayFolder: Parcours
		lineageTag: 4b95d3e2-f79c-4739-9a96-e3e784c2710b

	/// Total distribuable, entite et arrete affiches.
	measure 'Total distribuable du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Total distribuable], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0.00
		displayFolder: Le dossier
		lineageTag: 03f8d214-8511-4b48-a2df-7366e28eb6d2

	/// Carte 4.2, Total distribuable. Arbitree le 15/09/2026 par la session de la base.
	measure 'R42 Total distribuable' = VAR lignes = COUNTROWS ( v_sommes_distribuables ) RETURN IF ( lignes = 1, SUM ( v_sommes_distribuables[total_distribuable] ) )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: bb939af9-ba5d-41ef-a3b3-9011524ac5e3

	/// Carte 4.2, Acomptes verses. Arbitree le 15/09/2026 par la session de la base.
	measure 'R42 Acomptes verses' = VAR lignes = COUNTROWS ( v_sommes_distribuables ) RETURN IF ( lignes = 1, SUM ( v_sommes_distribuables[acomptes_verses] ) )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 41a09873-8b3a-4548-bdd7-5cf9342a8f12

