/// Sources d une valeur actuelle : saisissables, puis calculees.
table ref_source_valeur
	lineageTag: 250cdd66-fadd-4fc9-98f6-f0ede1ade867

	/// « Une seule valeur à cocher dans « Source » » ou « … dans « Pièce de la valeur » », joints par « · » ; vide sinon
	measure 'Avis proposer la valeur' = VAR p1 = IF ( ISFILTERED ( ref_source_valeur[libelle] ) && COUNTROWS ( VALUES ( ref_source_valeur[libelle] ) ) >= 2, "Une seule valeur à cocher dans « Source »." ) VAR j1 = p1 VAR p2 = IF ( ISFILTERED ( v_ecran_pieces_valorisation[nom_fichier] ) && COUNTROWS ( VALUES ( v_ecran_pieces_valorisation[nom_fichier] ) ) >= 2, "Une seule valeur à cocher dans « Pièce de la valeur »." ) VAR j2 = IF ( j1 <> "" && p2 <> "", j1 & " · " & p2, j1 & p2 ) RETURN IF ( j2 = "", "", j2 ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 8754124a-483e-49d8-8eaa-642d4e00493c

	/// gris quand [Avis proposer la valeur] n’est pas vide
	measure 'Fond proposer la valeur' = IF ( [Avis proposer la valeur] <> "", "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: f5d2f171-0bf6-4f51-9fdb-28153d0deb4b

