		lineageTag: 14b63fdd-62bb-4e76-aef7-7ddbd9bfe509

	measure 'Libelle condition rang 4' = IF ( [Libelle condition rapport] <> "", [Libelle condition vl], "" )
		lineageTag: 000d9def-590d-4ffe-ae4a-5d20e9d6cbc2

