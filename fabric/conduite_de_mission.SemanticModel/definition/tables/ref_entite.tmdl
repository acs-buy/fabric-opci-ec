table ref_entite
	lineageTag: 5fc83b43-7fa8-4444-945c-dfde8acdd1b3

	/// Entités du périmètre filtré.
	measure 'Entites du perimetre' = DISTINCTCOUNT(ref_entite[Entité])
		formatString: #,0
		displayFolder: Client
		lineageTag: cd0c04eb-aecc-44e2-9c45-3a61169fdcf1

	/// Code de l'entite affichee : la selection, sinon le premier vehicule.
	measure 'Entite courante' = IF(HASONEVALUE(ref_entite[Entité]), SELECTEDVALUE(ref_entite[Entité]), CALCULATE(MIN(ref_entite[Entité]), FILTER(ALL(ref_entite), NOT ISBLANK(ref_entite[forme_vehicule]))))
		displayFolder: Le dossier
		lineageTag: 6e97c78b-8d3e-4616-9fca-c5c27c815e24

	/// Denomination de l'entite affichee.
	measure 'Denomination courante' = VAR e = [Entite courante] RETURN CALCULATE(MIN(ref_entite[Dénomination]), FILTER(ALL(ref_entite), ref_entite[Entité] = e))
		displayFolder: Le dossier
		lineageTag: 1e0cb6c9-bb29-4d8f-9be8-c708ecefa71e

	/// Carte 1. Arbitree le 15/09/2026 par la session de la base.
	measure 'Clients du cabinet' = CALCULATE ( COUNTROWS ( ref_entite ), ref_entite[est_client] = TRUE () )
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: dc627918-582a-4cbf-9d06-ef66154ec660

	measure 'Client selectionne' = VAR choisi = IF ( HASONEVALUE ( ref_entite[Entité] ) && SELECTEDVALUE ( ref_entite[est_client] ) = TRUE (), SELECTEDVALUE ( ref_entite[Entité] ) ) VAR dernier = MAXX ( TOPN ( 1, FILTER ( ALL ( ref_entite ), ref_entite[est_client] = TRUE () ), ref_entite[cree_le], DESC, ref_entite[Entité], ASC ), ref_entite[Entité] ) RETURN IF ( NOT ISBLANK ( choisi ), choisi, dernier )
		displayFolder: Ecran 1 Client
		lineageTag: 6b4e330e-c713-4887-9165-58ff6d88d837

	measure 'Cote acceptation' = IF ( NOT ISBLANK ( [Client selectionne] ), "ACC-" & [Client selectionne] )
		displayFolder: Ecran 1 Client
		lineageTag: 40471883-932f-4c40-9fa7-0d77122fbe08

	measure 'Titre état 1' = "Nouveau client"
