/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table v_perimetre_groupe
	lineageTag: 3e548577-1760-4327-97b6-07c0ad9e8eb7

	measure 'M Vehicule' = CALCULATE ( MAX ( v_perimetre_groupe[Client] ) )
		displayFolder: Ecran 1 Client
		lineageTag: 9cb50080-a211-42fe-b021-8195b91d7687

	measure 'M Quote part' = VAR auNiveauEntite = ISINSCOPE ( ref_entite[Dénomination] ) VAR estClient = SELECTEDVALUE ( ref_entite[est_client] ) RETURN IF ( auNiveauEntite && estClient <> TRUE (), CALCULATE ( MAX ( v_perimetre_groupe[quote_part] ) ) )
		formatString: 0.00%
		displayFolder: Ecran 1 Client
		lineageTag: 185251ab-62eb-4202-bb1e-ff876cb3855b

	measure Quote-part = [M Quote part]
		formatString: 0.00%
		displayFolder: Ecran 1 Client
		lineageTag: 39af31c1-6062-4d37-af1e-5a6c09008b70

	measure 'L Entité' = VAR c = SELECTEDVALUE ( ref_entite[est_client] ) VAR e = SELECTEDVALUE ( ref_entite[Entité] ) RETURN IF ( c = TRUE (), e, "└ " & e )
		displayFolder: Ecran 1 Client
		lineageTag: 274234e7-09ef-420b-8fc5-c4ed7c22682f

	measure 'L Quote-part' = VAR c = SELECTEDVALUE ( ref_entite[est_client] ) RETURN IF ( c <> TRUE (), CALCULATE ( MAX ( v_perimetre_groupe[quote_part] ) ) )
		formatString: 0.00%
		displayFolder: Ecran 1 Client
		lineageTag: dbe72ec2-be68-42d1-8cb4-d39913981321

	measure 'L Ordre' = VAR v = CALCULATE ( MAX ( v_perimetre_groupe[vehicule] ) ) VAR c = SELECTEDVALUE ( ref_entite[est_client] ) RETURN v & IF ( c = TRUE (), "0", "1" ) & SELECTEDVALUE ( ref_entite[Entité] )
		displayFolder: Ecran 1 Client
		lineageTag: 72f07849-c739-48c6-a58b-6f0fd204c84d

	measure 'Quote-part détenue' = VAR c = SELECTEDVALUE ( ref_entite[est_client] ) RETURN IF ( c <> TRUE (), CALCULATE ( MAX ( v_perimetre_groupe[quote_part] ) ) )
		formatString: 0.00%
		displayFolder: Ecran 1 Client
		lineageTag: 040ee993-896c-4d61-a813-972a98ec9bfe

	measure 'Filiales du client' = VAR c = [Client selectionne] RETURN CALCULATE ( COUNTROWS ( v_perimetre_groupe ), FILTER ( ALL ( v_perimetre_groupe ), v_perimetre_groupe[Client] = c && v_perimetre_groupe[est_vehicule] = FALSE () ) )
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: 5a1cb32e-8327-4ae5-a3b2-73e33718147d

