table v_anr_entite
	lineageTag: a6682b0a-c97e-4c39-931e-221254d43acf

	/// Capitaux propres avant différences d'estimation.
	measure 'Capitaux propres comptables' = SUM(v_anr_entite[capitaux_propres_comptables])
		formatString: #,0.00
		displayFolder: Actif net
		lineageTag: aa421b04-870e-4bfb-8a46-5a63112e5f66

	/// Somme des différences d'estimation.
	measure 'Differences d estimation' = SUM(v_anr_entite[differences_d_estimation])
		formatString: #,0.00
		displayFolder: Actif net
		lineageTag: 3916c35c-21e9-4b4d-96c1-1df8d259c8d3

	/// Actif net réévalué de l'entité.
	measure 'Actif net reevalue' = SUM(v_anr_entite[actif_net_reevalue])
		formatString: #,0.00
		displayFolder: Actif net
		lineageTag: 0dd409fb-4c98-463b-8996-dccfdb175215

	/// Part des différences d'estimation dans l'actif net.
	measure 'Poids des differences' = DIVIDE([Differences d estimation], [Actif net reevalue])
		formatString: 0.0 %
		displayFolder: Actif net
		lineageTag: 634ca5b2-4a69-4788-a420-3ce6213d6013

	/// Actif net reevalue de l'entite et de l'arrete affiches.
	measure 'ANR du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Actif net reevalue], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: e7d73ce4-34ce-4cac-94a3-30447c49af44

	/// Differences d'estimation comptabilisees de l'entite et de l'arrete affiches.
	measure 'Differences comptabilisees du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Differences d estimation], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 155ad860-d789-4208-87e9-4bf3fb9d2dfb

	/// Carte 3.3, Actif net reevalue. Arbitree le 15/09/2026 par la session de la base.
	measure 'R33 Actif net reevalue' = VAR lignes = CALCULATE ( COUNTROWS ( v_anr_entite ), v_perimetre_groupe[est_vehicule] = TRUE () ) RETURN IF ( lignes = 1, CALCULATE ( SUM ( v_anr_entite[actif_net_reevalue] ), v_perimetre_groupe[est_vehicule] = TRUE () ) )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 30f7fdc9-a49a-4cef-8471-13f385356976

	/// Carte 3.3, Capitaux propres. Arbitree le 15/09/2026 par la session de la base.
	measure 'R33 Capitaux propres' = VAR lignes = CALCULATE ( COUNTROWS ( v_anr_entite ), v_perimetre_groupe[est_vehicule] = TRUE () ) RETURN IF ( lignes = 1, CALCULATE ( SUM ( v_anr_entite[capitaux_propres_comptables] ), v_perimetre_groupe[est_vehicule] = TRUE () ) )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 26526938-4a66-43eb-bf1f-53584492740a

	/// Carte 3.3, Differences portees. Arbitree le 15/09/2026 par la session de la base.
	measure 'R33 Differences portees' = VAR lignes = CALCULATE ( COUNTROWS ( v_anr_entite ), v_perimetre_groupe[est_vehicule] = TRUE () ) RETURN IF ( lignes = 1, CALCULATE ( SUM ( v_anr_entite[differences_d_estimation] ), v_perimetre_groupe[est_vehicule] = TRUE () ) )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 34a953d6-61b4-4643-853e-1048f00c0614

