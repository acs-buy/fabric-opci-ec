/// Flux intragroupe declares et leur rapprochement.
table v_ecran_flux_groupe
	lineageTag: 0f9f0f0c-26eb-41bd-be47-73265cdcb23f

	/// « n flux · n en écart » (bande 5)
	measure 'Libelle bande groupe' = FORMAT ( COUNTROWS ( v_ecran_flux_groupe ) + 0, "0" ) & " flux · " & FORMAT ( [Flux en ecart], "0" ) & " en écart"
		displayFolder: Ecran 3 Valorisation
		lineageTag: 5563e6e0-4da6-4050-ac27-1afdb2359384

	/// nombre de flux, par nature
	measure 'Flux declares' = COUNTROWS ( v_ecran_flux_groupe ) + 0
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: e4118744-7572-4a8f-bab0-86fc38efdb00

	/// somme des montants déclarés
	measure 'Montant declare' = SUM ( v_ecran_flux_groupe[montant_declare] )
		formatString: #,0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 2a8d96fc-b274-4b3f-bde2-abcc3b884d24

	/// flux dont l’écart du débiteur n’est pas nul
	measure 'Flux en ecart' = CALCULATE ( COUNTROWS ( v_ecran_flux_groupe ), ABS ( v_ecran_flux_groupe[ecart_debiteur] ) >= 0.005 ) + 0
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 4634c9b7-ddaa-4902-8852-a0c13bdb9c31

	/// « n en écart » ; « concorde »
	measure 'Rapprochement de la nature' = VAR n = [Flux en ecart] RETURN IF ( n > 0, FORMAT ( n, "0" ) & " en écart", "concorde" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 054f6be0-7e26-4e22-8989-472184278e43

