/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table v_ecran_message
	lineageTag: e53efe02-ccd7-4042-a2e0-8a37d1d476d3

	measure 'Message ecran' = VAR u = USERPRINCIPALNAME () VAR c = [Client selectionne] VAR m = CALCULATE ( SELECTEDVALUE ( v_ecran_message[message] ), FILTER ( ALL ( v_ecran_message ), v_ecran_message[pour] = u && ( v_ecran_message[entite] = c || v_ecran_message[entite] = "-" ) && v_ecran_message[il_y_a_minutes] <= 30 ) ) VAR g = CALCULATE ( SELECTEDVALUE ( v_ecran_message[geste] ), FILTER ( ALL ( v_ecran_message ), v_ecran_message[pour] = u && ( v_ecran_message[entite] = c || v_ecran_message[entite] = "-" ) && v_ecran_message[il_y_a_minutes] <= 30 ) ) RETURN IF ( ISBLANK ( m ), BLANK (), m & IF ( ISBLANK ( g ), "", "  ·  " & g ) )

	measure 'Fond message ecran' = VAR u = USERPRINCIPALNAME () VAR c = [Client selectionne] VAR gr = CALCULATE ( SELECTEDVALUE ( v_ecran_message[genre] ), FILTER ( ALL ( v_ecran_message ), v_ecran_message[pour] = u && ( v_ecran_message[entite] = c || v_ecran_message[entite] = "-" ) && v_ecran_message[il_y_a_minutes] <= 30 ) ) RETURN SWITCH ( gr, "REFUS", "#F9ECEC", "SUCCES", "#EFF6F2", "#FFFFFF" )

