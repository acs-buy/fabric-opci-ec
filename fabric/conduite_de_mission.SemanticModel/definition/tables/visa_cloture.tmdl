	partition visa_cloture = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_visa_cloture = Value.NativeQuery(Source, "SELECT id, entite, arrete, decision, propose_par, decide_par, DATETIME2FROMPARTS(YEAR(decide_le), MONTH(decide_le), DAY(decide_le), DATEPART(HOUR, decide_le), DATEPART(MINUTE, decide_le), DATEPART(SECOND, decide_le), 0, 0) AS decide_le FROM dbo.visa WHERE nature = 'CLOTURE'", null, [EnableFolding = true])
				in
				    dbo_visa_cloture

