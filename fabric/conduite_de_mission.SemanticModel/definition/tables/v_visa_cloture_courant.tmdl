	measure 'Pied rapport' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Livrable : rapport de l’expert-comptable · " & IF ( ISBLANK ( [Lecture rapport produit] ), "non dû à cet arrêté", [Lecture rapport produit] ) )
