/// Écran 5, objet n° 50 : relation cycle_ou_phase → v_ecran_cycle_ou_phase[code]
table v_ecran_question_referentiel
	lineageTag: 9d441eb6-a858-40b6-ab41-f8cc06578a92

	/// n° 159, « nom d’usage · n questions », n les questions du cycle ou de la phase choisi (sous-titre du bloc « Questions du cycle »)
	measure 'Sous-titre questions du cycle' = VAR c = [Cycle ou phase choisi] VAR nm = [Nom du cycle ou phase choisi] VAR n = COUNTROWS ( FILTER ( ALL ( v_ecran_question_referentiel ), v_ecran_question_referentiel[cycle_ou_phase] = c ) ) + 0 RETURN IF ( ISBLANK ( c ), "", nm & " · " & IF ( n = 0, "aucune question", FORMAT ( n, "0" ) & IF ( n < 2, " question", " questions" ) ) )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 86adb463-0e1d-47c3-a9ba-8be7d427088d

	/// n° 163, fond de la cellule « Statut » de la table des questions : « à valider » #F9ECEC, « validée » #EFF6F2, « écartée » #EEF1F5, « réécrite » #FFF3D6 ; encre de la table, #12233C
	measure 'Fond statut de la question' = SWITCH ( SELECTEDVALUE ( v_ecran_question_referentiel[statut_libelle] ), "à valider", "#F9ECEC", "validée", "#EFF6F2", "écartée", "#EEF1F5", "réécrite", "#FFF3D6", "#EEF1F5" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 4c82c1d0-11e6-4e84-a505-5b05379b352a

	/// n° 165, « n sur n » : questions de phase dont niveau_programme est vide, sur les questions de phase, sous ALL ( v_ecran_question_referentiel ) (même bloc)
	measure 'Questions de phase sans niveau' = VAR t = FILTER ( ALL ( v_ecran_question_referentiel ), ISBLANK ( v_ecran_question_referentiel[cycle] ) ) VAR s = COUNTROWS ( FILTER ( t, ISBLANK ( v_ecran_question_referentiel[niveau_programme] ) ) ) + 0 VAR q = COUNTROWS ( t ) + 0 RETURN FORMAT ( s, "0" ) & " sur " & FORMAT ( q, "0" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: d0dd27ac-bd6f-4530-b86e-05fecce8b5be

