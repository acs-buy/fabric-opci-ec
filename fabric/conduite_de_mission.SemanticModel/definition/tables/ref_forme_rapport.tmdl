	partition ref_forme_rapport = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_ref_forme_rapport = Value.NativeQuery(Source, "SELECT code, exemple, page_np, libelle, intitule, attestation, fondement, texte, ordre, CAST(CASE code WHEN 'COMPTE_RENDU_TRAVAUX' THEN N'Compte rendu de travaux' WHEN 'SANS_OBSERVATION' THEN N'Attestation sans observation' WHEN 'AVEC_OBSERVATION' THEN N'Attestation avec observation(s)' WHEN 'IMPOSSIBILITE' THEN N'Refus d’attester' ELSE libelle END AS NVARCHAR (300)) AS libelle_court FROM dbo.ref_forme_rapport", null, [EnableFolding = true])
				in
				    dbo_ref_forme_rapport

