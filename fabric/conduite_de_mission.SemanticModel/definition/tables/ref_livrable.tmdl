	measure 'Tuile rapport' = VAR et = CALCULATE ( [Etat du livrable], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "ATTESTATION" ) VAR v = CALCULATE ( [Version du livrable], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "ATTESTATION" ) VAR r = CALCULATE ( [Lignes a remplir du livrable], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "ATTESTATION" ) RETURN IF ( ISBLANK ( et ), "", et & IF ( ISBLANK ( v ), "", ", " & v ) & IF ( r > 0, ", " & FORMAT ( r, "0" ) & IF ( r > 1, " cellules à remplir", " cellule à remplir" ), "" ) )
