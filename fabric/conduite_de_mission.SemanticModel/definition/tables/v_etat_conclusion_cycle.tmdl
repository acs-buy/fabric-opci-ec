/// Etape 5 : une ligne par cycle au programme d'un arrete de mission d'un vehicule.
table v_etat_conclusion_cycle
	lineageTag: 9bea6e63-e2f9-4d84-a7c5-93cad672a0f0

	measure 'Ref cycle a viser' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR u = USERPRINCIPALNAME () VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) VAR b = MAXX ( t, v_etat_conclusion_cycle[blocage_visa] ) VAR auteur = MAXX ( t, v_etat_conclusion_cycle[conclu_par] ) VAR s = [Superviseur connecte CYCLE] RETURN IF ( COUNTROWS ( t ) = 1 && ISBLANK ( b ) && auteur <> u && NOT ISBLANK ( s ), e & "|" & a & "|" & c )
		displayFolder: Ecran 2 etape 5
		lineageTag: fe0ecede-6b79-4a62-898e-5b3c174248f5

	measure 'Ref cycle a renvoyer' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR u = USERPRINCIPALNAME () VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) VAR v = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), IF ( v_revision_indicateurs[verrouille], 1, 0 ) ) VAR et = MAXX ( t, v_etat_conclusion_cycle[etat] ) VAR auteur = MAXX ( t, v_etat_conclusion_cycle[conclu_par] ) VAR r = MAXX ( FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ), v_etat_revue[etat] ) VAR s = [Superviseur connecte CYCLE] RETURN IF ( COUNTROWS ( t ) = 1 && et IN { "CONCLU", "VISE" } && v <> 1 && r <> "VISEE" && auteur <> u && NOT ISBLANK ( s ), e & "|" & a & "|" & c )
		displayFolder: Ecran 2 etape 5
		lineageTag: 776ab52e-e737-4cf2-9389-e1e2f965247c

	measure 'Titre des questions du cycle' = VAR c = [Cycle selectionne] RETURN IF ( ISBLANK ( c ), "Questions du cycle", "Questions du cycle " & c )
		displayFolder: Ecran 2 etape 5
		lineageTag: 98cbbd08-bccb-4953-8f22-bfb15daf10ea

	measure 'Titre de la conclusion du cycle' = VAR c = [Cycle selectionne] RETURN IF ( ISBLANK ( c ), "Conclusion du cycle", "Conclusion du cycle " & c )
		displayFolder: Ecran 2 etape 5
		lineageTag: ec23433e-9a3b-42fa-9234-ea839175aba9

	measure 'Libelle enregistrer la conclusion du cycle' = VAR c = [Cycle selectionne] RETURN IF ( ISBLANK ( c ), "Enregistrer la conclusion du cycle", "Enregistrer la conclusion de " & c )
		displayFolder: Ecran 2 etape 5
		lineageTag: af4c648f-2832-4ea2-bd87-a63641721dbb

	measure 'Sous-titre des questions du cycle' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) RETURN IF ( COUNTROWS ( t ) = 1, FORMAT ( MAXX ( t, v_etat_conclusion_cycle[Questions au programme] ) + 0, "0" ) & " au programme" )
		displayFolder: Ecran 2 etape 5
		lineageTag: 4d3372d8-1f89-46ae-9502-9d1dcf12350b

	measure 'Questions repondues du cycle' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) RETURN IF ( COUNTROWS ( t ) = 1, FORMAT ( MAXX ( t, v_etat_conclusion_cycle[questions_repondues] ) + 0, "0" ) & " sur " & FORMAT ( MAXX ( t, v_etat_conclusion_cycle[Questions au programme] ) + 0, "0" ) & " répondues" )
		displayFolder: Ecran 2 etape 5
		lineageTag: 848f8cdd-27ff-47bb-911c-82f3ef35848e

	measure 'Etat de la conclusion du cycle' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) VAR cp = MAXX ( t, v_etat_conclusion_cycle[conclu_par] ) VAR cl = MAXX ( t, v_etat_conclusion_cycle[conclu_le] ) VAR dd = MAXX ( t, v_etat_conclusion_cycle[derniere_decision] ) VAR dp = MAXX ( t, v_etat_conclusion_cycle[decide_par] ) VAR dl = MAXX ( t, v_etat_conclusion_cycle[decide_le] ) VAR mo = MAXX ( t, v_etat_conclusion_cycle[motif_renvoi] ) VAR ncp = IF ( SEARCH ( "@", cp, 1, 0 ) > 1, LEFT ( cp, SEARCH ( "@", cp, 1, 0 ) - 1 ), cp ) VAR ndp = IF ( SEARCH ( "@", dp, 1, 0 ) > 1, LEFT ( dp, SEARCH ( "@", dp, 1, 0 ) - 1 ), dp ) VAR lc = IF ( ISBLANK ( cl ), "aucune enregistrée", "enregistrée par " & ncp & ", le " & FORMAT ( cl, "dd/MM/yyyy" ) ) VAR lv = SWITCH ( dd, "VISE", "visé par " & ndp & ", le " & FORMAT ( dl, "dd/MM/yyyy" ), "RENVOYE", "renvoyé par " & ndp & ", le " & FORMAT ( dl, "dd/MM/yyyy" ) & IF ( ISBLANK ( mo ), "", ", motif : " & mo ), "aucune décision" ) RETURN IF ( COUNTROWS ( t ) <> 1, BLANK (), "Conclusion du cycle : " & lc & " · Visa du cycle : " & lv )
		displayFolder: Ecran 2 etape 5
		lineageTag: 7bead725-1fe5-42e4-a227-f7cbe90d5d14

	measure 'Supervision du cycle' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) VAR av = MAXX ( t, v_etat_conclusion_cycle[a_viser] ) + 0 VAR vi = MAXX ( t, v_etat_conclusion_cycle[vises] ) + 0 VAR rv = MAXX ( t, v_etat_conclusion_cycle[renvoyes] ) + 0 RETURN IF ( COUNTROWS ( t ) <> 1, BLANK (), "Supervision du cycle : " & FORMAT ( av, "0" ) & IF ( av > 1, " objets", " objet" ) & " à viser · " & FORMAT ( vi, "0" ) & IF ( vi > 1, " visas accordés", " visa accordé" ) & " · " & IF ( rv > 0, FORMAT ( rv, "0" ) & IF ( rv > 1, " renvois en cours", " renvoi en cours" ), "aucun renvoi en cours" ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: 4d1553bd-fa03-46d6-914a-fb618896facb

	measure 'Blocage du visa du cycle' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR u = USERPRINCIPALNAME () VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) VAR b = MAXX ( t, v_etat_conclusion_cycle[blocage_visa] ) VAR cp = MAXX ( t, v_etat_conclusion_cycle[conclu_par] ) VAR p2 = IF ( NOT ISBLANK ( cp ) && cp = u, "le connecté a conclu ce cycle" ) VAR roles = CALCULATE ( CONCATENATEX ( VALUES ( role_nature_visa[role_code] ), role_nature_visa[role_code], ", ", role_nature_visa[role_code], ASC ), role_nature_visa[nature] = "CYCLE" ) VAR p3 = IF ( ISBLANK ( [Superviseur connecte CYCLE] ), IF ( roles = "CHEF_MISSION", "visa réservé au chef de mission", "visa réservé aux rôles " & roles ) ) VAR l = b & IF ( NOT ISBLANK ( b ) && NOT ISBLANK ( p2 ), " ; " ) & p2 & IF ( ( NOT ISBLANK ( b ) || NOT ISBLANK ( p2 ) ) && NOT ISBLANK ( p3 ), " ; " ) & p3 RETURN IF ( COUNTROWS ( t ) <> 1, BLANK (), IF ( l = "", "possible", l ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: 62da04b7-dad4-4105-8394-fb53bd432bd0

	measure 'Fond revCclViser' = IF ( ISBLANK ( [Ref cycle a viser] ) || ISBLANK ( [Superviseur connecte CYCLE] ), "#D9DFE6", "#0F5C8C" )
		lineageTag: 70e87092-3829-4188-accb-1a7846c1b555

	measure 'Fond revCclRenvoyer' = IF ( ISBLANK ( [Ref cycle a renvoyer] ) || ISBLANK ( [Superviseur connecte CYCLE] ), "#D9DFE6", "#FFFFFF" )
		lineageTag: ddc3b92a-8458-4d7b-9359-4289e45ce903

	measure 'Pastilles des cycles du programme' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a ) RETURN IF ( COUNTROWS ( t ) > 0, CONCATENATEX ( t, v_etat_conclusion_cycle[cycle] & " " & LOWER ( v_etat_conclusion_cycle[etat_libelle] ), "  ·  ", v_etat_conclusion_cycle[cycle_ordre], ASC ) )
		lineageTag: daca4c01-ba32-414e-a9a2-0c9f6b7cb330

	measure 'Conclusion du cycle enregistrée' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) RETURN IF ( COUNTROWS ( t ) = 1, MAXX ( t, v_etat_conclusion_cycle[conclusion] ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: 1e5db753-1de5-4b1d-8e66-4ba0fe6f218f

	measure 'Motif du renvoi du cycle' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR t = FILTER ( ALL ( v_etat_conclusion_cycle ), v_etat_conclusion_cycle[entite] = e && v_etat_conclusion_cycle[arrete] = a && v_etat_conclusion_cycle[cycle] = c ) RETURN IF ( COUNTROWS ( t ) = 1, MAXX ( t, v_etat_conclusion_cycle[motif_renvoi] ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: d796dd7b-1519-4401-85ac-057dee512366

	measure 'Libelle revCclViser' = "Viser le cycle"
		lineageTag: df049780-5332-4ff0-90c1-87f2a2f7d373

	measure 'Libelle revCclRenvoyer' = "Renvoyer le cycle"
		lineageTag: 26fa3496-83f5-4f62-bdd6-9abef4b29a66

