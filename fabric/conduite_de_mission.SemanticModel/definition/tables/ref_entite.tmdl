	measure 'En-tête étape 3b' = VAR r = [Reference acceptation selectionnee] RETURN IF ( ISBLANK ( r ), "Pièce justificative", "Pièce pour la question " & r )

	measure 'Entite selectionnee' = IF ( HASONEVALUE ( ref_entite[Entité] ), SELECTEDVALUE ( ref_entite[Entité] ) )

	measure 'Ref cycle' = IF ( NOT ISBLANK ( [Cycle selectionne] ), [Entite selectionnee] & "|" & [Arrete selectionne] & "|" & [Cycle selectionne] )

	measure 'Ref revue' = IF ( NOT ISBLANK ( [Arrete selectionne] ), [Entite selectionnee] & "|" & [Arrete selectionne] )

	/// Le client choisi dans le sélecteur Véhicule de la Révision, vide hors d'un client : aucun repli.
	measure 'Client de la revision' = IF ( HASONEVALUE ( ref_entite[Entité] ) && SELECTEDVALUE ( ref_entite[est_client] ) = TRUE (), SELECTEDVALUE ( ref_entite[Entité] ) )
		displayFolder: Ecran 1 Client
		lineageTag: 2c017a59-b9f9-40f9-8c33-1d9f125f22b8

