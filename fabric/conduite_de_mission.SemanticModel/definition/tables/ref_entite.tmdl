	/// Carte fond de la ligne d'un client dans la liste. Arbitree le 15/09/2026 par la session de la base.
	measure 'Fond ligne entite' = IF ( [Est un client] = "oui", "#F4F8FC", "#FFFFFF" )
		displayFolder: Ecran 1 Client
