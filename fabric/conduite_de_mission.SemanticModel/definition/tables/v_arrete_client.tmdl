	partition v_arrete_client = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_v_arrete_client = Value.NativeQuery(Source, "SELECT cle_arrete, entite, arrete, type_arrete, exercice, date_arrete, visa_cloture_id, cloture_visee_par, DATETIME2FROMPARTS(YEAR(cloture_visee_le), MONTH(cloture_visee_le), DAY(cloture_visee_le), DATEPART(HOUR, cloture_visee_le), DATEPART(MINUTE, cloture_visee_le), DATEPART(SECOND, cloture_visee_le), 0, 0) AS cloture_visee_le, selection FROM dbo.v_arrete_client", null, [EnableFolding = true])
