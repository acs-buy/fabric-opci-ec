/// Écran 5, objet n° 40 : table de la grille et des 4 filtres de l’étape 1 ; aucune relation : les 11 mesures de la fiche la lisent sur la ligne du référentiel choisi
table v_ecran_inventaire_referentiel
	lineageTag: 95307003-ac60-409e-84ba-1b4265a2a54b

	/// n° 74, nombre de lignes sur les référentiels inscrits du cabinet : du_cabinet = 1 et etat_genre différent de « non recensé » (FILTER ( ALL ( v_ecran_inventaire_referentiel ), … )), les 3 tables non recensées n’y entrant pas (carte 1)
	measure 'Referentiels du cabinet' = COUNTROWS ( FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[du_cabinet] = TRUE () && v_ecran_inventaire_referentiel[etat_genre] <> "non recensé" ) ) + 0
		formatString: #,0
		displayFolder: Ecran 5 Referentiels
		lineageTag: 10d81b2f-7821-451e-8758-1bc2a7fd0a9a

	/// n° 75, « n mis à jour par le cabinet, n fixés par un texte », sur les mêmes lignes (carte 1)
	measure 'Sous-ligne referentiels du cabinet' = VAR t = FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[du_cabinet] = TRUE () && v_ecran_inventaire_referentiel[etat_genre] <> "non recensé" ) VAR n = COUNTROWS ( t ) + 0 VAR n1 = COUNTROWS ( FILTER ( t, v_ecran_inventaire_referentiel[mode_tenue] = "TENU" ) ) + 0 RETURN FORMAT ( n1, "0" ) & " mis à jour par le cabinet, " & FORMAT ( n - n1, "0" ) & " fixés par un texte"
		displayFolder: Ecran 5 Referentiels
		lineageTag: ca04825a-4748-46fc-a4dc-0738386134a2

	/// n° 76, somme des lignes sur les référentiels inscrits du cabinet : du_cabinet = 1 et etat_genre différent de « non recensé » (FILTER ( ALL ( v_ecran_inventaire_referentiel ), … )), les 3 tables non recensées n’y entrant pas (carte 2)
	measure 'Lignes de reference du cabinet' = SUMX ( FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[du_cabinet] = TRUE () && v_ecran_inventaire_referentiel[etat_genre] <> "non recensé" ), v_ecran_inventaire_referentiel[lignes] ) + 0
		formatString: #,0
		displayFolder: Ecran 5 Referentiels
		lineageTag: fcd06ca4-5cee-4cfa-a444-dadfb6deb5c1

	/// n° 77, « dans les n référentiels du cabinet », n = [Referentiels du cabinet] (carte 2)
	measure 'Sous-ligne lignes de reference' = "dans les " & FORMAT ( [Referentiels du cabinet], "0" ) & " référentiels du cabinet"
		displayFolder: Ecran 5 Referentiels
		lineageTag: f56703ed-799e-4164-b0f0-131eb0c75bc9

	/// n° 78, somme des lignes modifiées sur les mêmes lignes (carte 3)
	measure 'Lignes modifiees du cabinet' = SUMX ( FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[du_cabinet] = TRUE () && v_ecran_inventaire_referentiel[etat_genre] <> "non recensé" ), v_ecran_inventaire_referentiel[lignes_modifiees] ) + 0
		formatString: #,0
		displayFolder: Ecran 5 Referentiels
		lineageTag: 7ab616af-f9b2-4b57-adc2-3de1a7d857da

	/// n° 79, « depuis l’import, dernière le jj/mm/aaaa », « depuis l’import » sans modification (carte 3)
	measure 'Sous-ligne lignes modifiees' = VAR d = MAXX ( FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[du_cabinet] = TRUE () && v_ecran_inventaire_referentiel[etat_genre] <> "non recensé" ), v_ecran_inventaire_referentiel[derniere_modification] ) RETURN IF ( ISBLANK ( d ), "depuis l’import", "depuis l’import, dernière le " & FORMAT ( d, "dd/MM/yyyy" ) )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 7f593ce3-2619-46e9-8b63-920731ce77be

	/// n° 80, or au-dessus de 0, vert à 0 (trait et valeur de la carte 3)
	measure 'Couleur lignes modifiees' = IF ( [Lignes modifiees du cabinet] > 0, "#8A6710", "#1F6D4A" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 11f3da58-6d78-4c26-be19-6c720712ab9b

	/// n° 87, « n recensés, n lignes ; n non recensés » (sous-titre de la grille de l’étape 1, en expression)
	measure 'Sous-titre grille de l inventaire' = VAR nh = COUNTROWS ( FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[du_cabinet] = TRUE () && v_ecran_inventaire_referentiel[etat_genre] = "non recensé" ) ) + 0 VAR nl = [Lignes de reference du cabinet] RETURN FORMAT ( [Referentiels du cabinet], "0" ) & " recensés, " & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( nl, "#,0" ), UNICHAR ( 160 ), " " ), UNICHAR ( 8239 ), " " ) & " lignes ; " & FORMAT ( nh, "0" ) & IF ( nh < 2, " non recensé", " non recensés" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: d1503105-3724-40cf-a4c4-b279c6a4f632

	/// n° 88, fond de la cellule « État » de la grille selon etat_genre : « modifié » #FFF3D6, « à valider » #F9ECEC, « importé », « non modifiable », « non recensé » et « aucune ligne » #EEF1F5 ; encre de la table, #12233C (couleurs : tableau « Décisions techniques »)
	measure 'Fond etat de l inventaire' = SWITCH ( SELECTEDVALUE ( v_ecran_inventaire_referentiel[etat_genre] ), "modifié", "#FFF3D6", "à valider", "#F9ECEC", "#EEF1F5" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 14821605-cc94-4a91-8223-0ff65b1ea46f

	/// n° 91, VAR c = [Referentiel choisi] : couleur d’action quand le mode_tenue de la ligne c vaut TENU, contour sinon (bouton « Modifier le référentiel »)
	measure 'Fond modifier le referentiel' = VAR c = [Referentiel choisi] VAR m = CALCULATE ( MAX ( v_ecran_inventaire_referentiel[mode_tenue] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) RETURN IF ( m = "TENU", "#0F5C8C", "#FFFFFF" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 71cb7924-a6de-4655-b12f-90787b409e29

	/// n° 92, couleur d’action quand le mode_tenue de la ligne c vaut TEXTE, contour sinon (bouton « Consulter le référentiel »)
	measure 'Fond consulter le referentiel' = VAR c = [Referentiel choisi] VAR m = CALCULATE ( MAX ( v_ecran_inventaire_referentiel[mode_tenue] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) RETURN IF ( m = "TEXTE", "#0F5C8C", "#FFFFFF" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 23293e61-7e09-4926-afad-1ee294a84402

	/// n° 94, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( domaine ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Domaine du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[domaine] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: f65f89c4-adf2-4c18-9b37-c09e9ec3aaa2

	/// n° 95, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( lignes ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Lignes du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[lignes] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) )
		formatString: #,0
		displayFolder: Ecran 5 Referentiels
		lineageTag: abec0164-8899-4047-a210-c4b9fbe8049a

	/// n° 96, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( lignes_modifiees ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Lignes modifiees du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[lignes_modifiees] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) )
		formatString: #,0
		displayFolder: Ecran 5 Referentiels
		lineageTag: 14a2fadd-306b-4b22-be24-108298d9cc99

	/// n° 97, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( derniere_modification_texte ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Derniere modification du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[derniere_modification_texte] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: 12263754-1b03-48d0-a4ec-0bbbdb91c70b

	/// n° 98, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( modifie_par ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ou pour un référentiel sans modification ; une valeur de la carte de la fiche
	measure 'Auteur du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[modifie_par] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: cc97cc64-a23c-4294-9aa9-5dbd0871b535

	/// n° 99, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( qui_libelle ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Qui modifie le referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[qui_libelle] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: fa0251c3-d6d1-49bc-b0cd-e82acc42bacc

	/// n° 100, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( mode_libelle ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Contenu du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[mode_libelle] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: 8ec257eb-2498-4478-9224-6fa12083025b

	/// n° 101, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( etat ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Etat du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[etat] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: 451782e6-4c8c-4574-88ce-c3181550bfe4

	/// n° 102, « annexe à recalculer pour n véhicules : » suivi de « ajout », « suppression », de « code » quand une colonne de la clé non numérotée par la base porte marque_annexe = 1, et des libellés des autres colonnes de v_ecran_referentiel_colonnes où marque_annexe = 1 (CONCATENATEX, VAR c = [Referent
	measure 'Effet sur l annexe du referentiel choisi' = VAR c = [Referentiel choisi] VAR n = CALCULATE ( MAX ( v_ecran_inventaire_referentiel[effet_annexe] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) VAR num = CALCULATE ( MAX ( v_ecran_referentiel_choix[forme_cle] ), FILTER ( ALL ( v_ecran_referentiel_choix ), v_ecran_referentiel_choix[table_nom] = c ) ) = "numérotée" VAR cols = CONCATENATEX ( FILTER ( ALL ( v_ecran_referentiel_colonnes ), v_ecran_referentiel_colonnes[referentiel] = c && v_ecran_referentiel_colonnes[marque_annexe] = 1 ), ", " & "«" & UNICHAR ( 8239 ) & v_ecran_referentiel_colonnes[libelle_colonne] & UNICHAR ( 8239 ) & "»", "", v_ecran_referentiel_colonnes[rang_annexe], ASC ) RETURN IF ( ISBLANK ( c ), "", IF ( n > 0, "annexe à recalculer pour " & FORMAT ( n, "0" ) & IF ( n < 2, " véhicule", " véhicules" ) & " : ajout, suppression" & IF ( num, "", ", code" ) & cols & " ; les autres colonnes sont sans effet", "aucun effet" ) )
		displayFolder: Ecran 5 Referentiels
		lineageTag: f78db58b-5f79-46ba-8ea5-2fa9d8b0d0a3

	/// n° 103, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( ecran_lu ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ; une valeur de la carte de la fiche
	measure 'Ecrans du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[ecran_lu] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: 86dc5aaa-ba04-4f3b-b819-895d24af7802

	/// n° 104, fond des cellules de la ligne de la grille de l’étape 1 quand table_nom = [Referentiel choisi], #F4F8FC, « #FFFFFF » ailleurs, comme [Fond ligne entite] ; la colonne « État » exceptée, peinte par [Fond etat de l inventaire]
	measure 'Fond ligne choisie' = VAR c = [Referentiel choisi] RETURN IF ( NOT ISBLANK ( c ) && SELECTEDVALUE ( v_ecran_inventaire_referentiel[table_nom] ) = c, "#F4F8FC", "#FFFFFF" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 8186572a-ecb4-41c7-8363-2b7eb5252660

	/// n° 106, « domaine › catégorie · n lignes · état » de la ligne du référentiel choisi, « domaine › catégorie · aucune ligne » pour un référentiel sans ligne (1re ligne de la carte de la bande)
	measure 'Lignes et etat du referentiel choisi' = VAR c = [Referentiel choisi] VAR t = FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) VAR d = MAXX ( t, v_ecran_inventaire_referentiel[domaine] ) VAR g = MAXX ( t, v_ecran_inventaire_referentiel[categorie] ) VAR n = MAXX ( t, v_ecran_inventaire_referentiel[lignes] ) VAR e = MAXX ( t, v_ecran_inventaire_referentiel[etat] ) RETURN IF ( ISBLANK ( c ) || ISEMPTY ( t ), "", d & " › " & g & " · " & IF ( e = "aucune ligne", e, FORMAT ( n, "0" ) & IF ( n < 2, " ligne", " lignes" ) & " · " & e ) )
		displayFolder: Ecran 5 Referentiels
		lineageTag: a681286c-3da6-464f-b89e-0f384197e14b

	/// n° 107, « modifiable par : … · utilisé par : … » pour un référentiel mis à jour par le cabinet, « fixé par un texte · utilisé par : … » pour un référentiel fixé par un texte, les seuls noms d’écran de ecran_lu (2e ligne de la carte de la bande)
	measure 'Modification et emploi du referentiel choisi' = VAR c = [Referentiel choisi] VAR t = FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) VAR m = MAXX ( t, v_ecran_inventaire_referentiel[mode_tenue] ) VAR qu = MAXX ( t, v_ecran_inventaire_referentiel[qui_libelle] ) VAR e0 = MAXX ( t, v_ecran_inventaire_referentiel[ecran_lu] ) VAR p = SUBSTITUTE ( e0, " ; ", "|" ) VAR segs = ADDCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( p ) + 0, 1 ), "s", PATHITEM ( p, [Value], TEXT ) ) VAR noms = GENERATE ( segs, VAR s0 = [s] VAR k0 = SEARCH ( " : ", s0, 1, 0 ) VAR q0 = SUBSTITUTE ( IF ( k0 > 0, LEFT ( s0, k0 - 1 ), s0 ), ", ", "|" ) RETURN SELECTCOLUMNS ( GENERATESERIES ( 1, PATHLENGTH ( q0 ) + 0, 1 ), "j", [Value], "nom", PATHITEM ( q0, [Value], TEXT ) ) ) VAR rangs = ADDCOLUMNS ( noms, "o", [Value] * 1000 + [j] ) VAR uniques = FILTER ( rangs, VAR nm = [nom] VAR o0 = [o] RETURN COUNTROWS ( FILTER ( rangs, [nom] = nm && [o] < o0 ) ) = 0 ) VAR court = IF ( SEARCH ( " : ", e0, 1, 0 ) = 0, e0, CONCATENATEX ( uniques, [nom], ", ", [o], ASC ) ) RETURN IF ( ISBLANK ( c ) || ISEMPTY ( t ), "", IF ( m = "TENU", "modifiable par : " & qu, "fixé par un texte" ) & " · utilisé par : " & court )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 497bf88f-9184-4439-a294-1eb0ffd2ef57

	/// n° 108, VAR c = [Referentiel choisi], puis CALCULATE ( MAX ( categorie ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), [table_nom] = c ) ) & "" ; vide sans référentiel choisi ; une valeur de la carte de la fiche (ligne « Catégorie »)
	measure 'Categorie du referentiel choisi' = VAR c = [Referentiel choisi] RETURN CALCULATE ( MAX ( v_ecran_inventaire_referentiel[categorie] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) & ""
		displayFolder: Ecran 5 Referentiels
		lineageTag: 7f57821a-28b1-445a-9425-ba38fb792b53

