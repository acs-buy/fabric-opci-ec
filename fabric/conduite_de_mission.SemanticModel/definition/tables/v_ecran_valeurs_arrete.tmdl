/// Valeurs de l arrete, une ligne par actif a valeur saisie du vehicule et de ses filiales.
table v_ecran_valeurs_arrete
	lineageTag: ed0e20e4-efbe-489f-81b4-159a5590fc14

	/// aucun actif bloqué, aucune valeur PROPOSE, chaque rapport rattaché, chaque immeuble des filiales valorisé
	measure 'Valorisation etape 1 faite' = VAR n = COUNTROWS ( v_ecran_valeurs_arrete ) VAR bloques = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[etat_generation] <> "CALCULABLE" ) + 0 VAR proposees = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[etat_valeur] = "PROPOSE" ) + 0 VAR sans_rapport = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[rapport_rattache] = FALSE () ) + 0 VAR filiales = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[est_filiale] = TRUE (), v_ecran_valeurs_arrete[famille] = "IMMEUBLE", ISBLANK ( v_ecran_valeurs_arrete[valeur_actuelle] ) ) + 0 RETURN IF ( n > 0 && bloques + proposees + sans_rapport + filiales = 0, 1, 0 )
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: bfed5157-dd4a-461b-bd70-64b72ee8584a

	/// remplissage de la forme et de la puce de l’étape 1 : vert quand [Valorisation etape 1 faite] vaut 1, gris sinon (forme etape0 et etapePuce0 de ec01)
	measure 'Fond valorisation etape 1' = IF ( [Valorisation etape 1 faite] = 1, "#1F6D4A", "#D5DCE4" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: c8f2acbf-6a05-47be-9bcf-7626d4440433

	/// « n actifs · n / n valeurs arrêtées » (bande 1)
	measure 'Libelle type immeubles' = VAR n = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[famille] = "IMMEUBLE" ) + 0 VAR ok = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[famille] = "IMMEUBLE", v_ecran_valeurs_arrete[etat_generation] = "CALCULABLE" ) + 0 RETURN FORMAT ( n, "0" ) & " actifs · " & FORMAT ( ok, "0" ) & " / " & FORMAT ( n, "0" ) & " valeurs arrêtées"
		displayFolder: Ecran 3 Valorisation
		lineageTag: 77f155f2-fd9d-4d58-91d8-09be67b9f44a

	/// « n actifs » ou « aucun actif » (bande 1)
	measure 'Libelle type instruments' = VAR n = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[famille] = "INSTRUMENT" ) + 0 RETURN IF ( n > 0, FORMAT ( n, "0" ) & " actifs", "aucun actif" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 8557d509-38fa-4cc0-88fc-c057e58c5542

	/// le code de la ligne choisie de la grille 1a ou 1c
	measure 'Actif choisi' = IF ( HASONEVALUE ( v_ecran_valeurs_arrete[code_actif] ), SELECTEDVALUE ( v_ecran_valeurs_arrete[code_actif] ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: a959bc1c-e2b2-437d-b87e-daf41e962b6d

	/// l’evaluation_id de la ligne choisie, en texte (un paramètre d’action ne prend pas de mesure numérique)
	measure 'Evaluation choisie' = IF ( HASONEVALUE ( v_ecran_valeurs_arrete[code_actif] ), SELECTEDVALUE ( v_ecran_valeurs_arrete[evaluation_id] ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 738403bc-c4ca-4f5f-8651-143a77cb3b7c

	/// « n immeubles du véhicule et de ses filiales »
	measure 'Sous-titre grille des immeubles' = FORMAT ( CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[famille] = "IMMEUBLE" ) + 0, "0" ) & " immeubles du véhicule et de ses filiales"
		displayFolder: Ecran 3 Valorisation
		lineageTag: 8b34d854-6454-4f22-af4a-de4fa74cf911

	/// « actif · entité · prix de revient x » ; « aucun actif choisi »
	measure 'Sous-titre fiche de l actif' = VAR c = [Actif choisi] RETURN IF ( ISBLANK ( c ), "aucun actif choisi", c & " · " & CALCULATE ( MAX ( v_ecran_valeurs_arrete[entite] ), FILTER ( ALL ( v_ecran_valeurs_arrete[code_actif] ), v_ecran_valeurs_arrete[code_actif] = c ) ) & " · prix de revient " & FORMAT ( CALCULATE ( MAX ( v_ecran_valeurs_arrete[prix_de_revient] ), FILTER ( ALL ( v_ecran_valeurs_arrete[code_actif] ), v_ecran_valeurs_arrete[code_actif] = c ) ), "#,0.00" ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 459ff6c8-bab5-4787-ba70-975d27bf7ba0

	/// « actif · prix de revient x » ; « aucun actif choisi »
	measure 'Sous-titre valeur de l actif' = VAR c = [Actif choisi] RETURN IF ( ISBLANK ( c ), "aucun actif choisi", c & " · prix de revient " & FORMAT ( CALCULATE ( MAX ( v_ecran_valeurs_arrete[prix_de_revient] ), FILTER ( ALL ( v_ecran_valeurs_arrete[code_actif] ), v_ecran_valeurs_arrete[code_actif] = c ) ), "#,0.00" ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: a50e5d2c-f0e4-4569-af05-48707b154463

	/// le code de l’actif choisi ; « aucun actif choisi »
	measure 'Libelle de l actif choisi' = IF ( ISBLANK ( [Actif choisi] ), "aucun actif choisi", [Actif choisi] )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 87f77095-17c1-4a2d-ab01-4a28a6281a66

	/// « classe 3, véhicule et filiales · n actifs » ; « … · aucun actif »
	measure 'Sous-titre grille des instruments' = VAR n = CALCULATE ( COUNTROWS ( v_ecran_valeurs_arrete ), v_ecran_valeurs_arrete[famille] = "INSTRUMENT" ) + 0 RETURN "classe 3, véhicule et filiales · " & IF ( n > 0, FORMAT ( n, "0" ) & " actifs", "aucun actif" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 43ad90ad-6674-4a5f-a61b-829b27a60d84

	/// « instrument · entité » ; « aucun instrument choisi »
	measure 'Sous-titre fiche de l instrument' = VAR c = [Actif choisi] RETURN IF ( ISBLANK ( c ), "aucun instrument choisi", c & " · " & CALCULATE ( MAX ( v_ecran_valeurs_arrete[entite] ), FILTER ( ALL ( v_ecran_valeurs_arrete[code_actif] ), v_ecran_valeurs_arrete[code_actif] = c ) ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 15da74eb-a82e-428b-acff-28bd294500e4

