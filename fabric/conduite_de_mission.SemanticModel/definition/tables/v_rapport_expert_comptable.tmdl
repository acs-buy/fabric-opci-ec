/// Les donnees du rapport de l'expert-comptable, par arrete auquel il est du.
table v_rapport_expert_comptable
	lineageTag: e4a2c433-88ca-49e4-89cc-d62bbe640c15

	measure 'Obstacle a la production du rapport' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR u = USERPRINCIPALNAME () VAR j = TODAY () VAR o = CALCULATE ( [Obstacle a la production], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "ATTESTATION" ) VAR rnpn = SELECTCOLUMNS ( FILTER ( ALL ( role_nature_visa ), role_nature_visa[nature] = "PUBLICATION" ), "r", role_nature_visa[role_code] ) VAR rrpn = SELECTCOLUMNS ( FILTER ( ALL ( ref_role ), ref_role[vise] = TRUE () ), "r", ref_role[code] ) VAR pn = COUNTROWS ( FILTER ( ALL ( role_mission ), role_mission[entite] = e && ( role_mission[connexion] = u || role_mission[personne] = u ) && role_mission[du] <= j && ( ISBLANK ( role_mission[au] ) || role_mission[au] > j ) && role_mission[role] IN rnpn && role_mission[role] IN rrpn ) ) + 0 VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) RETURN SWITCH ( TRUE (), NOT ISBLANK ( o ), o, pn = 0, "le rapport de l'expert-comptable est signé par l'associé signataire, et lui seul le produit.", ISBLANK ( al ), "la forme du rapport de l'expert-comptable n'est pas arrêtée pour cet arrêté.", BLANK () )
		displayFolder: Ecran 2 etape 6
		lineageTag: 8d6f9ab8-2940-47fd-a76a-8fd9e076c3c8

	measure 'Arrete du rapport a produire' = CALCULATE ( [Arrete a produire en Word], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "ATTESTATION" )
		displayFolder: Ecran 2 etape 6
		lineageTag: 098dcc12-6c8d-4eb2-9ce5-c2bd661ad44d

	measure 'Adresse du rapport' = CALCULATE ( [Adresse du livrable choisi], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "ATTESTATION" )
		displayFolder: Ecran 2 etape 6
		lineageTag: e4e1737e-9f3f-4a8a-b834-4433f7fb9337

	measure 'Carte rapport' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) VAR dur = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = "ATTESTATION" ) ) > 0 VAR fr = [Forme retenue] VAR lib = MAXX ( FILTER ( ALL ( ref_forme_rapport ), ref_forme_rapport[code] = fr ), ref_forme_rapport[libelle_court] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( NOT dur, "Sans objet", IF ( NOT ISBLANK ( al ) && NOT ISBLANK ( fa ), lib, "À arrêter" ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 87940fd8-9485-4b08-b6f9-5d1ead881ca5

	measure 'Carte rapport sous-titre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR typ = MAXX ( FILTER ( ALL ( ref_arrete ), ref_arrete[entite] = e && ref_arrete[Arrêté] = a ), ref_arrete[Type] ) VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) VAR sc = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), IF ( ISBLANK ( ref_entite[soumise_commissariat_comptes] ), BLANK (), IF ( ref_entite[soumise_commissariat_comptes], 1, 0 ) ) ) VAR fp0 = MAXX ( FILTER ( ALL ( v_forme_attestation_proposee ), v_forme_attestation_proposee[entite] = e && v_forme_attestation_proposee[arrete] = a ), v_forme_attestation_proposee[forme_proposee] ) VAR fp = IF ( fp0 = "REFUS_ATTESTER", "IMPOSSIBILITE", fp0 ) VAR dur = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = "ATTESTATION" ) ) > 0 VAR fr = [Forme retenue] VAR lib = MAXX ( FILTER ( ALL ( ref_forme_rapport ), ref_forme_rapport[code] = fr ), ref_forme_rapport[libelle_court] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( NOT dur, "non dû à l’arrêté " & LOWER ( typ ), IF ( NOT ISBLANK ( al ) && NOT ISBLANK ( fa ), "forme arrêtée le " & FORMAT ( al, "dd/MM/yyyy" ), IF ( NOT ISBLANK ( sc ) && sc = 0 && NOT ISBLANK ( fp ), "proposée", "par défaut" ) & " : " & LOWER ( lib ) ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 15d5f130-f8de-4175-b3c9-b4175515be17

	measure 'Carte rapport encre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) VAR dur = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = "ATTESTATION" ) ) > 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || NOT dur, "#12233C", IF ( NOT ISBLANK ( al ) && NOT ISBLANK ( fa ), "#1F6D4A", "#8A6710" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: af1db5ed-f0f6-4864-b69e-d79215281da7

	measure 'Commissariat aux comptes de l entite' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR sc = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), IF ( ISBLANK ( ref_entite[soumise_commissariat_comptes] ), BLANK (), IF ( ref_entite[soumise_commissariat_comptes], 1, 0 ) ) ) RETURN IF ( ISBLANK ( e ), BLANK (), IF ( ISBLANK ( sc ), "à remplir", IF ( sc = 1, "oui", "non" ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: f0fcf3a4-b893-4415-b618-3126cb2d08bc

	measure 'Forme proposee par la base' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR fp0 = MAXX ( FILTER ( ALL ( v_forme_attestation_proposee ), v_forme_attestation_proposee[entite] = e && v_forme_attestation_proposee[arrete] = a ), v_forme_attestation_proposee[forme_proposee] ) VAR fp = IF ( fp0 = "REFUS_ATTESTER", "IMPOSSIBILITE", fp0 ) VAR lib = MAXX ( FILTER ( ALL ( ref_forme_rapport ), ref_forme_rapport[code] = fp ), ref_forme_rapport[libelle_court] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( ISBLANK ( lib ), "aucune", lib ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 05752465-4d81-457d-9de4-540b4a3b7c78

	measure 'Intitule de la forme retenue' = VAR fr = [Forme retenue] VAR it = MAXX ( FILTER ( ALL ( ref_forme_rapport ), ref_forme_rapport[code] = fr ), ref_forme_rapport[intitule] ) RETURN IF ( ISBLANK ( it ), BLANK (), "« " & SUBSTITUTE ( it, "PRESENTATION", "PRÉSENTATION" ) & " »" )
		displayFolder: Ecran 2 etape 6
		lineageTag: edf9bda8-b85a-4f73-a717-cc69c59ce3fe

	measure 'Arret de la forme' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) VAR ap0 = MAXX ( tr, v_rapport_expert_comptable[arretee_par] ) VAR ap = IF ( SEARCH ( "@", ap0, 1, 0 ) > 1, LEFT ( ap0, SEARCH ( "@", ap0, 1, 0 ) - 1 ), ap0 ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( NOT ISBLANK ( al ) && NOT ISBLANK ( fa ), "le " & FORMAT ( al, "dd/MM/yyyy" ) & " par " & ap, "non" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: f9e91ee8-bc30-46da-9ad6-9252f36e2673

	measure 'Derniere version du rapport' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR typ = MAXX ( FILTER ( ALL ( ref_arrete ), ref_arrete[entite] = e && ref_arrete[Arrêté] = a ), ref_arrete[Type] ) VAR l = "ATTESTATION" VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR pl = MAXX ( tv, document_produit[produit_le] ) VAR pp = MAXX ( tv, document_produit[produit_par] ) VAR pe = MAXX ( tv, document_produit[perime_le] ) VAR pm = MAXX ( tv, document_produit[perime_motif] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR tdv = FILTER ( tq, demande_document[version] = dv ) VAR dd = MAXX ( tdv, demande_document[etat] ) VAR dl = MAXX ( tdv, demande_document[demande_le] ) VAR dm = MAXX ( tdv, demande_document[motif_refus] ) VAR du = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR fl = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR fs = SUBSTITUTE ( fl, ",", "|" ) VAR fx = "," & CONCATENATEX ( tv, document_produit[format], "," ) & "," VAR fm = FILTER ( GENERATESERIES ( 1, IF ( ISBLANK ( fl ), 0, PATHLENGTH ( fs ) ) ), NOT CONTAINSSTRING ( fx, "," & PATHITEM ( fs, [Value] ) & "," ) ) VAR nm = COUNTROWS ( fm ) + 0 VAR mq = CONCATENATEX ( fm, SWITCH ( PATHITEM ( fs, [Value] ), "DOCX", "Word", "XLSX", "classeur Excel", PATHITEM ( fs, [Value] ) ), " et ", [Value], ASC ) VAR dvm = MAXX ( FILTER ( tq, demande_document[version] = vm ), demande_document[etat] ) VAR et = IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), NOT du, "sans objet", dd IN { "DEMANDEE", "REFUSEE" } && ( ISBLANK ( pl ) || dl > pl ), IF ( dd = "DEMANDEE", "demande posée", "refusé" ), ISBLANK ( vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( NOT du, "sans objet à l’arrêté " & LOWER ( typ ) & " du " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ), IF ( ISBLANK ( vm ), "aucune", "v" & FORMAT ( vm, "0" ) & ", produite le " & FORMAT ( pl, "dd/MM/yyyy" ) & IF ( NOT ISBLANK ( pe ), ", périmée le " & FORMAT ( pe, "dd/MM/yyyy" ), "" ) ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: f22ec868-355e-452d-a9c7-fb7e75a2c4b7

	measure 'Comptes couverts par le rapport' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR dur = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = "ATTESTATION" ) ) > 0 VAR l = "COMPTES_ANNUELS" VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR pl = MAXX ( tv, document_produit[produit_le] ) VAR pp = MAXX ( tv, document_produit[produit_par] ) VAR pe = MAXX ( tv, document_produit[perime_le] ) VAR pm = MAXX ( tv, document_produit[perime_motif] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR tdv = FILTER ( tq, demande_document[version] = dv ) VAR dd = MAXX ( tdv, demande_document[etat] ) VAR dl = MAXX ( tdv, demande_document[demande_le] ) VAR dm = MAXX ( tdv, demande_document[motif_refus] ) VAR du = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR fl = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR fs = SUBSTITUTE ( fl, ",", "|" ) VAR fx = "," & CONCATENATEX ( tv, document_produit[format], "," ) & "," VAR fm = FILTER ( GENERATESERIES ( 1, IF ( ISBLANK ( fl ), 0, PATHLENGTH ( fs ) ) ), NOT CONTAINSSTRING ( fx, "," & PATHITEM ( fs, [Value] ) & "," ) ) VAR nm = COUNTROWS ( fm ) + 0 VAR mq = CONCATENATEX ( fm, SWITCH ( PATHITEM ( fs, [Value] ), "DOCX", "Word", "XLSX", "classeur Excel", PATHITEM ( fs, [Value] ) ), " et ", [Value], ASC ) VAR dvm = MAXX ( FILTER ( tq, demande_document[version] = vm ), demande_document[etat] ) VAR et = IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), NOT du, "sans objet", dd IN { "DEMANDEE", "REFUSEE" } && ( ISBLANK ( pl ) || dl > pl ), IF ( dd = "DEMANDEE", "demande posée", "refusé" ), ISBLANK ( vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( NOT dur, "comptes annuels, sans objet à cet arrêté", IF ( du && NOT ISBLANK ( vm ), "version " & FORMAT ( vm, "0" ), "aucune version des comptes annuels produite" ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: b2eb7e14-a160-4fe7-96fd-492951ed4464

	measure 'Valeur liquidative de l arrete' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR p = MAXX ( FILTER ( ALL ( publication_vl ), ISBLANK ( publication_vl[perimee_le] ) && publication_vl[entite] = e && publication_vl[arrete] = a ), publication_vl[publie_le] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( ISBLANK ( p ), "non publiée", "publiée le " & FORMAT ( p, "dd/MM/yyyy" ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 8da14c17-53b6-405b-94ad-a959f4cd6a10

	measure 'Considerations particulieres enregistrees' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), MAXX ( tr, v_rapport_expert_comptable[motif_considerations_particulieres] ) & "" )
		displayFolder: Ecran 2 etape 6
		lineageTag: 54ffd069-c663-4e2e-ade4-48ffc5743914

	measure 'Motif de limitation enregistre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) VAR fr = [Forme retenue] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( fr IN { "COMPTE_RENDU_TRAVAUX", "SANS_OBSERVATION" }, "sans objet pour cette forme", MAXX ( tr, v_rapport_expert_comptable[motif_limitation] ) & "" ) )
		displayFolder: Ecran 2 etape 6
