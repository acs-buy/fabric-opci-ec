/// Qui tient quel role sur quelle entite, et de quand a quand : ASSOCIE, CHEF_MISSION ou PREPARATEUR, 16 entites chacun. La colonne connexion porte le compte nomme du reviseur, renseigne sur 32 lignes sur 48. Table de reference de la securite au niveau des lignes de la V2 du front office ; AUCUNE REGLE N'EST POSEE ICI, la regle DAX est ecrite par la session de la base. Ajoutee le 15/09/2026.
table role_mission
	lineageTag: 5cd6859a-939f-4a60-96be-80eee32293bc

	measure 'Role du connecte' = VAR u = USERPRINCIPALNAME () VAR c = [Client selectionne] RETURN IF ( u <> "", SWITCH ( TRUE (), CALCULATE ( COUNTROWS ( role_mission ), FILTER ( ALL ( role_mission ), role_mission[connexion] = u && role_mission[entite] = c && role_mission[role] = "ASSOCIE" && role_mission[du] <= TODAY () && ( ISBLANK ( role_mission[au] ) || role_mission[au] >= TODAY () ) ) ) > 0, "ASSOCIE", CALCULATE ( COUNTROWS ( role_mission ), FILTER ( ALL ( role_mission ), role_mission[connexion] = u && role_mission[entite] = c && role_mission[role] = "CHEF_MISSION" && role_mission[du] <= TODAY () && ( ISBLANK ( role_mission[au] ) || role_mission[au] >= TODAY () ) ) ) > 0, "CHEF_MISSION", CALCULATE ( COUNTROWS ( role_mission ), FILTER ( ALL ( role_mission ), role_mission[connexion] = u && role_mission[entite] = c && role_mission[role] IN { "PREPARATEUR", "REVISEUR" } && role_mission[du] <= TODAY () && ( ISBLANK ( role_mission[au] ) || role_mission[au] >= TODAY () ) ) ) > 0, "REVISEUR" ) )
		displayFolder: Ecran 1 Client
		lineageTag: b033a5cc-ea07-435c-8be8-b8a124d97c52

	measure 'Superviseur connecte' = VAR u = USERPRINCIPALNAME () VAR n = IF ( ISFILTERED ( role_nature_visa[nature] ), SELECTEDVALUE ( role_nature_visa[nature] ) ) VAR l = IF ( n = "LOT" && ISFILTERED ( v_lots_perimetre ) && HASONEVALUE ( v_lots_perimetre[Lot] ), SELECTEDVALUE ( v_lots_perimetre[Entité] ) ) VAR ent = IF ( ISBLANK ( l ), [Client selectionne], l ) VAR roles = VALUES ( role_nature_visa[role_code] ) VAR ok = COUNTROWS ( FILTER ( ALL ( role_mission ), role_mission[entite] = ent && ( role_mission[connexion] = u || role_mission[personne] = u ) && role_mission[role] IN roles && role_mission[du] <= TODAY () && ( ISBLANK ( role_mission[au] ) || role_mission[au] > TODAY () ) ) ) RETURN IF ( u <> "" && ok > 0, u )
		displayFolder: Ecran 1 Client
		lineageTag: 20b1a6f0-b32d-4db3-9161-e98b7a787785

	measure 'Superviseur connecte CYCLE' = CALCULATE ( [Superviseur connecte], role_nature_visa[nature] = "CYCLE" )
		displayFolder: Ecran 2 etape 5
		lineageTag: 8abe2394-4517-4b70-bf27-fe9f4eaab40e

	measure 'Superviseur connecte REVUE' = CALCULATE ( [Superviseur connecte], role_nature_visa[nature] = "REVUE" )
		displayFolder: Ecran 2 etape 5
		lineageTag: 49721426-5843-4d71-ba1f-8207336356bf

	measure 'Superviseur connecte LOT' = CALCULATE ( [Superviseur connecte], role_nature_visa[nature] = "LOT" )
		displayFolder: Ecran 2 etape 5
		lineageTag: 490c4abc-15d4-4ea3-a2b4-d70026383b8c

