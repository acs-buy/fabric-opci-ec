/// Les cellules de l'annexe des comptes annuels, derniere version de chaque arrete de mission, une ligne par cellule : son texte affiche, son etat, sa source ; calculee et stockee par la base.
table v_annexe_cellule
	lineageTag: 8e43160a-e16d-4dcf-bab1-3c23f3dd4841

	measure 'Devise de l annexe' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), MAXX ( FILTER ( ALL ( v_annexe_cellule ), v_annexe_cellule[entite] = e && v_annexe_cellule[arrete] = a && v_annexe_cellule[article] = "311-1" && v_annexe_cellule[ligne] = "DEVISE" && v_annexe_cellule[colonne] = 1 ), v_annexe_cellule[texte_affiche] ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 8a3c0ee6-61ab-407b-99f7-04b6bd7c05b0

	measure 'Ligne saisissable' = IF ( COUNTROWS ( FILTER ( v_annexe_cellule, v_annexe_cellule[nature] IN { "texte", "source" } || v_annexe_cellule[etat] = "A_REMPLIR" ) ) > 0, 1 )
