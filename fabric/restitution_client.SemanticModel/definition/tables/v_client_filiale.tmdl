/// Les participations, filiale par filiale : capitaux propres, differences d'estimation, actif net reevalue, quote-part, valeur actuelle et cout des titres. Script 141.
table v_client_filiale
	lineageTag: 99e50d31-8c10-4450-9ff4-a8bbba60ebf3

	measure 'Filiales detenues' = COUNTROWS ( v_client_filiale )
		formatString: #,0
		lineageTag: 3a3cff81-e103-4260-8158-435cd39b5a1c

	measure 'Total valeur actuelle des titres' = SUM ( v_client_filiale[Valeur actuelle des titres] )
		formatString: #,0.00
		lineageTag: a5c0395e-c9d7-49f5-8636-7494975fe4dc

