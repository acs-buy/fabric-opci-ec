/// Les mouvements du portefeuille dans la periode : acquisitions, cessions, travaux. Rubrique 5 du DIP. Script 141.
table v_client_mouvement_actif
	lineageTag: f0410297-d2e8-476d-b9f7-f5913d19c5b3

	/// Le nombre de mouvements de la periode ; 0 se lit « aucun mouvement ».
	measure 'Mouvements de la periode' = COUNTROWS ( v_client_mouvement_actif ) + 0
