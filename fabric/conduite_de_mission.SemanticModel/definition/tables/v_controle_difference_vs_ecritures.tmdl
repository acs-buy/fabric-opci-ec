/// Controle C84 : differences des actifs contre ecritures.
table v_controle_difference_vs_ecritures
	lineageTag: 20fbd0b7-acf2-4be3-b3be-b1a3990202ec

	/// « en anomalie » ; « concorde »
	measure 'Etat du controle C84' = VAR n = COUNTROWS ( v_controle_difference_vs_ecritures ) VAR x = SUMX ( v_controle_difference_vs_ecritures, ABS ( v_controle_difference_vs_ecritures[ecart] ) ) RETURN IF ( n > 0, IF ( x >= 0.005, "en anomalie", "concorde" ) )
