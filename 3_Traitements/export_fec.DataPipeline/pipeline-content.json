                  },
                  "annotations": []
                }
              },
              "annotations": []
            }
          },
          "sink": {
            "type": "DelimitedTextSink",
            "formatSettings": {
              "type": "DelimitedTextWriteSettings",
              "quoteAllText": false,
              "fileExtension": ".txt"
            },
            "storeSettings": {
              "type": "AzureBlobStorageWriteSettings",
              "copyBehavior": "PreserveHierarchy"
            },
            "datasetSettings": {
              "type": "DelimitedText",
              "typeProperties": {
                "location": {
                  "type": "LakehouseLocation",
                  "folderPath": "fec_sortant",
                  "fileName": {
                    "value": "@concat(pipeline().parameters.entite, '_', replace(pipeline().parameters.arrete, '-', ''), '_analytique')",
                    "type": "Expression"
                  }
                },
                "columnDelimiter": "\t",
                "rowDelimiter": "\n",
                "encodingName": "UTF-8",
                "quoteChar": "",
                "escapeChar": "",
                "firstRowAsHeader": true
              },
              "schema": [],
              "linkedService": {
                "name": "Coffre",
                "properties": {
