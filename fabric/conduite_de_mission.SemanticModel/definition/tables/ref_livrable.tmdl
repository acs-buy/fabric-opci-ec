	measure 'Produit par et le' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR pl = MAXX ( tv, document_produit[produit_le] ) VAR pp = MAXX ( tv, document_produit[produit_par] ) VAR pe = MAXX ( tv, document_produit[perime_le] ) VAR pm = MAXX ( tv, document_produit[perime_motif] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR tdv = FILTER ( tq, demande_document[version] = dv ) VAR dd = MAXX ( tdv, demande_document[etat] ) VAR dl = MAXX ( tdv, demande_document[demande_le] ) VAR dm = MAXX ( tdv, demande_document[motif_refus] ) VAR du = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR fl = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR fs = SUBSTITUTE ( fl, ",", "|" ) VAR fx = "," & CONCATENATEX ( tv, document_produit[format], "," ) & "," VAR fm = FILTER ( GENERATESERIES ( 1, IF ( ISBLANK ( fl ), 0, PATHLENGTH ( fs ) ) ), NOT CONTAINSSTRING ( fx, "," & PATHITEM ( fs, [Value] ) & "," ) ) VAR nm = COUNTROWS ( fm ) + 0 VAR mq = CONCATENATEX ( fm, SWITCH ( PATHITEM ( fs, [Value] ), "DOCX", "Word", "XLSX", "classeur Excel", PATHITEM ( fs, [Value] ) ), " et ", [Value], ASC ) VAR dvm = MAXX ( FILTER ( tq, demande_document[version] = vm ), demande_document[etat] ) VAR et = IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), NOT du, "sans objet", dd IN { "DEMANDEE", "REFUSEE" } && ( ISBLANK ( pl ) || dl > pl ), IF ( dd = "DEMANDEE", "demande posée", "refusé" ), ISBLANK ( vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) RETURN IF ( NOT ISBLANK ( et ) && du && NOT ISBLANK ( pp ), pp & ", " & FORMAT ( pl, "dd/MM/yyyy" ) )
