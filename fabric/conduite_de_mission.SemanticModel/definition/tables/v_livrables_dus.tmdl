/// Les livrables dus par entite et arrete, avec leur production et leur peremption. Source de la carte Livrables produits du tableau de bord du dossier. Ajoutee le 09/09/2026.
table v_livrables_dus
	lineageTag: 5479c11d-be89-474d-8fc4-570267a1fe76

	/// Livrables dus sur le perimetre filtre.
	measure 'Livrables dus' = COUNTROWS(v_livrables_dus) + 0
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 19e24046-621c-4e0d-96a4-b95ffb4ecf89

	/// Livrables portant une date de production.
	measure 'Livrables produits' = CALCULATE(COUNTROWS(v_livrables_dus), NOT ISBLANK(v_livrables_dus[produit_le])) + 0
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 690a1f9f-7a89-40e4-96df-f708b474df6f

	/// Livrables dus non encore produits.
	measure 'Livrables restants' = [Livrables dus] - [Livrables produits]
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 053ed5fd-3cdd-401d-b8bc-d454ffaa6b5e

	/// Part des livrables produits parmi les dus.
	measure 'Part des livrables produits' = DIVIDE([Livrables produits], [Livrables dus])
		formatString: 0 %
		displayFolder: Le dossier
		lineageTag: 5139af4d-ad0d-4e24-b6d7-44ce42a218a3

	/// Libelle de carte : produits sur dus.
	measure 'Livrables produits sur dus' = [Livrables produits] & " sur " & [Livrables dus]
		displayFolder: Le dossier
		lineageTag: 6e6433cc-3073-4c9e-8666-257faddbacb0

	/// Livrables dus, entite et arrete affiches.
	measure 'Livrables dus du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Livrables dus], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: d12234b4-38d7-4d27-ac84-34630a418392

	/// Livrables produits, entite et arrete affiches.
	measure 'Livrables produits du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Livrables produits], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 73ac2c5f-358c-47fc-92d1-238eb50f1e65

	/// Alias.
	measure 'Livrables dus du dossier courant' = [Livrables dus du dossier]
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: cd69714a-0d4d-4b85-9919-c1437b7f43e3

