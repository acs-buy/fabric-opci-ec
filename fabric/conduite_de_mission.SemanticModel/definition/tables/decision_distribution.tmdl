/// Decisions de distribution inscrites, une par categorie et par exercice.
table decision_distribution
	lineageTag: 0515a684-aab4-4bd0-8aba-73a9f8447cfb

	/// « n décisions inscrites » ; « aucune décision inscrite »
	measure 'Libelle bande decision' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR n = COUNTROWS ( FILTER ( ALL ( decision_distribution ), decision_distribution[entite] = e && decision_distribution[exercice] = a ) ) + 0 RETURN IF ( n = 0, "aucune décision inscrite", FORMAT ( n, "0" ) & IF ( n > 1, " décisions inscrites", " décision inscrite" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: 7a00ca1d-7769-47dc-ac73-daf632d00cb2

	/// « exercice aaaa · n décisions » ; « exercice aaaa · aucune décision inscrite »
	measure 'Sous-titre decisions inscrites' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR n = COUNTROWS ( FILTER ( ALL ( decision_distribution ), decision_distribution[entite] = e && decision_distribution[exercice] = a ) ) + 0 RETURN "exercice " & LEFT ( a, 4 ) & " · " & IF ( n = 0, "aucune décision inscrite", FORMAT ( n, "0" ) & IF ( n > 1, " décisions", " décision" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: e152ac41-da47-456d-b999-980cd2ae9655

	/// le libellé de ref_obligation_distribution de la catégorie de la ligne (VAR c = SELECTEDVALUE ( decision_distribution[categorie] ) puis FILTER ( ALL ( ref_obligation_distribution ), [categorie] = c )) ; vide quand le contexte ne porte pas exactement 1 catégorie ; colonne « Catégorie » des décisions i
	measure 'Libelle categorie de la decision' = VAR c = IF ( HASONEVALUE ( decision_distribution[categorie] ), SELECTEDVALUE ( decision_distribution[categorie] ) ) RETURN IF ( ISBLANK ( c ), "", CALCULATE ( MAX ( ref_obligation_distribution[libelle] ), FILTER ( ALL ( ref_obligation_distribution ), ref_obligation_distribution[categorie] = c ) ) ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: fbb61fd2-df48-4d9a-9c6a-80f00c70ecd6

