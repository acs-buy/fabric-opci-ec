/// Le dernier releve de chaque controle de la base : lignes controlees, anomalies, date et auteur. Sans cle d'entite ni d'arrete, les controles portent sur la base entiere. Source des cartes Controles du tableau de bord du dossier. Ajoutee le 09/09/2026.
table v_dernier_releve_controle
	lineageTag: b60287ac-c590-48bc-b80e-de40da99f785

	/// Controles de la base portant un dernier releve.
	measure 'Controles releves' = COUNTROWS(v_dernier_releve_controle) + 0
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: aa3ea2a1-5f0d-401a-a124-cc37f302f8b2

	/// Controles dont le dernier releve porte au moins une anomalie.
	measure 'Controles en anomalie' = CALCULATE(COUNTROWS(v_dernier_releve_controle), v_dernier_releve_controle[anomalies] > 0) + 0
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 1dc9eda2-5298-4827-9e6f-e03b44e26129

	/// Controles sans anomalie au dernier releve.
	measure 'Controles conformes' = [Controles releves] - [Controles en anomalie]
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 3bd9493c-e119-49dc-a286-1c42439d5940

	/// Part des controles conformes.
	measure 'Part des controles conformes' = DIVIDE([Controles conformes], [Controles releves])
		formatString: 0 %
		displayFolder: Le dossier
		lineageTag: 9e578d02-ea2f-4bec-814c-4448f4a30134

	/// Libelle de carte : anomalies sur releves.
	measure 'Controles en anomalie sur releves' = [Controles en anomalie] & " sur " & [Controles releves]
		displayFolder: Le dossier
		lineageTag: ab1127fd-49ec-4f32-9ffe-f92be08f50eb

