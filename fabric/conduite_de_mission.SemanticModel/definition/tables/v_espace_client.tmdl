/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table v_espace_client
	lineageTag: 4b0212b5-6ec8-46d2-b6f6-cce8c3e1414a

	measure 'Site SharePoint du client' = VAR c = [Client selectionne] VAR v = CALCULATE ( SELECTEDVALUE ( v_espace_client[site_url] ), FILTER ( ALL ( v_espace_client ), v_espace_client[entite] = c ) ) RETURN IF ( ISBLANK ( v ), "aucun (Modifier)", v )
		displayFolder: Ecran 1 Client
		lineageTag: 0b1fb881-485b-4e58-8bda-936f8313cee2

	measure 'Actuel Site SharePoint' = VAR c = [Client selectionne] VAR v = CALCULATE ( SELECTEDVALUE ( v_espace_client[site_url] ), FILTER ( ALL ( v_espace_client ), v_espace_client[entite] = c ) ) RETURN "actuel : " & IF ( ISBLANK ( v ), "aucun", v )
		displayFolder: Ecran 1 Client
		lineageTag: 7cfa0adb-f05a-4b34-835b-fb41f225639c

