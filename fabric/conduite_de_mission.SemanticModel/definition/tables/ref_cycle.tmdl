		sourceColumn: ordre

		annotation SummarizationSetBy = Automatic

	column Cycle = SWITCH ( ref_cycle[code], "CAPITAL", "Capital", "AFFECT", "Résultat", "IMMO", "Immeubles", "PART", "Participations", "VALO", "Valorisation", "FIN", "Placements", "TRESO", "Trésorerie", "TIERS", "Tiers", "FRAIS", "Frais de gestion", "CESSIONS", "Cessions", "HB", "Hors bilan", ref_cycle[libelle] )
		dataType: string
		lineageTag: 3499c1c2-9972-471a-bc7d-64b6602badd1
		summarizeBy: none
		sortByColumn: 'Ordre revision'

	column 'Ordre revision' = SWITCH ( ref_cycle[code], "TRESO", 1, "TIERS", 2, "FRAIS", 3, "IMMO", 4, "PART", 5, "VALO", 6, "CAPITAL", 7, "AFFECT", 8, "CESSIONS", 9, "FIN", 10, "HB", 11, 99 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3e706ac7-c8b2-47a9-9a0e-09fb62ba7020
