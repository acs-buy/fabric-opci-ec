/// La valeur liquidative par part a chaque arrete, son ecart avec la precedente, et l'actif net reevalue qui la fonde.
table v_valeur_liquidative
	lineageTag: e6a20890-1aac-4967-9520-a6aa1b88cea4

	/// La valeur liquidative par part a l'arrete choisi dans le segment.
	measure 'VL de l''arrete' =
			VAR a = MAX ( v_arrete_client[arrete] )
			RETURN CALCULATE ( MAX ( v_valeur_liquidative[Valeur liquidative par part] ), v_valeur_liquidative[Arrêté] = a )
		formatString: #,0.00
		lineageTag: 75e7dc77-2c92-4219-8bc2-50ffb5b40ed7

	/// L'ecart de la valeur liquidative a l'arrete precedent.
	measure 'Ecart de VL' =
			VAR a = MAX ( v_arrete_client[arrete] )
			RETURN CALCULATE ( MAX ( v_valeur_liquidative[Écart à l'arrêté précédent] ), v_valeur_liquidative[Arrêté] = a )
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: ab09c630-9fbc-4240-b0b5-267965ad39c7

	/// L'actif net reevalue a l'arrete choisi.
	measure 'ANR de l''arrete' =
			VAR a = MAX ( v_arrete_client[arrete] )
			RETURN CALCULATE ( MAX ( v_valeur_liquidative[Actif net réévalué] ), v_valeur_liquidative[Arrêté] = a )
		formatString: #,0.00
		lineageTag: 8afd4c9a-6873-44a6-87a0-4087c5450bd0

	/// Le nombre de parts a l'arrete choisi.
	measure 'Parts à l''arrêté' =
			VAR a = MAX ( v_arrete_client[arrete] )
			RETURN CALCULATE ( MAX ( v_valeur_liquidative[Parts en circulation] ), v_valeur_liquidative[Arrêté] = a )
		formatString: #,0
		lineageTag: 5968f93e-9d1a-478a-914b-58ee15cc75d3

	/// Pour le graphique d'evolution, une valeur par arrete.
	measure 'VL par arrêté' = MAX ( v_valeur_liquidative[Valeur liquidative par part] )
		formatString: #,0.00
		lineageTag: 7092ed93-beb2-48e4-87e9-367d7f7db75f

