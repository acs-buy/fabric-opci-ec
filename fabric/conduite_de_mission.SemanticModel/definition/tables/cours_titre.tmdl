/// Cours saisis des titres 256 et 258 du vehicule.
table cours_titre
	lineageTag: 21b45d47-3bc1-46b0-833e-462d78aba5a5

	/// la quantité saisie du titre de la ligne (256, 258)
	measure 'Quantite du titre' = VAR c = SELECTEDVALUE ( v_differences_titres[code_actif] ) RETURN CALCULATE ( SUM ( cours_titre[quantite] ), FILTER ( ALL ( cours_titre[code_actif] ), cours_titre[code_actif] = c ) )
		formatString: #,0.####
		displayFolder: Ecran 3 Valorisation
		lineageTag: e64ae726-e3bb-47a8-82d3-7beaca59359e

	/// le cours ou la VL saisi du titre de la ligne
	measure 'Cours du titre' = VAR c = SELECTEDVALUE ( v_differences_titres[code_actif] ) RETURN CALCULATE ( SUM ( cours_titre[cours] ), FILTER ( ALL ( cours_titre[code_actif] ), cours_titre[code_actif] = c ) )
		formatString: #,0.00##
		displayFolder: Ecran 3 Valorisation
		lineageTag: 1acd9190-5fa0-44bc-af31-76e519dc9255

	/// « n cours saisis · aucun titre choisi », « n cours saisis · <titre> »
	measure 'Sous-titre cours de l arrete' = VAR n = COUNTROWS ( cours_titre ) + 0 VAR t = IF ( HASONEVALUE ( v_differences_titres[code_actif] ), SELECTEDVALUE ( v_differences_titres[code_actif] ) ) RETURN FORMAT ( n, "0" ) & " cours saisis · " & IF ( ISBLANK ( t ), "aucun titre choisi", t )
		displayFolder: Ecran 3 Valorisation
		lineageTag: ff75542e-e11c-4d0d-a536-fe795e24a799

	/// même règle, segment « Titre »
	measure 'Avis enregistrer le cours' = VAR p1 = IF ( ISFILTERED ( v_differences_titres[code_actif] ) && COUNTROWS ( VALUES ( v_differences_titres[code_actif] ) ) >= 2, "Une seule valeur à cocher dans « Titre »." ) VAR j1 = p1 RETURN IF ( j1 = "", "", j1 ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 49a14480-d4f4-4c4d-ae48-49f95ccad997

	/// gris quand [Avis enregistrer le cours] n’est pas vide
	measure 'Fond enregistrer le cours' = IF ( [Avis enregistrer le cours] <> "", "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 87b65bbb-a5f8-4ca8-b78a-c520908506c4

