		displayFolder: Ecran 1 Client
		lineageTag: 36578599-c8e3-4bba-87dd-a831dbc67027

	/// Carte titre du formulaire de modification. Arbitree le 15/09/2026 par la session de la base.
	measure 'En-tête étape 1c' = "Modifier " & [Client selectionne] & " · un champ laissé vide reste inchangé"
		displayFolder: Ecran 1 Client
