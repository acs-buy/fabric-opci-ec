		lineageTag: a2a00caf-aae1-44a5-8e2b-cff5df05b2a9

	measure 'Infobulle e3cBouton0' = SWITCH ( TRUE (), ISBLANK ( [Client selectionne] ), "Aucun client choisi dans la liste des clients.", NOT ISBLANK ( [Retrait de piece refuse] ), [Retrait de piece refuse], "Retire du dossier le rattachement choisi ; le fichier reste dans SharePoint." )
		displayFolder: Ecran Client boutons
		lineageTag: 52b580f9-ef4f-4cf7-bd95-2ea4c04787b4

	measure 'Fond e5bBouton0' = IF ( ISBLANK ( [Client selectionne] ) || NOT ISBLANK ( [Refus demande reouverture] ), "#E4E9EF", "#0F5C8C" )
