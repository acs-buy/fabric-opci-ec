	measure 'Limitation des diligences' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR li = MAXX ( FILTER ( ALL ( v_forme_attestation_proposee ), v_forme_attestation_proposee[entite] = e && v_forme_attestation_proposee[arrete] = a ), IF ( v_forme_attestation_proposee[limitation_des_diligences], 1, 0 ) ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), "limitation des diligences : " & IF ( li = 1, "oui", "non" ) )
