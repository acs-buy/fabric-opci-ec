	measure 'Livrable choisi valeur 3' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] RETURN IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), "", SWITCH ( l, "COMPTES_ANNUELS", ( VAR rem = MAXX ( FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ), v_annexe_produisible[cellules_a_remplir] ) + 0 VAR att = MAXX ( FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ), v_annexe_produisible[en_attente] ) + 0 VAR imp = SUMX ( FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a ), v_cellules_a_remplir[imposees] ) + 0 VAR tot = SUMX ( FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a ), v_cellules_a_remplir[cellules] ) + 0 RETURN FORMAT ( rem, "0" ) & " sur " & FORMAT ( tot, "0" ) & " ; " & FORMAT ( att, "0" ) & " en attente ; " & FORMAT ( imp, "0" ) & " d’obligation imposée" ), "ATTESTATION", ( [Carte rapport sous-titre] & "" ), "DIP", ( "6 rubriques sortent de la mission ; la 7e relève de la société de gestion" ), "" ) )
