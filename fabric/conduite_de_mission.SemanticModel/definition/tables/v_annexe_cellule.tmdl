	measure 'Tableau de la ligne annexe' = VAR ar = SELECTEDVALUE ( v_annexe_cellule[article] ) VAR li = SELECTEDVALUE ( v_annexe_cellule[ligne] ) RETURN IF ( ISBLANK ( li ), BLANK (), SWITCH ( TRUE (), ar = "332-1" && ( li IN { "STRATEGIE" } ), 1, ar = "332-1", 2, ar = "332-2" && ( li IN { "MENTIONS_2020_07" } ), 1, ar = "332-2", 2, ar = "334-3" && ( li IN { "ASSIETTE", "REDEVANCES_N", "REDEVANCES_CUM", "RESTANT_1AN", "RESTANT_1_5ANS", "RESTANT_5ANS", "PRIX_RESIDUEL" } ), 2, ar = "334-3", 1, ar = "334-5" && ( li IN { "SECTEURS" } ), 2, ar = "334-5", 1, ar = "335-12" && ( LEFT ( li, 7 ) = "ACPT_N:" || li = "ACPT_N_TOTAL" ), 2, ar = "335-12" && ( LEFT ( li, 8 ) = "ACPT_N1:" || li = "ACPT_N1_TOTAL" ), 3, ar = "335-12", 1, ar = "335-2" && ( li IN { "DEP_CL", "DEP_AC", "DEP_TOTAL" } ), 2, ar = "335-2", 1, ar = "335-4" && ( li IN { "TAUX_FIXE", "RATIOS" } ), 2, ar = "335-4", 1, ar = "336-2" && ( LEFT ( li, 4 ) = "IMM:" || li = "IMM_TOTAL" ), 1, ar = "336-2" && ( LEFT ( li, 4 ) = "FIL:" || li = "FIL_CONTROLEES" || li = "FIL_NON_CONTROLEES" || li = "FIL_A_CLASSER" ), 2, ar = "336-2" && ( LEFT ( li, 4 ) = "AUT:" ), 4, ar = "336-2" && ( li IN { "FIL_NATURE", "FIL_SECTEUR", "FIL_DATE" } ), 5, ar = "336-2", 2, 1 ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 966e2778-5403-4937-98bc-0079aff3630c

	measure 'Ligne annexe' = VAR li = SELECTEDVALUE ( v_annexe_cellule[ligne] ) VAR ar = SELECTEDVALUE ( v_annexe_cellule[article] ) VAR l0 = SELECTEDVALUE ( v_annexe_cellule[libelle] ) VAR p = SEARCH ( " (p. ", l0, 1, 0 ) VAR l = IF ( p > 0, LEFT ( l0, p - 1 ), l0 ) VAR appel = IF ( ar = "333-3" && li IN { "DISTRIB_PREC", "AUTRES" }, UNICHAR ( 185 ), "" ) RETURN IF ( ISBLANK ( li ), BLANK (), IF ( LEFT ( li, 5 ) = "ACPT_", IF ( RIGHT ( li, 6 ) = "_TOTAL", "Total acomptes", "" ), REPT ( UNICHAR ( 8195 ), [Niveau de ligne annexe] ) & l & appel ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 2a3c51d6-a3e8-40bd-9950-f775b3286014

