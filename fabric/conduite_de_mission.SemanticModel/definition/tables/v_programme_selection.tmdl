	column Niveau = IF ( ISBLANK ( v_programme_selection[niveau_programme] ), "Tous", IF ( v_programme_selection[niveau_programme] = 1, "Allégé", IF ( v_programme_selection[niveau_programme] = 2, "Classique", "Étendu" ) ) )
		dataType: string
		lineageTag: 1736eb52-8964-40a8-bc23-654fa663b1b2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Au programme' = IF ( v_programme_selection[actif], "Oui", "—" )
