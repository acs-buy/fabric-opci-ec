	/// Le montant du versement envisage, en euros. Le seul champ que le porteur du dossier deplace.
	column montant_simulable
		dataType: decimal
		formatString: #,0.00
		lineageTag: 46696ee9-f0e2-4ba1-8b07-2fc6a74eb5ba
		summarizeBy: none
		sourceColumn: montant_simulable

	partition v_montant_simulable = m
		mode: import
		source =
				let
				    Source = #"Source OPCI",
				    dbo_v_montant_simulable_cle = Source{[Schema="dbo",Item="v_montant_simulable_cle"]}[Data]
				in
				    dbo_v_montant_simulable_cle

