/// Categories de l obligation de distribution : resultat, plus-values, produits exoneres.
table ref_obligation_distribution
	lineageTag: 8f39381a-7e4d-4a78-b539-a6c449302ce6

	/// « Aucune catégorie choisie » sans case cochée ; vide avec 1 case cochée et plus (carte collée, & "") : à 2 cases cochées, seule la carte [Avis categorie cochee] énonce le nombre coché, à droite de chaque bouton que le segment désactive (décision 10) ; posée dans la fiche de la catégorie, la proposit
	measure 'Absence de categorie choisie' = VAR sel = ISFILTERED ( ref_obligation_distribution[libelle] ) || ISFILTERED ( ref_obligation_distribution[categorie] ) VAR k = COUNTROWS ( VALUES ( ref_obligation_distribution[categorie] ) ) RETURN IF ( NOT sel || k = 0, "Aucune catégorie choisie", "" ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 1d9ba10d-60e1-4728-9f70-1189a43a45b7

	/// « n catégories cochées » quand le segment porte 2 valeurs ou plus ; vide sinon (carte collée, & "") : le service désactive alors Proposer, Viser, Renvoyer et Enregistrer avec une bulle anglaise (guide, § 17.29.1), et la carte, à côté de chaque bouton, énonce le fait en français (décision du candidat
	measure 'Avis categorie cochee' = VAR sel = ISFILTERED ( ref_obligation_distribution[libelle] ) || ISFILTERED ( ref_obligation_distribution[categorie] ) VAR k = COUNTROWS ( VALUES ( ref_obligation_distribution[categorie] ) ) RETURN IF ( sel && k >= 2, FORMAT ( k, "0" ) & " catégories cochées", "" ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 8db50c27-4ceb-49b6-a104-56d5d93165d4

	/// le libellé de la catégorie cochée ; « aucune catégorie choisie » ; « n catégories cochées » (fiches 3a et 3b, proposition, inscription)
	measure 'Sous-titre fiche de la categorie' = VAR sel = ISFILTERED ( ref_obligation_distribution[libelle] ) || ISFILTERED ( ref_obligation_distribution[categorie] ) VAR k = COUNTROWS ( VALUES ( ref_obligation_distribution[categorie] ) ) RETURN IF ( sel && k = 1, SELECTEDVALUE ( ref_obligation_distribution[libelle] ), IF ( NOT sel || k = 0, "aucune catégorie choisie", FORMAT ( k, "0" ) & " catégories cochées" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: d2ccafe2-d30b-4c4a-a098-1df21ec64651

	/// taux en pourcentage à 2 décimales ; vide quand le segment ne porte pas exactement 1 catégorie, comme toutes les mesures [Fiche …] qui suivent
	measure 'Fiche categorie taux' = VAR c = IF ( HASONEVALUE ( v_obligation_par_categorie[categorie_ref] ), SELECTEDVALUE ( v_obligation_par_categorie[categorie_ref] ), IF ( HASONEVALUE ( ref_obligation_distribution[categorie] ), SELECTEDVALUE ( ref_obligation_distribution[categorie] ) ) ) VAR une = NOT ISBLANK ( c ) RETURN IF ( une, FORMAT ( CALCULATE ( MAX ( ref_obligation_distribution[taux] ), FILTER ( ALL ( ref_obligation_distribution ), ref_obligation_distribution[categorie] = c ) ), "0.00 %" ), "" )
		displayFolder: Ecran 4 Arrete
		lineageTag: b8b9de01-3603-4aa9-b5ed-6efa39e3289d

	/// exercice_de_rattachement à la française : EXERCICE « exercice », EXERCICE_SUIVANT « exercice suivant »
	measure 'Fiche categorie rattachement' = VAR c = IF ( HASONEVALUE ( v_obligation_par_categorie[categorie_ref] ), SELECTEDVALUE ( v_obligation_par_categorie[categorie_ref] ), IF ( HASONEVALUE ( ref_obligation_distribution[categorie] ), SELECTEDVALUE ( ref_obligation_distribution[categorie] ) ) ) VAR une = NOT ISBLANK ( c ) VAR x = CALCULATE ( MAX ( ref_obligation_distribution[exercice_de_rattachement] ), FILTER ( ALL ( ref_obligation_distribution ), ref_obligation_distribution[categorie] = c ) ) RETURN IF ( une, SWITCH ( x, "EXERCICE", "exercice", "EXERCICE_SUIVANT", "exercice suivant", x ), "" ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 0678e423-74e0-4de6-a2fd-0898ddbd094a

	/// lu_le, jj/mm/aaaa
	measure 'Fiche categorie lu le' = VAR c = IF ( HASONEVALUE ( v_obligation_par_categorie[categorie_ref] ), SELECTEDVALUE ( v_obligation_par_categorie[categorie_ref] ), IF ( HASONEVALUE ( ref_obligation_distribution[categorie] ), SELECTEDVALUE ( ref_obligation_distribution[categorie] ) ) ) VAR une = NOT ISBLANK ( c ) RETURN IF ( une, FORMAT ( CALCULATE ( MAX ( ref_obligation_distribution[lu_le] ), FILTER ( ALL ( ref_obligation_distribution ), ref_obligation_distribution[categorie] = c ) ), "dd/MM/yyyy" ), "" )
		displayFolder: Ecran 4 Arrete
		lineageTag: f7aff767-c533-4c2d-b731-0b57d866c9aa

	/// « x % du prix de revient des immeubles détenus directement » ; vide sans abattement
	measure 'Fiche categorie abattement' = VAR c = IF ( HASONEVALUE ( v_obligation_par_categorie[categorie_ref] ), SELECTEDVALUE ( v_obligation_par_categorie[categorie_ref] ), IF ( HASONEVALUE ( ref_obligation_distribution[categorie] ), SELECTEDVALUE ( ref_obligation_distribution[categorie] ) ) ) VAR une = NOT ISBLANK ( c ) VAR ab = CALCULATE ( MAX ( ref_obligation_distribution[abattement] ), FILTER ( ALL ( ref_obligation_distribution ), ref_obligation_distribution[categorie] = c ) ) RETURN IF ( une && NOT ISBLANK ( ab ) && ab <> 0, FORMAT ( ab, "0.00 %" ) & " du prix de revient des immeubles détenus directement", "" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 7858f383-92fa-47f0-9a91-b8a6138cd5e3

	/// citation
	measure 'Fiche categorie texte' = VAR c = IF ( HASONEVALUE ( v_obligation_par_categorie[categorie_ref] ), SELECTEDVALUE ( v_obligation_par_categorie[categorie_ref] ), IF ( HASONEVALUE ( ref_obligation_distribution[categorie] ), SELECTEDVALUE ( ref_obligation_distribution[categorie] ) ) ) VAR une = NOT ISBLANK ( c ) RETURN IF ( une, CALCULATE ( MAX ( ref_obligation_distribution[citation] ), FILTER ( ALL ( ref_obligation_distribution ), ref_obligation_distribution[categorie] = c ) ), "" ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: d851ba17-b532-4073-989e-31ee2f1068ca

