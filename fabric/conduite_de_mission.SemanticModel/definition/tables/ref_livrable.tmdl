	partition ref_livrable = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_ref_livrable = Value.NativeQuery(Source, "SELECT code, libelle, nature, applicable, article, ordre, formats, produit_etape_6, CAST(REPLACE(CASE WHEN CHARINDEX(N' : ', libelle) > 0 THEN LEFT(libelle, CHARINDEX(N' : ', libelle) - 1) ELSE libelle END, N'''', N'’') AS NVARCHAR (200)) AS nom, CAST(CASE WHEN code = 'DIP' THEN N'DIP' ELSE REPLACE(CASE WHEN CHARINDEX(N' : ', libelle) > 0 THEN LEFT(libelle, CHARINDEX(N' : ', libelle) - 1) ELSE libelle END, N'''', N'’') END AS NVARCHAR (200)) AS court FROM dbo.ref_livrable", null, [EnableFolding = true])
				in
				    dbo_ref_livrable

