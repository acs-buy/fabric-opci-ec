/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table v_ecran_maintiens
	lineageTag: 743e0174-66be-432a-ad0f-94b9366b862d

	measure 'Fond statut maintien' = VAR s = SELECTEDVALUE ( v_ecran_maintiens[statut_code] ) RETURN SWITCH ( s, "APPROUVE", "#EFF6F2", "REFUSE", "#F9ECEC", "A_FAIRE", "#FAF2E2", "#FAF2E2" )
		displayFolder: Ecran 1 Client
		lineageTag: 1463f65a-02ab-4091-b678-29a06b3c7a94

	measure 'Maintiens du client' = VAR c = [Client selectionne] RETURN CALCULATE ( COUNTROWS ( v_ecran_maintiens ), FILTER ( ALL ( v_ecran_maintiens ), v_ecran_maintiens[entite] = c && v_ecran_maintiens[a_faire] = FALSE () ) ) + 0
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: cc8e4613-6ede-47af-842a-b0891e4718a6

	measure 'Texte statut maintien' = VAR s = SELECTEDVALUE ( v_ecran_maintiens[statut_code] ) RETURN SWITCH ( s, "APPROUVE", "#1F6D4A", "REFUSE", "#9A2A2A", "#8A6710" )
		displayFolder: Ecran 1 Client
		lineageTag: 4d366a57-ea4d-46ef-a494-2141eebbb179

	measure 'Est maintien du client courant' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( v_ecran_maintiens ) ) RETURN IF ( SELECTEDVALUE ( v_ecran_maintiens[entite] ) = c, 1 )
		formatString: 0
		displayFolder: Ecran 1 Client
		lineageTag: f80b979b-6931-4da9-9ed3-7facb6625ab3

	measure 'Maintien selectionne' = SELECTEDVALUE ( v_ecran_maintiens[exercice] )
		displayFolder: Ecran 1 Client
		lineageTag: 72522f45-4966-41d0-bc8a-bc23c9d5d7c9

