/// Syntheses de l actif net proposees au visa.
table synthese_proposee
	lineageTag: f84d0e1d-6075-4759-a523-06ec289082ab

	/// la synthèse non périmée est visée (v_journal_visa, nature SYNTHESE)
	measure 'Valorisation etape 5 faite' = VAR s = CALCULATE ( MAX ( synthese_proposee[propose_le] ), ISBLANK ( synthese_proposee[perime_le] ) ) VAR v = CALCULATE ( MAX ( v_ecran_visas_valorisation[decide_le] ), v_ecran_visas_valorisation[nature] = "SYNTHESE", v_ecran_visas_valorisation[decision] = "VISE" ) VAR r = CALCULATE ( MAX ( v_ecran_visas_valorisation[decide_le] ), v_ecran_visas_valorisation[nature] = "SYNTHESE", v_ecran_visas_valorisation[decision] = "RENVOYE" ) RETURN IF ( NOT ISBLANK ( s ) && NOT ISBLANK ( v ) && v >= s && ( ISBLANK ( r ) || r < v ), 1, 0 )
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 8847bc14-4301-4753-aad2-91061844e3c2

	/// idem, étape 5
	measure 'Fond valorisation etape 5' = IF ( [Valorisation etape 5 faite] = 1, "#1F6D4A", "#D5DCE4" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: e91b1038-2cb3-46cb-98fe-08d58b140cde

	/// l’entité quand une synthèse non périmée attend son visa, vide sinon
	measure 'Synthese a viser' = VAR s = CALCULATE ( MAX ( synthese_proposee[propose_le] ), ISBLANK ( synthese_proposee[perime_le] ) ) VAR last = CALCULATE ( MAX ( v_ecran_visas_valorisation[decide_le] ), v_ecran_visas_valorisation[nature] = "SYNTHESE" ) RETURN IF ( NOT ISBLANK ( s ) && ( ISBLANK ( last ) || last < s ), [Client selectionne] )
		displayFolder: Ecran 3 Valorisation
		lineageTag: a8c51a81-59cb-43f5-900c-b1ed900309e5

	/// gris quand [Synthese a viser] ou A2 [Superviseur connecte SYNTHESE] est vide
	measure 'Fond viser la synthese' = IF ( ISBLANK ( [Synthese a viser] ) || ISBLANK ( [Superviseur connecte SYNTHESE] ), "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 740cbd60-c503-4d53-8fae-e52e90bf3d85

	/// « Aucune synthèse proposée pour cet arrêté » ; vide sinon
	measure 'Absence de synthese' = IF ( ISBLANK ( CALCULATE ( MAX ( synthese_proposee[propose_le] ), ISBLANK ( synthese_proposee[perime_le] ) ) ), "Aucune synthèse proposée pour cet arrêté" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 554bd335-d6c6-45c5-82d9-34fb67c8e414

	/// « visa réservé au chef de mission » quand A2 [Superviseur connecte SYNTHESE] est vide ; « aucune synthèse proposée » ; joints par « · » ; « conditions réunies » sinon
	measure 'Blocage visa de la synthese' = VAR p1 = IF ( ISBLANK ( [Superviseur connecte SYNTHESE] ), "visa réservé au chef de mission" ) VAR j1 = p1 VAR p2 = IF ( ISBLANK ( [Synthese a viser] ), VAR dv = CALCULATE ( MAX ( v_ecran_visas_valorisation[decide_le] ), v_ecran_visas_valorisation[nature] = "SYNTHESE", v_ecran_visas_valorisation[decision] = "VISE" ) RETURN IF ( [Valorisation etape 5 faite] = 1 && NOT ISBLANK ( dv ), "synthèse visée le " & FORMAT ( dv, "dd/MM/yyyy" ), "aucune synthèse proposée" ) ) VAR j2 = IF ( j1 <> "" && p2 <> "", j1 & " · " & p2, j1 & p2 ) RETURN IF ( j2 = "", "conditions réunies", j2 )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 3763823b-2d26-499e-b371-3839f4f683f0

