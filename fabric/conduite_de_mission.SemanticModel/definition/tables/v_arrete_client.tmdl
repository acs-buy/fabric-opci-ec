/// La porte du rapport client : les arretes dont le dernier visa de cloture est VISE.
table v_arrete_client
	lineageTag: 6a5f750f-50c1-44c8-aaf5-650e52500be8

	measure 'Porte du client' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_arrete_client ), v_arrete_client[entite] = e ) RETURN IF ( ISBLANK ( e ), BLANK (), IF ( COUNTROWS ( t ) > 0, CONCATENATEX ( t, MID ( v_arrete_client[arrete], 9, 2 ) & "/" & MID ( v_arrete_client[arrete], 6, 2 ) & "/" & LEFT ( v_arrete_client[arrete], 4 ), ", ", v_arrete_client[arrete], ASC ), "aucun arrêté" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: e7e82367-a6f7-400c-8c1e-2e6b1b107e58

	measure 'Aff Porte du client' = [Porte du client] & ""
		lineageTag: 193d33f3-8754-4456-b02b-58ef704c2df5

