	measure 'Cote du cycle' = CALCULATE ( MAX ( v_questions_programme[cote] ) )

	measure 'Reference selectionnee' = IF ( HASONEVALUE ( v_questions_programme[Réf.] ), SELECTEDVALUE ( v_questions_programme[Réf.] ) )

	measure 'Enonce selectionne' = IF ( HASONEVALUE ( v_questions_programme[Réf.] ), SELECTEDVALUE ( v_questions_programme[Question] ) )

