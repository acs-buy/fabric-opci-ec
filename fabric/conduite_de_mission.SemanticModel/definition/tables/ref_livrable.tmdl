	measure 'Sous-titre des livrables de l arrete' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR typ = MAXX ( FILTER ( ALL ( ref_arrete ), ref_arrete[entite] = e && ref_arrete[Arrêté] = a ), ref_arrete[Type] ) VAR nl = COUNTROWS ( FILTER ( ALL ( ref_livrable ), ref_livrable[produit_etape_6] = TRUE () ) ) + 0 VAR p6 = SELECTCOLUMNS ( FILTER ( ALL ( ref_livrable ), ref_livrable[produit_etape_6] = TRUE () ), "c", ref_livrable[code] ) VAR td6 = FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a ) VAR nds = COUNTROWS ( FILTER ( td6, v_livrables_dus[livrable] IN p6 ) ) + 0 VAR hors = CONCATENATEX ( FILTER ( td6, NOT ( v_livrables_dus[livrable] IN p6 ) && v_livrables_dus[livrable] <> "INVENTAIRE" ), SWITCH ( v_livrables_dus[livrable], "RAPPORT_ANNUEL", "rapport annuel", "DISTRIBUTION", "distribution", LOWER ( v_livrables_dus[libelle] ) ), ", ", v_livrables_dus[ordre], ASC ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), FORMAT ( nl, "0" ) & " livrables, " & FORMAT ( nds, "0" ) & IF ( nds > 1, " dus", " dû" ) & " à l’arrêté " & LOWER ( typ ) & IF ( hors <> "", " ; dus aussi, hors de l’étape : " & hors, "" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 08310b32-0f73-46d1-8740-ac3ce4c6530f

	measure 'Carte livrables' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = ADDCOLUMNS ( FILTER ( ALL ( ref_livrable ), ref_livrable[produit_etape_6] = TRUE () ), "et", CALCULATE ( [Etat du livrable] ) ) VAR nd = COUNTROWS ( FILTER ( t, [et] <> "sans objet" ) ) + 0 VAR np = COUNTROWS ( FILTER ( t, [et] = "produit" ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), FORMAT ( np, "0" ) & " / " & FORMAT ( nd, "0" ) )
