	measure 'Encre du deroulant de la cellule' = VAR n = CALCULATE ( COUNTROWS ( CALCULATETABLE ( VALUES ( v_annexe_cellule[cellule] ), FILTER ( v_annexe_cellule, v_annexe_cellule[nature] IN { "texte", "source" } || v_annexe_cellule[etat] = "A_REMPLIR" ) ) ), REMOVEFILTERS ( v_annexe_cellule[cellule] ) ) + 0 RETURN IF ( n <= 1, "#FFFFFF00", "#12233C" )
