	measure 'Message ecran' = VAR u = USERPRINCIPALNAME () VAR c = [Client selectionne] VAR t = TOPN ( 1, FILTER ( ALL ( v_ecran_message ), v_ecran_message[pour] = u && ( v_ecran_message[entite] = c || v_ecran_message[entite] = "-" ) && v_ecran_message[il_y_a_minutes] <= 30 ), v_ecran_message[pose_le], DESC ) VAR m = MAXX ( t, v_ecran_message[message] ) VAR g = MAXX ( t, v_ecran_message[geste] ) RETURN IF ( ISBLANK ( m ), BLANK (), m & IF ( ISBLANK ( g ), "", "  ·  " & g ) )

	measure 'Fond message ecran' = VAR u = USERPRINCIPALNAME () VAR c = [Client selectionne] VAR t = TOPN ( 1, FILTER ( ALL ( v_ecran_message ), v_ecran_message[pour] = u && ( v_ecran_message[entite] = c || v_ecran_message[entite] = "-" ) && v_ecran_message[il_y_a_minutes] <= 30 ), v_ecran_message[pose_le], DESC ) VAR gr = MAXX ( t, v_ecran_message[genre] ) RETURN SWITCH ( gr, "REFUS", "#F9ECEC", "SUCCES", "#EFF6F2", "#FFFFFF" )

	measure 'Message de la revision' = VAR u = USERPRINCIPALNAME () VAR e = [Entite selectionnee] VAR t = TOPN ( 1, FILTER ( ALL ( v_ecran_message ), v_ecran_message[pour] = u && ( v_ecran_message[entite] = e || v_ecran_message[entite] = "-" ) && v_ecran_message[il_y_a_minutes] <= 30 ), v_ecran_message[pose_le], DESC ) VAR m = MAXX ( t, v_ecran_message[message] ) VAR g = MAXX ( t, v_ecran_message[geste] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( m ), "", m & IF ( ISBLANK ( g ), "", "  ·  " & g ) )
