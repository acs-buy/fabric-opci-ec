/// Par article de l'annexe, a la derniere version de l'arrete : les cellules a remplir, en attente et etablies, et la lecture de l'article.
table v_cellules_a_remplir
	lineageTag: 5d0cede6-a717-4dd0-96c0-a80d3b6f988c

	measure 'Carte annexe' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR duc = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = "COMPTES_ANNUELS" ) ) > 0 VAR rem = MAXX ( FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ), v_annexe_produisible[cellules_a_remplir] ) + 0 VAR tot = SUMX ( FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a ), v_cellules_a_remplir[cellules] ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( duc, FORMAT ( rem, "0" ) & " / " & FORMAT ( tot, "0" ), "Sans objet" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 45c4eee1-ca8d-4972-941d-406bd8d23802

	measure 'Carte annexe sous-titre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR typ = MAXX ( FILTER ( ALL ( ref_arrete ), ref_arrete[entite] = e && ref_arrete[Arrêté] = a ), ref_arrete[Type] ) VAR duc = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = "COMPTES_ANNUELS" ) ) > 0 VAR tp = FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ) VAR att = MAXX ( tp, v_annexe_produisible[en_attente] ) + 0 VAR cv = MAXX ( tp, v_annexe_produisible[cases_vides] ) VAR pr = MAXX ( tp, IF ( v_annexe_produisible[produisible], 1, 0 ) ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( duc, IF ( ISBLANK ( cv ), "annexe jamais calculée", IF ( pr = 0, "tableau 333-3 non rapproché du bilan", FORMAT ( att, "0" ) & " en attente, " & FORMAT ( cv, "0" ) & IF ( cv > 1, " cases vides dans le Word", " case vide dans le Word" ) ) ), "comptes annuels non dus à l’arrêté " & LOWER ( typ ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 45dc2d61-458a-4e57-ae3d-b57a02bdc199

	measure 'Carte annexe encre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR duc = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = "COMPTES_ANNUELS" ) ) > 0 VAR tp = FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ) VAR rem = MAXX ( tp, v_annexe_produisible[cellules_a_remplir] ) + 0 VAR att = MAXX ( tp, v_annexe_produisible[en_attente] ) + 0 VAR pr = MAXX ( tp, IF ( v_annexe_produisible[produisible], 1, 0 ) ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || NOT duc, "#12233C", IF ( NOT ISBLANK ( pr ) && pr = 0, "#9A2A2A", IF ( rem + att > 0, "#8A6710", "#1F6D4A" ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 43d1f373-60b0-4479-ab37-0ad238a0f2e1

	measure 'Aff Carte annexe' = [Carte annexe] & ""
		lineageTag: b6af6efb-2843-4def-b4d3-177576391d16

	measure 'Aff Carte annexe sous-titre' = [Carte annexe sous-titre] & ""
		lineageTag: 2869fd64-4e02-427d-987f-46429db43af1

	measure 'Filet Carte annexe' = VAR c = [Carte annexe encre] RETURN SWITCH ( c, "#8A6710", "#C8961E", "#9A2A2A", "#9A2A2A", "#1F6D4A", "#1F6D4A", "#0F5C8C" )
		lineageTag: c2d7afd4-e9b2-4d98-ba4f-7d29d0dec3b3

	measure 'Lignes a remplir du menu' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR arts = VALUES ( v_cellules_a_remplir[article] ) VAR n = SUMX ( FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a && v_cellules_a_remplir[article] IN arts ), v_cellules_a_remplir[cellules_a_remplir] ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || n = 0, "", FORMAT ( n, "0" ) & IF ( n > 1, " cellules à remplir", " cellule à remplir" ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: f416b606-5adb-4681-aa2d-26ac3bcad7bf

