		lineageTag: fa0e161c-ae1e-4a03-b678-a2ec415e119c

	measure 'Saisie de l annexe fermee' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR u = USERPRINCIPALNAME () VAR j = TODAY () VAR ae = COUNTROWS ( FILTER ( ALL ( v_arrete_etat ), v_arrete_etat[entite] = e && v_arrete_etat[arrete] = a ) ) + 0 VAR sa = COUNTROWS ( FILTER ( ALL ( role_mission ), role_mission[entite] = e && ( role_mission[connexion] = u || role_mission[personne] = u ) && role_mission[du] <= j && ( ISBLANK ( role_mission[au] ) || role_mission[au] > j ) && role_mission[role] IN { "ASSOCIE", "CHEF_MISSION", "PREPARATEUR", "REVISEUR" } ) ) + 0 VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), ae = 0, "saisie fermée : l’arrêté n’a pas d’annexe", sa = 0, "saisie fermée : aucun rôle de mission sur cette entité", cl = "VISE", "saisie fermée : arrêté validé pour le client", BLANK () ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 9bca965f-74fa-415a-a04b-9cb581fa1bfb

