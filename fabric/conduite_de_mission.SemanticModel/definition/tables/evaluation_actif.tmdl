/// Valeurs retenues par actif, entite detentrice et arrete. Aucune relation a ref_entite : l entite est la detentrice, filiale comprise.
table evaluation_actif
	lineageTag: 75778cc8-6bc0-410e-be78-6c50558e8c41

	/// l’id de la valeur choisie quand elle est PROPOSE, vide sinon ; paramètre objetRef, couche fonctionnelle du gris
	measure 'Evaluation a viser' = VAR c = [Evaluation choisie] VAR e = IF ( c <> "", CALCULATE ( MAX ( evaluation_actif[etat] ), FILTER ( ALL ( evaluation_actif ), evaluation_actif[id] = VALUE ( c ) ) ) ) RETURN IF ( e = "PROPOSE", c )
		displayFolder: Ecran 3 Valorisation
		lineageTag: cbe88a41-e0f0-4420-b9ef-7e771a7d73c8

	/// gris quand [Evaluation a viser] ou A1 [Superviseur connecte EVALUATION] est vide
	measure 'Fond viser la valeur' = IF ( ISBLANK ( [Evaluation a viser] ) || ISBLANK ( [Superviseur connecte EVALUATION] ), "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 7b13c4bd-342e-49d9-9d28-d48d537d75a0

	/// valeur_retenue de la ligne de evaluation_actif de l’actif choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) ; vide sans ligne choisie
	measure 'Montant de la valeur retenue' = FORMAT ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( SUM ( evaluation_actif[valeur_retenue] ), t ) ), "#,0.00" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 2100654d-a444-46f4-9d02-d2d08b67dc4f

	/// source de la ligne de evaluation_actif de l’actif choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ), puis LOOKUPVALUE ( ref_source_valeur[libelle], ref_source_valeur[source], source ) ; vide sans ligne choisie
	measure 'Source de la valeur retenue' = ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), LOOKUPVALUE ( ref_source_valeur[libelle], ref_source_valeur[source], CALCULATE ( MAX ( evaluation_actif[source] ), t ) ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 9faaf5b0-a6ed-4dc1-bc05-76df4d96fb85

	/// propose_par de la ligne de evaluation_actif de l’actif choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) ; vide sans ligne choisie
	measure 'Proposee par de la valeur retenue' = ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( evaluation_actif[propose_par] ), t ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 27b96eb5-3447-48c9-b66d-01205a43ed1b

	/// propose_le de la ligne de evaluation_actif de l’actif choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) ; vide sans ligne choisie
	measure 'Proposee le de la valeur retenue' = FORMAT ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( evaluation_actif[propose_le] ), t ) ), "dd/MM/yyyy" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: d41526c3-dcfc-434e-bb0e-c3deab2fcff7

	/// motif_ecart de la ligne de evaluation_actif de l’actif choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) ; vide sans ligne choisie
	measure 'Motif de l ecart de la valeur retenue' = ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( evaluation_actif[motif_ecart] ), t ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: b586c715-a349-42b6-bdd8-7fc4564c736d

	/// motif_renvoi de la ligne de evaluation_actif de l’actif choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) ; vide sans ligne choisie
	measure 'Motif du renvoi de la valeur retenue' = ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( evaluation_actif[motif_renvoi] ), t ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: bed07eba-03c4-48f7-aee1-c47e61ae9266

	/// « Aucun actif choisi » ; « aucune proposition : la valeur actuelle est celle de l’expertise » ; vide quand une valeur est proposée
	measure 'Absence de valeur retenue de l actif' = IF ( ISBLANK ( [Actif choisi] ), "Aucun actif choisi", IF ( [Montant de la valeur retenue] = "", "aucune proposition : la valeur actuelle est celle de l’expertise" ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: a58213a1-e987-4a32-86e6-404466b1b1b9

	/// « renvoyée par x le jj/mm/aaaa », « visée par x le jj/mm/aaaa », « proposée, en attente du visa »
	measure 'Etat de la valeur retenue' = VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) VAR e = CALCULATE ( MAX ( evaluation_actif[etat] ), t ) VAR p = CALCULATE ( MAX ( evaluation_actif[vise_par] ), t ) VAR d = CALCULATE ( MAX ( evaluation_actif[vise_le] ), t ) RETURN SWITCH ( e, "RENVOYE", "renvoyée par " & p & " le " & FORMAT ( d, "dd/MM/yyyy" ), "VISE", "visée par " & p & " le " & FORMAT ( d, "dd/MM/yyyy" ), "PROPOSE", "proposée, en attente du visa" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: a3e73e1a-79ef-40f5-9f20-dc0317131fb0

	/// « montant, renvoyée par x, le jj/mm/aaaa », « montant, visée … », « montant, proposée … » ; « aucune »
	measure 'Valeur retenue et son etat' = VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) VAR m = CALCULATE ( SUM ( evaluation_actif[valeur_retenue] ), t ) VAR e = CALCULATE ( MAX ( evaluation_actif[etat] ), t ) VAR vp = CALCULATE ( MAX ( evaluation_actif[vise_par] ), t ) VAR vl = CALCULATE ( MAX ( evaluation_actif[vise_le] ), t ) VAR pp = CALCULATE ( MAX ( evaluation_actif[propose_par] ), t ) VAR pl = CALCULATE ( MAX ( evaluation_actif[propose_le] ), t ) RETURN IF ( ISBLANK ( m ), "aucune", FORMAT ( m, "#,0.00" ) & ", " & SWITCH ( e, "RENVOYE", "renvoyée par " & vp & ", le " & FORMAT ( vl, "dd/MM/yyyy" ), "VISE", "visée par " & vp & ", le " & FORMAT ( vl, "dd/MM/yyyy" ), "proposée par " & pp & ", le " & FORMAT ( pl, "dd/MM/yyyy" ) ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 78141f60-7b18-43c6-8773-8780bfc5b630

	/// « visa réservé au chef de mission » quand A1 [Superviseur connecte EVALUATION] est vide ; « aucune valeur retenue choisie », « aucune valeur proposée sur cet actif », « valeur renvoyée le jj/mm/aaaa », « valeur visée le jj/mm/aaaa » ; joints par « · » ; « conditions réunies » sinon
	measure 'Blocage du visa de la valeur' = VAR c = [Actif choisi] VAR t = FILTER ( ALL ( evaluation_actif[code_actif] ), evaluation_actif[code_actif] = c ) VAR e = CALCULATE ( MAX ( evaluation_actif[etat] ), t ) VAR vl = CALCULATE ( MAX ( evaluation_actif[vise_le] ), t ) VAR p1 = IF ( ISBLANK ( [Superviseur connecte EVALUATION] ), "visa réservé au chef de mission" ) VAR j1 = p1 VAR p2 = IF ( ISBLANK ( c ), "aucune valeur retenue choisie", IF ( ISBLANK ( e ), "aucune valeur proposée sur cet actif" ) ) VAR j2 = IF ( j1 <> "" && p2 <> "", j1 & " · " & p2, j1 & p2 ) VAR p3 = SWITCH ( e, "RENVOYE", "valeur renvoyée le " & FORMAT ( vl, "dd/MM/yyyy" ), "VISE", "valeur visée le " & FORMAT ( vl, "dd/MM/yyyy" ) ) VAR j3 = IF ( j2 <> "" && p3 <> "", j2 & " · " & p3, j2 & p3 ) RETURN IF ( j3 = "", "conditions réunies", j3 )
		displayFolder: Ecran 3 Valorisation
		lineageTag: fcc9c119-44a8-4879-9114-849cde0fc8eb

