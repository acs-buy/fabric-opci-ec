/// Etape 5 : une ligne par vehicule et arrete de mission, conclusion generale et verrou.
table v_etat_revue
	lineageTag: b2470f63-dea8-4459-b3e8-601bd396036c

	measure 'Ref revue a viser' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR u = USERPRINCIPALNAME () VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) VAR b = MAXX ( t, v_etat_revue[blocage_visa] ) VAR auteur = MAXX ( t, v_etat_revue[conclu_par] ) VAR s = [Superviseur connecte REVUE] RETURN IF ( COUNTROWS ( t ) = 1 && ISBLANK ( b ) && auteur <> u && NOT ISBLANK ( s ), e & "|" & a )
		displayFolder: Ecran 2 etape 5
		lineageTag: 1cec6508-48c2-473a-afd4-57b22a17d413

	measure 'Ref revue a renvoyer' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR u = USERPRINCIPALNAME () VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) VAR v = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), IF ( v_revision_indicateurs[verrouille], 1, 0 ) ) VAR et = MAXX ( t, v_etat_revue[etat] ) VAR auteur = MAXX ( t, v_etat_revue[conclu_par] ) VAR s = [Superviseur connecte REVUE] RETURN IF ( COUNTROWS ( t ) = 1 && et = "CONCLUE" && v <> 1 && auteur <> u && NOT ISBLANK ( s ), e & "|" & a )
		displayFolder: Ecran 2 etape 5
		lineageTag: f170f34a-f7ef-4609-97a0-0d55f52253c3

	measure 'Perimetre couvert' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) VAR n = MAXX ( t, v_etat_revue[perimetre_entites] ) + 0 VAR p = MAXX ( t, v_etat_revue[perimetre] ) VAR f = n - 1 VAR fil = IF ( f > 0, MID ( p, LEN ( e ) + 3, 4000 ) ) RETURN IF ( COUNTROWS ( t ) <> 1, BLANK (), "Périmètre couvert : " & FORMAT ( n, "0" ) & IF ( n > 1, " entités", " entité" ) & ", le véhicule " & e & SWITCH ( TRUE (), f <= 0, ", sans filiale", f = 1, " et sa filiale · " & fil, " et ses " & FORMAT ( f, "0" ) & " filiales · " & fil ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: 53f31100-b5eb-4412-b5d4-1b344a4e5410

	measure 'Etat de la revue' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) VAR cp = MAXX ( t, v_etat_revue[conclu_par] ) VAR cl = MAXX ( t, v_etat_revue[conclu_le] ) VAR dd = MAXX ( t, v_etat_revue[derniere_decision] ) VAR dp = MAXX ( t, v_etat_revue[decide_par] ) VAR dl = MAXX ( t, v_etat_revue[decide_le] ) VAR vr = MAXX ( t, IF ( v_etat_revue[verrouille], 1, 0 ) ) VAR vp = MAXX ( t, v_etat_revue[verrouille_par] ) VAR vl = MAXX ( t, v_etat_revue[verrouille_le] ) VAR dvp = MAXX ( t, v_etat_revue[dernier_deverrouillage_par] ) VAR dvl = MAXX ( t, v_etat_revue[dernier_deverrouillage_le] ) VAR ncp = IF ( SEARCH ( "@", cp, 1, 0 ) > 1, LEFT ( cp, SEARCH ( "@", cp, 1, 0 ) - 1 ), cp ) VAR ndp = IF ( SEARCH ( "@", dp, 1, 0 ) > 1, LEFT ( dp, SEARCH ( "@", dp, 1, 0 ) - 1 ), dp ) VAR nvp = IF ( SEARCH ( "@", vp, 1, 0 ) > 1, LEFT ( vp, SEARCH ( "@", vp, 1, 0 ) - 1 ), vp ) VAR ndvp = IF ( SEARCH ( "@", dvp, 1, 0 ) > 1, LEFT ( dvp, SEARCH ( "@", dvp, 1, 0 ) - 1 ), dvp ) VAR lc = IF ( ISBLANK ( cl ), "aucune enregistrée", "enregistrée par " & ncp & ", le " & FORMAT ( cl, "dd/MM/yyyy" ) ) VAR lv = SWITCH ( dd, "VISE", "visée par " & ndp & ", le " & FORMAT ( dl, "dd/MM/yyyy" ), "RENVOYE", "renvoyée par " & ndp & ", le " & FORMAT ( dl, "dd/MM/yyyy" ), "aucune décision" ) VAR lk = IF ( vr = 1, "verrouillé par " & nvp & ", le " & FORMAT ( vl, "dd/MM/yyyy" ), IF ( NOT ISBLANK ( dvl ), "déverrouillé par " & ndvp & ", le " & FORMAT ( dvl, "dd/MM/yyyy" ), "non verrouillé" ) ) RETURN IF ( COUNTROWS ( t ) <> 1, BLANK (), "Conclusion générale : " & lc & " · Visa de la revue : " & lv & " · Dossier de travail : " & lk )
		displayFolder: Ecran 2 etape 5
		lineageTag: 38703657-6b8c-4bb8-a788-34e056885bc5

	measure 'Blocage du visa de la revue' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR u = USERPRINCIPALNAME () VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) VAR b = MAXX ( t, v_etat_revue[blocage_visa] ) VAR cp = MAXX ( t, v_etat_revue[conclu_par] ) VAR p2 = IF ( NOT ISBLANK ( cp ) && cp = u, "le connecté a conclu la revue" ) VAR roles = CALCULATE ( CONCATENATEX ( VALUES ( role_nature_visa[role_code] ), role_nature_visa[role_code], ", ", role_nature_visa[role_code], ASC ), role_nature_visa[nature] = "REVUE" ) VAR p3 = IF ( ISBLANK ( [Superviseur connecte REVUE] ), IF ( roles = "CHEF_MISSION", "visa réservé au chef de mission", "visa réservé aux rôles " & roles ) ) VAR l = b & IF ( NOT ISBLANK ( b ) && NOT ISBLANK ( p2 ), " ; " ) & p2 & IF ( ( NOT ISBLANK ( b ) || NOT ISBLANK ( p2 ) ) && NOT ISBLANK ( p3 ), " ; " ) & p3 RETURN IF ( COUNTROWS ( t ) <> 1, BLANK (), IF ( l = "", "possible", l ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: e82b1f79-2256-4203-963b-9c1c5a24b805

	measure 'Fond revCclRevueViser' = IF ( ISBLANK ( [Ref revue a viser] ) || ISBLANK ( [Superviseur connecte REVUE] ), "#D9DFE6", "#0F5C8C" )
		lineageTag: 7a8f22cc-821d-40b0-b1b9-18b798951977

	measure 'Fond revCclRevueRenvoyer' = IF ( ISBLANK ( [Ref revue a renvoyer] ) || ISBLANK ( [Superviseur connecte REVUE] ), "#D9DFE6", "#FFFFFF" )
		lineageTag: 32763ddf-8830-4669-9095-d94624aae63f

	measure 'Sous-titre de la revue' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), e & " au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) )
		lineageTag: b91bea25-6d7b-43cf-83e1-b88b0830fc43

	measure 'Conclusion générale enregistrée' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) RETURN IF ( COUNTROWS ( t ) = 1, MAXX ( t, v_etat_revue[conclusion] ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: 61b75f18-e40e-4fe8-8660-10243e720752

	measure 'Motif du renvoi de la revue' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) RETURN IF ( COUNTROWS ( t ) = 1, MAXX ( t, v_etat_revue[motif_renvoi] ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: 0a49d497-8dbd-4b8b-b013-c71fd3fc564c

	measure 'Entite de la revue a conclure' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a ) VAR v = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), IF ( v_revision_indicateurs[verrouille], 1, 0 ) ) VAR et = MAXX ( t, v_etat_revue[etat] ) RETURN IF ( COUNTROWS ( t ) = 1 && v <> 1 && et <> "VISEE", e )
		displayFolder: Ecran 2 etape 5
		lineageTag: af19bcea-811a-4e82-84aa-c236914c1e6e

	measure 'Fond revCclRevueEnregistrer' = IF ( ISBLANK ( [Entite de la revue a conclure] ), "#D9DFE6", "#0F5C8C" )
		lineageTag: 5e2b5370-c63e-409d-8eae-af9e137b96b4

	measure 'Libelle revCclRevueEnregistrer' = "Enregistrer la conclusion générale"
		lineageTag: eaeb5844-18cf-4d5f-b0eb-39cce6861d86

	measure 'Libelle revCclRevueViser' = "Viser la revue"
		lineageTag: 3d9f63fa-358c-4c21-b0a2-f83442681dba

	measure 'Libelle revCclRevueRenvoyer' = "Renvoyer la revue"
		lineageTag: 21e8c4fc-f5ca-4e66-b256-2559b7bd8808

