/// Ecritures miroir a passer ou impossibles.
table v_ecran_miroirs_groupe
	lineageTag: 7c96e20d-f23c-490c-aa6b-1a8e90c456cd

	/// l’entité quand une écriture miroir possible reste à passer, vide sinon
	measure 'Entite si miroirs a passer' = VAR n = CALCULATE ( COUNTROWS ( v_ecran_miroirs_groupe ), v_ecran_miroirs_groupe[possible] = TRUE () ) + 0 RETURN IF ( n > 0, [Client selectionne] )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 8dcbf879-fddd-4bd8-957b-042ecbdeb72f

	/// gris quand rien n’est à passer
	measure 'Fond passer les miroirs' = IF ( ISBLANK ( [Entite si miroirs a passer] ), "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 67b3abbd-dcb3-4dee-bc61-9eb4c025a365

	/// lignes possible = 0 ; 0 sans ligne
	measure 'Miroirs impossibles' = CALCULATE ( COUNTROWS ( v_ecran_miroirs_groupe ), v_ecran_miroirs_groupe[possible] = FALSE () ) + 0
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: fb2b69ac-d6f2-4783-9c51-bcfc0d496dac

	/// « aucune écriture miroir à passer » ; « conditions réunies »
	measure 'Blocage des miroirs' = IF ( ISBLANK ( [Entite si miroirs a passer] ), "aucune écriture miroir à passer", "conditions réunies" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: fa6031c0-c308-40a4-8bde-55e17871d82d

