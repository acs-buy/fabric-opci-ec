/// Les publications du rapport client.
table publication_client
	lineageTag: f04eaa69-7af5-419e-a38e-3510eec30617

	measure 'Libelle publication de l arrete' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] RETURN IF ( ISBLANK ( a ), BLANK (), "Publication du " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 474e4727-9326-4592-b236-5c0e7a1343a5

	measure 'Publication de l arrete' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) VAR cll = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decide_le] ) VAR tp = FILTER ( ALL ( publication_client ), publication_client[entite] = e && publication_client[arrete] = a ) VAR idp = MAXX ( tp, publication_client[id] ) VAR tl = FILTER ( tp, publication_client[id] = idp ) VAR pet = MAXX ( tl, publication_client[etat] ) VAR pd = MAXX ( tl, publication_client[publiee_le] ) VAR pv = MAXX ( tl, publication_client[visa_id] ) VAR vd = MAXX ( FILTER ( ALL ( visa_cloture ), visa_cloture[id] = pv ), visa_cloture[decide_le] ) VAR apres = COUNTROWS ( FILTER ( ALL ( publication_client ), publication_client[entite] = e && publication_client[publiee_le] > cll ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( ISBLANK ( idp ), "aucune", IF ( pet <> "PUBLIEE", LOWER ( pet ) & " le " & FORMAT ( pd, "dd/MM/yyyy" ), "le " & FORMAT ( pd, "dd/MM/yyyy" ) & ", sur le visa du " & IF ( ISBLANK ( vd ), "", FORMAT ( vd, "dd/MM/yyyy" ) ) & IF ( ISBLANK ( cl ) || cl = "VISE" || apres > 0, "", " ; aucune depuis le renvoi du " & FORMAT ( cll, "dd/MM/yyyy" ) ) ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 9c437a3f-0781-4ebd-b863-85522bd12de0

	measure 'Aff Libelle publication de l arrete' = [Libelle publication de l arrete] & ""
		lineageTag: 6647bc2d-233e-4f5f-a194-b456c312c1c2

	measure 'Aff Publication de l arrete' = [Publication de l arrete] & ""
		lineageTag: f088d6da-684a-4d90-b464-0ac2a56ea1d6

	measure 'Publication de l arrete ligne 1' = VAR t = [Publication de l arrete] & "" VAR k = SEARCH ( " ; ", t, 1, 0 ) RETURN IF ( k > 0, LEFT ( t, k - 1 ), t )
		lineageTag: d766bc4d-5cc2-4e6e-9527-d022324a676d

	measure 'Publication de l arrete ligne 2' = VAR t = [Publication de l arrete] & "" VAR k = SEARCH ( " ; ", t, 1, 0 ) RETURN IF ( k > 0, MID ( t, k + 3, 200 ), "" )
		lineageTag: 8fbd966a-de75-42b3-abac-e3ca22e32469

