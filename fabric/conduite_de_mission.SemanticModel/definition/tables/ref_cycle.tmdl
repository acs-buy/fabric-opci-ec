		isNullable: false
		sourceProviderType: nvarchar(200)
		lineageTag: 6062d3ec-91c1-4610-9acb-dc0134ca2988
		summarizeBy: none
		sourceColumn: libelle

		annotation SummarizationSetBy = Automatic

	column applicabilite
		dataType: string
		isNullable: false
		sourceProviderType: varchar(20)
		lineageTag: a8d205b1-14d2-4577-b59a-9f67d1ce7415
		summarizeBy: none
		sourceColumn: applicabilite

		annotation SummarizationSetBy = Automatic

	column ordre
