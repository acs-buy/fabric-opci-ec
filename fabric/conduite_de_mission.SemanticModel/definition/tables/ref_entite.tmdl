	measure 'Est un client' = IF ( ISINSCOPE ( liste_clients[Entité] ), IF ( SELECTEDVALUE ( liste_clients[est_vehicule] ) = TRUE (), "oui", "non" ), IF ( SELECTEDVALUE ( ref_entite[est_client] ) = TRUE (), "oui", "non" ) )
		displayFolder: Ecran 1 Client
