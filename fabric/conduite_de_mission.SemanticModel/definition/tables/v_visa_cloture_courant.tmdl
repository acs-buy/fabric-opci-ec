	measure 'Pied comptes annuels' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Livrable : comptes annuels, bilan, compte de résultat et annexe · " & IF ( ISBLANK ( [Lecture comptes annuels produits] ), "non dû à cet arrêté", [Lecture comptes annuels produits] ) )
