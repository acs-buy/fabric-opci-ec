/// Le pilotage, societe par societe du groupe : tresorerie, emprunts, avances, loyers, charges, interets, resultat et rendement locatifs. Script 141.
table v_client_pilotage_societe
	lineageTag: 615ff5cb-ddbe-4375-b456-1796dbbe2184

	/// La tresorerie des societes du groupe, comptes 511.
	measure 'Tresorerie du groupe' = SUM ( v_client_pilotage_societe[Trésorerie] )
		formatString: #,0.00
		lineageTag: 9ceda9b0-96ee-4a83-ba11-7d986f879bb8

	measure 'Emprunts bancaires du groupe' = SUM ( v_client_pilotage_societe[Emprunt bancaire] )
		formatString: #,0.00
		lineageTag: 868240d3-5d0d-4527-a2bb-23423d4ff0c3

	measure 'Loyers de la periode' = SUM ( v_client_pilotage_societe[Loyers] )
		formatString: #,0.00
		lineageTag: 1cabb3e0-1d03-40a1-acc3-789342a35a04

	measure 'Charges d entretien' = SUM ( v_client_pilotage_societe[Charges d'entretien] )
		formatString: #,0.00
		lineageTag: 8cb9452d-cf9a-4379-b086-3ac33f39a532

	/// Loyers moins charges d'entretien moins interets d'emprunt.
	measure 'Resultat locatif net' = SUM ( v_client_pilotage_societe[Résultat locatif] )
		formatString: #,0.00
		lineageTag: 0774cc1d-8194-41b2-818e-74addbf3d056

	/// Loyers de la periode rapportes a la valeur actuelle des immeubles a l'arrete.
	measure 'Rendement locatif' = DIVIDE ( SUM ( v_client_pilotage_societe[Loyers] ), SUM ( v_client_pilotage_societe[Valeur actuelle des immeubles] ) )
		formatString: 0.00 %
		lineageTag: f75cd2a2-cc53-47eb-ad88-15c9ad4a2d16

	measure 'Avances en compte courant' = SUM ( v_client_pilotage_societe[Avances versées] )
		formatString: #,0.00
		lineageTag: 71d6d8ea-9d60-4b29-96df-de5f29f298c8

