/// Ce que l'accord d'une réouverture ferait sur l'arrêté, 8 lignes comptées en base.
table v_ecran_reouverture_effets
	lineageTag: b5ec1b88-6c6e-5f5f-a924-5fa2adf4a263

	/// 1 pour une ligne des effets de l'arrêté choisi : les 2 vues ne se filtrent pas l'une l'autre.
	measure 'Est effet de l arrete choisi' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( v_ecran_reouverture_effets ) ) VAR a = [Arrete choisi reouverture] RETURN IF ( NOT ISBLANK ( c ) && NOT ISBLANK ( a ) && NOT ISEMPTY ( FILTER ( v_ecran_reouverture_effets, v_ecran_reouverture_effets[entite] = c && v_ecran_reouverture_effets[arrete] = a ) ), 1 )
		formatString: 0
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 094dca4d-ec08-5db0-a331-ddde3932e73f

	/// Le fond de la cellule « Aujourd'hui » quand elle dit le statut de l'arrêté.
	measure 'Fond effet aujourd hui' = SWITCH ( SELECTEDVALUE ( v_ecran_reouverture_effets[Aujourd'hui] ), "Clos", "#EFF6F2", "Ouvert", "#EAF1F8" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: ecfd3110-0a24-552b-ad9c-e95e0bcb7aea

	/// L'encre de la cellule « Aujourd'hui » quand elle dit le statut de l'arrêté.
	measure 'Encre effet aujourd hui' = SWITCH ( SELECTEDVALUE ( v_ecran_reouverture_effets[Aujourd'hui] ), "Clos", "#1F6D4A", "Ouvert", "#0F5C8C", "#12233C" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 8276078c-f8b4-524d-93d4-61984a41d3ee

	/// Le fond de la cellule « Après la réouverture » quand elle dit le statut de l'arrêté.
	measure 'Fond effet apres reouverture' = SWITCH ( SELECTEDVALUE ( v_ecran_reouverture_effets[Après la réouverture] ), "Clos", "#EFF6F2", "Ouvert", "#EAF1F8" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: efe5493b-6dc8-5d79-bda5-f88f94eed423

	/// L'encre de la cellule « Après la réouverture » quand elle dit le statut de l'arrêté.
	measure 'Encre effet apres reouverture' = SWITCH ( SELECTEDVALUE ( v_ecran_reouverture_effets[Après la réouverture] ), "Clos", "#1F6D4A", "Ouvert", "#0F5C8C", "#12233C" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 69806710-98af-51dc-92d7-abfdecaa1548

