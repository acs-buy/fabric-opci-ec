/// Le patrimoine par famille : nombre d'actifs, valeur comptable, valeur actuelle, difference d'estimation, article. Script 141.
table v_client_patrimoine_famille
	lineageTag: d935394c-37ef-4bf0-bff0-11ebb7607ff4

	measure 'Total valeur actuelle' = SUM ( v_client_patrimoine_famille[Valeur actuelle] )
		formatString: #,0.00
		lineageTag: 0ed8a028-e837-4acd-844b-a27e9f0b62af

	measure 'Total valeur comptable' = SUM ( v_client_patrimoine_famille[Valeur comptable] )
		formatString: #,0.00
		lineageTag: 3ff8f4da-a5d7-458e-b9f5-3970d6e44bd7

	measure 'Total différence d''estimation' = SUM ( v_client_patrimoine_famille[Différence d'estimation] )
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: 7c7b961d-d4da-4051-8c85-c203ada85b64

	measure 'Total actifs' = SUM ( v_client_patrimoine_famille[Actifs] )
		formatString: #,0
		lineageTag: 18426790-7a82-4e66-b098-bcde8b64486f

	/// L'article du reglement qui fonde la methode de la famille, vide sur le total.
	measure Article = IF ( HASONEVALUE ( v_client_patrimoine_famille[Article du règlement] ), MAX ( v_client_patrimoine_famille[Article du règlement] ), BLANK () )
		lineageTag: 201b3200-74aa-4085-b3df-393c86915e9f

