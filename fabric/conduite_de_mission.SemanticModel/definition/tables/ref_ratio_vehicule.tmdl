/// Seuils propres a un vehicule. Lue par la seule mesure [Seuil propre au vehicule].
table ref_ratio_vehicule
	lineageTag: 82d0fc63-d478-4940-a049-7268aa6d3591

	/// le seuil propre du véhicule pour la limite cochée, à l'unité de la limite, suivi de « fixé par les statuts » ou « fixé par le gestionnaire » ; sans ligne, pour une limite retenue par le cabinet d'un OPCI professionnel, le seuil du calcul suivi de « , retenu par le cabinet » ; « à remplir » pour une limite qui reçoit un seuil propre pour ce véhicule, « aucun » ailleurs (décision D9 du 17/10/2026)
	measure 'Seuil propre au vehicule' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lt = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[limite_texte] ) ) VAR lignes = SELECTCOLUMNS ( ALL ( ref_ratio_vehicule ), "entite", ref_ratio_vehicule[entite], "code", ref_ratio_vehicule[code], "seuil", ref_ratio_vehicule[seuil], "source", ref_ratio_vehicule[source] ) VAR t2 = FILTER ( lignes, [entite] = e && [code] = c && ( [source] = "GESTIONNAIRE" || ( [source] = "STATUTS" && pro ) ) ) VAR s = MAXX ( t2, [seuil] ) VAR src = MAXX ( t2, [source] ) VAR taux = CONTAINSSTRING ( lt, "%" ) VAR sc = MAXX ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a && v_ratio_conclusion[code] = c ), v_ratio_conclusion[seuil] ) VAR defaut = IF ( ISBLANK ( sc ), SUBSTITUTE ( SUBSTITUTE ( lt, "max. ", "" ), "min. ", "" ), FORMAT ( sc * 100, "0.00" ) & " %" ) RETURN IF ( vide, BLANK (), IF ( NOT une, "", IF ( NOT ISBLANK ( s ), IF ( taux, FORMAT ( s * 100, "0.00" ) & " %", FORMAT ( s, "#,0.00" ) ) & ", " & IF ( src = "STATUTS", "fixé par les statuts", "fixé par le gestionnaire" ), IF ( pro && lsp = "RETENUE", defaut & ", retenu par le cabinet", IF ( c = "LEVIER_MAX" || ( pro && c = "EMPRUNT_ESPECES_10" ), "à remplir", "aucun" ) ) ) ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: b098f50b-c11f-4c59-af0a-eb886cbc0a51

