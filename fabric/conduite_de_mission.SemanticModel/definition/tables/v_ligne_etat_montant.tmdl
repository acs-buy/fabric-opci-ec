/// Les lignes du bilan et du compte de resultat, en N et en N-1, par vehicule et arrete.
table v_ligne_etat_montant
	lineageTag: 26e114c1-f5ea-4b53-bc8c-57f4fbea0368

	measure 'Titre du bilan' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR den = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), ref_entite[Dénomination] ) VAR de = IF ( CONTAINSSTRING ( "aeiouyhéèêàâîôûAEIOUYHÉÈÊÀÂÎÔÛ", LEFT ( den, 1 ) ), "de l’", "de " ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), "Bilan " & de & den & " au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 1d9927d0-c3a0-455c-a849-8d20d84e90d7

	measure 'Titre du compte de resultat' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR den = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), ref_entite[Dénomination] ) VAR de = IF ( CONTAINSSTRING ( "aeiouyhéèêàâîôûAEIOUYHÉÈÊÀÂÎÔÛ", LEFT ( den, 1 ) ), "de l’", "de " ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), "Compte de résultat " & de & den & " au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 178b0df7-d771-4c1e-bb35-fa28e7a5f401

	measure 'Aff Titre du bilan' = [Titre du bilan] & ""
		lineageTag: 0aeec228-369e-4447-8183-5e7156d07a93

	measure 'Aff Titre du compte de resultat' = [Titre du compte de resultat] & ""
		lineageTag: 03a1f7be-e3ee-469a-b6eb-131da31dceab

	measure 'Titre des comptes annuels' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR den = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), ref_entite[Dénomination] ) VAR de = IF ( CONTAINSSTRING ( "aeiouyhéèêàâîôûAEIOUYHÉÈÊÀÂÎÔÛ", LEFT ( den, 1 ) ), "de l’", "de " ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Comptes annuels " & de & den & " au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 45fad791-572c-405f-afe4-cd23e38536bf

	measure 'Titre du modele bilan actif' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR d = [Devise de l annexe] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Bilan au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) & IF ( ISBLANK ( d ) || d = "", "", IF ( d = "à remplir", ", devise à remplir", " en " & d ) ) & " - Actif" )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 21789481-00d9-45cc-8fe6-9d860472bd55

	measure 'Titre du modele bilan passif' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR d = [Devise de l annexe] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Bilan au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) & IF ( ISBLANK ( d ) || d = "", "", IF ( d = "à remplir", ", devise à remplir", " en " & d ) ) & " - Passif" )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 74ecc1f7-518d-4579-8833-c5cf0557896a

	measure 'Titre du modele compte de resultat' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR d = [Devise de l annexe] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Compte de résultat au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) & IF ( ISBLANK ( d ) || d = "", "", IF ( d = "à remplir", ", devise à remplir", " en " & d ) ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: ed40300f-6019-42d0-989d-17f6b9a07442

	measure 'Faits du bilan actif' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_ligne_etat_montant ), v_ligne_etat_montant[entite] = e && v_ligne_etat_montant[arrete] = a ) VAR n = COUNTROWS ( FILTER ( t, v_ligne_etat_montant[etat] = "BILAN_ACTIF" ) ) + 0 VAR ta = MAXX ( FILTER ( t, v_ligne_etat_montant[code] = "A_TOTAL" ), v_ligne_etat_montant[Exercice N] ) VAR tp = MAXX ( FILTER ( t, v_ligne_etat_montant[code] = "P_TOTAL" ), v_ligne_etat_montant[Exercice N] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || n = 0, "", FORMAT ( n, "0" ) & " lignes du modèle de l’article 321-2 ; total de l’actif : " & IF ( ISBLANK ( ta ), "à remplir", FORMAT ( ta, "#,##0.00" ) ) & IF ( ISBLANK ( ta ) || ISBLANK ( tp ), "", IF ( ROUND ( ta - tp, 2 ) = 0, ", égal au total du passif", ", différent du total du passif" ) ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: e0a5231f-22a0-403b-91ec-459a18247f19

	measure 'Faits du bilan passif' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_ligne_etat_montant ), v_ligne_etat_montant[entite] = e && v_ligne_etat_montant[arrete] = a ) VAR n = COUNTROWS ( FILTER ( t, v_ligne_etat_montant[etat] = "BILAN_PASSIF" ) ) + 0 VAR tp = MAXX ( FILTER ( t, v_ligne_etat_montant[code] = "P_TOTAL" ), v_ligne_etat_montant[Exercice N] ) VAR cp = MAXX ( FILTER ( t, v_ligne_etat_montant[code] = "P_CP" ), v_ligne_etat_montant[Exercice N] ) VAR anr = MAXX ( FILTER ( ALL ( v_anr_entite ), v_anr_entite[entite] = e && v_anr_entite[arrete] = a ), v_anr_entite[actif_net_reevalue] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || n = 0, "", FORMAT ( n, "0" ) & " lignes du modèle de l’article 321-6 ; total du passif : " & IF ( ISBLANK ( tp ), "à remplir", FORMAT ( tp, "#,##0.00" ) ) & " ; " & IF ( NOT ISBLANK ( cp ) && NOT ISBLANK ( anr ) && ROUND ( cp - anr, 2 ) = 0, "capitaux propres égaux à l’actif net réévalué : " & IF ( ISBLANK ( cp ), "à remplir", FORMAT ( cp, "#,##0.00" ) ), "capitaux propres : " & IF ( ISBLANK ( cp ), "à remplir", FORMAT ( cp, "#,##0.00" ) ) & " ; actif net réévalué : " & IF ( ISBLANK ( anr ), "absent de la base", FORMAT ( anr, "#,##0.00" ) ) ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 6087dae4-7ea9-4f87-8e0a-4587b343a2d1

	measure 'Faits du compte de resultat' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( v_ligne_etat_montant ), v_ligne_etat_montant[entite] = e && v_ligne_etat_montant[arrete] = a ) VAR n = COUNTROWS ( FILTER ( t, v_ligne_etat_montant[etat] = "RESULTAT" ) ) + 0 VAR rc = MAXX ( FILTER ( t, v_ligne_etat_montant[code] = "R_RE" ), v_ligne_etat_montant[Exercice N] ) VAR rp = MAXX ( FILTER ( t, v_ligne_etat_montant[code] = "P_CP_4" ), v_ligne_etat_montant[Exercice N] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || n = 0, "", FORMAT ( n, "0" ) & " lignes du modèle de l’article 322-2 ; " & IF ( NOT ISBLANK ( rc ) && NOT ISBLANK ( rp ) && ROUND ( rc - rp, 2 ) = 0, "résultat de l’exercice (C) égal au résultat de l’exercice du passif : " & IF ( ISBLANK ( rc ), "à remplir", FORMAT ( rc, "#,##0.00" ) ), "résultat de l’exercice (C) : " & IF ( ISBLANK ( rc ), "à remplir", FORMAT ( rc, "#,##0.00" ) ) & " ; résultat de l’exercice du passif : " & IF ( ISBLANK ( rp ), "à remplir", FORMAT ( rp, "#,##0.00" ) ) ) & " ; classes 6 et 7 lues avant leur virement au compte 120" )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: a72e0839-ea51-4e14-8b67-8f97ff36aaaa

	measure 'Montant N de la ligne d etat' = VAR c = SELECTEDVALUE ( v_ligne_etat_montant[code] ) VAR ty = SELECTEDVALUE ( v_ligne_etat_montant[type_ligne] ) VAR et = SELECTEDVALUE ( v_ligne_etat_montant[etat] ) VAR v = SUM ( v_ligne_etat_montant[Exercice N] ) RETURN IF ( ISBLANK ( c ), BLANK (), IF ( ty = "RUBRIQUE" && ISBLANK ( v ) && et IN { "BILAN_ACTIF", "BILAN_PASSIF" }, CALCULATE ( SUM ( v_ligne_etat_montant[Exercice N] ), REMOVEFILTERS ( v_ligne_etat_montant[ordre] ), REMOVEFILTERS ( v_ligne_etat_montant[Ligne du modèle] ), v_ligne_etat_montant[type_ligne] = "DETAIL", LEFT ( v_ligne_etat_montant[code], LEN ( c ) + 1 ) = c & "_" ), v ) )
		formatString: #,##0.00
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 5b07496e-d8e6-434f-9b03-2549c0190fd6

	measure 'Montant N-1 de la ligne d etat' = VAR c = SELECTEDVALUE ( v_ligne_etat_montant[code] ) VAR ty = SELECTEDVALUE ( v_ligne_etat_montant[type_ligne] ) VAR et = SELECTEDVALUE ( v_ligne_etat_montant[etat] ) VAR v = SUM ( v_ligne_etat_montant[Exercice N-1] ) RETURN IF ( ISBLANK ( c ), BLANK (), IF ( ty = "RUBRIQUE" && ISBLANK ( v ) && et IN { "BILAN_ACTIF", "BILAN_PASSIF" }, CALCULATE ( SUM ( v_ligne_etat_montant[Exercice N-1] ), REMOVEFILTERS ( v_ligne_etat_montant[ordre] ), REMOVEFILTERS ( v_ligne_etat_montant[Ligne du modèle] ), v_ligne_etat_montant[type_ligne] = "DETAIL", LEFT ( v_ligne_etat_montant[code], LEN ( c ) + 1 ) = c & "_" ), v ) )
		formatString: #,##0.00
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: f6eafd8a-7b3a-4238-a970-9bc06f749b11

	measure 'Comptes du plan de la ligne' = VAR c = SELECTEDVALUE ( v_ligne_etat_montant[code] ) VAR r = SELECTEDVALUE ( v_ligne_etat_montant[racines] ) RETURN IF ( ISBLANK ( c ), BLANK (), SWITCH ( c, "A_AUTRE_1", "421 à 423, 491", "A_AUTRE_2", "412 à 416, 44, 46, 486, 496", "A_AUTRE_3", "511", "A_FIN_1", "30", "A_FIN_2", "31", "A_FIN_3", "32", "A_FIN_4", "33", "A_FIN_5", "36", "A_FIN_6", "34", "A_FIN_7", "35", "A_IMMO_1", "21, 22, 23, 271 à 273", "A_IMMO_2", "243, 274", "A_IMMO_3", "252", "A_IMMO_4", "254", "A_IMMO_5", "256", "A_IMMO_6", "258", "A_IMMO_7", "245", "A_IMMO_8", "265, 266, 276", "P_CP_1", "101 à 109", "P_CP_2", "112, 193", "P_CP_3", "111, 191", "P_CP_4", "120, 192", "P_CP_5", "129, 198", "P_DET_1", "", "P_DET_2", "", "P_DET_3", "511", "P_DET_4", "43", "P_DET_5", "402 à 405, 408, 429, 445, 447, 448, 467, 487", "P_IF_1", "39", "P_IF_2", "34", "P_IF_3", "35", "P_IMMO_1", "291", "P_IMMO_2", "294", "P_IMMO_3", "295", "P_IMMO_4", "296", "P_PROV", "497", "R_CF_1", "604", "R_CF_2", "", "R_CI_1", "621, 622, 624 à 629", "R_CI_2", "63", "R_CI_3", "681", "R_CI_4", "", "R_MV_1", "661", "R_MV_2", "662", "R_PF_1", "700 à 706", "R_PF_2", "", "R_PI_1", "721, 722, 723, 728", "R_PI_2", "73", "R_PI_3", "781", "R_PV_1", "761", "R_PV_2", "762", "R_TV", "71", "R_TVI", "611, 612, 615, 617, 619", "R_TVII", "", "R_TVIII", "772", "R_TXI", "776", SUBSTITUTE ( r, ",", ", " ) ) )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: afc89135-0b8d-4f12-81b9-f800d35b91da

	measure 'Marque des comptes de la ligne' = VAR c = SELECTEDVALUE ( v_ligne_etat_montant[code] ) VAR r = SUBSTITUTE ( SELECTEDVALUE ( v_ligne_etat_montant[racines] ), " ", "" ) RETURN IF ( ISBLANK ( c ), BLANK (), SWITCH ( c, "A_AUTRE_1", IF ( r = "42,491", "●", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_AUTRE_2", IF ( r = "41,44,45,46,47,48,496", "411, 45, 47, 488 : non établi ●", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_AUTRE_3", IF ( r = "511,57,58", "57, 58 : non établi", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_FIN_1", IF ( r = "30", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_FIN_2", IF ( r = "31", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_FIN_3", IF ( r = "32", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_FIN_4", IF ( r = "33,34", "●", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_FIN_5", IF ( r = "35", "●", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_FIN_6", IF ( r = "36", "●", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_FIN_7", IF ( r = "37,38", "37 : non établi ●", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_1", IF ( r = "21,22,23,271,272,273", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_2", IF ( r = "243,274", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_3", IF ( r = "252", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_4", IF ( r = "254,275", "●", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_5", IF ( r = "256", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_6", IF ( r = "258", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_7", IF ( r = "245", "213-2 : non établi", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "A_IMMO_8", IF ( r = "265,266,276", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "P_CP_1", IF ( r = "101,102,103,104,105,106,107,108,109", "", "lus en base : " & SUBSTITUTE ( r, ",", ", " ) ), "P_CP_2", IF ( r = "112,193", "", "lus en