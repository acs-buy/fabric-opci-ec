/// Participations du vehicule, dont l engagement de couvrir les pertes (art. 212-5).
table eligibilite_participation
	lineageTag: 0d494598-e903-4ba7-b487-2518a2febb88

	/// « oui », « non » ; « à remplir » tant que la colonne de l’objet de base n° 10 n’existe pas
	measure 'Engagement de la filiale choisie' = VAR c = SELECTEDVALUE ( v_titres_valeur_actuelle[entite_fille] ) VAR t = FILTER ( ALL ( eligibilite_participation[entite_fille] ), eligibilite_participation[entite_fille] = c ) VAR n_oui = CALCULATE ( COUNTROWS ( eligibilite_participation ), t, eligibilite_participation[engagement_couvrir_pertes] = TRUE () ) + 0 VAR n_non = CALCULATE ( COUNTROWS ( eligibilite_participation ), t, eligibilite_participation[engagement_couvrir_pertes] = FALSE () ) + 0 RETURN IF ( NOT ISBLANK ( c ), IF ( n_oui > 0, "oui", IF ( n_non > 0, "non", "à remplir" ) ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: e040e0c0-a5eb-46cd-b62a-8f0bd9286e7c

