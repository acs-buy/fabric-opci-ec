vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) VAR m0 = [Message de l etat du livrable] RETURN IF ( ISBLANK ( et ), BLANK (), IF ( du && NOT ISBLANK ( vm ), IF ( et = "incomplet", "version " & FORMAT ( vm, "0" ), "version " & FORMAT ( vm, "0" ) & ", produite le " & FORMAT ( pl, "dd/MM/yyyy" ) & IF ( NOT ISBLANK ( pe ), ", périmée le " & FORMAT ( pe, "dd/MM/yyyy" ), "" ) ), IF ( m0 <> "", m0, "aucune version produite" ) ) )
