	measure 'Dirigeant du client (sous-ligne)' = VAR c = [Client selectionne] VAR q = CALCULATE ( SELECTEDVALUE ( ref_entite[dirigeant_qualite] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) RETURN IF ( ISBLANK ( q ), BLANK (), UPPER ( LEFT ( q, 1 ) ) & MID ( q, 2, 60 ) )
		displayFolder: Ecran 1 Client
		lineageTag: 8d4db713-79a4-4469-b97b-c57c0d934d31

	measure 'Adresse du client (sous-ligne)' = VAR c = [Client selectionne] VAR cp = CALCULATE ( SELECTEDVALUE ( ref_entite[code_postal] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) VAR v = CALCULATE ( SELECTEDVALUE ( ref_entite[ville] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) VAR p = CALCULATE ( SELECTEDVALUE ( ref_entite[pays] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) RETURN cp & " " & v & IF ( ISBLANK ( p ) || p = "FR", "", " · " & p )
