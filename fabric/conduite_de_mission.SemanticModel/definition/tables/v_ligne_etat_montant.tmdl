	measure 'Fond de la ligne d etat' = IF ( SELECTEDVALUE ( v_ligne_etat_montant[code] ) IN { "A_IMMO", "A_FIN", "A_AUTRE", "A_TOTAL", "P_CP", "P_PROV", "P_IMMO", "P_IF", "P_DET", "P_TOTAL", "R_PI", "R_TI", "R_CI", "R_TII", "R_RAI", "R_PF", "R_TIII", "R_CF", "R_TIV", "R_ROF", "R_RN", "R_RNAR", "R_PV", "R_TIX", "R_MV", "R_TX", "R_RPMV", "R_PMVAR", "R_RE" }, "#EDF2F7", "#FFFFFF" )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: e6f5f8b2-c621-4c5e-84c1-13e8a4207c91

	measure 'Fond de la marque des comptes' = VAR m = [Marque des comptes de la ligne] RETURN IF ( CONTAINSSTRING ( m, "non établi" ) || CONTAINSSTRING ( m, "lus en base" ), "#FBF4E4", [Fond de la ligne d etat] )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 8b5dc25f-67ca-4346-a637-62579d140db4

	measure 'Encre de la marque des comptes' = IF ( [Marque des comptes de la ligne] = "●", "#C7792B", "#8A6710" )
