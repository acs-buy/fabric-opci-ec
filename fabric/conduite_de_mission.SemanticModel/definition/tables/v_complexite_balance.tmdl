/// Etape 2 de l'ecran Revision, contrat du 28/09/2026.
table v_complexite_balance
	lineageTag: ffbe33c3-b27e-4a0c-a94f-05f05c26ec85

	measure 'Complexite comptes' = SUM ( v_complexite_balance[comptes_mouvementes] )
		lineageTag: e88d0325-87af-4c26-8388-9e3fad63f614

	measure 'Complexite cycles' = SUM ( v_complexite_balance[cycles_presents] )
		lineageTag: cfcc2c2f-3d4b-47e1-b2af-31ca13693bd7

	measure 'Complexite filiales' = SUM ( v_complexite_balance[balances_filiales] )
		lineageTag: 31ad71f3-51c8-4af2-8eda-e8768e23ff0b

	measure 'Complexite imports' = SUM ( v_complexite_balance[sources_import] )
		lineageTag: 060ec63b-3a55-4125-ac02-7d1ed45be900

	measure 'Type propose' = VAR t = SELECTEDVALUE ( v_complexite_balance[type_propose] ) RETURN IF ( t = "ALLEGE", "Allégé", IF ( t = "CLASSIQUE", "Classique", IF ( t = "ETENDU", "Étendu", "aucun, faute de balance importée" ) ) )
		lineageTag: 94841ffd-8c0c-4a06-9df8-6097f77cc369

	measure 'Titre de la complexite' = "Complexité de la balance, type proposé : " & [Type propose]
		lineageTag: 463fb428-4df0-4073-bc04-a620a1db7f1e

	measure 'Raison du type propose' = SELECTEDVALUE ( v_complexite_balance[raison] )
		lineageTag: 21a229c9-57ea-46fe-ab9c-53bd7062f534

	measure 'Sous-titre de la couverture' = VAR n = CALCULATE ( COUNTROWS ( v_couverture_balance ) ) VAR c = CALCULATE ( COUNTROWS ( v_couverture_balance ), v_couverture_balance[etat] = "COUVERT" ) RETURN FORMAT ( n, "0" ) & " comptes, " & FORMAT ( c, "0" ) & " couverts par une question du programme"
		lineageTag: 9c2e9626-ebc2-4920-9a17-65617ab88974

