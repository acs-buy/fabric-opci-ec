/// Les membres de l'équipe de la mission, une ligne par véhicule et par connexion, à la date du jour : le droit de retirer, de demander et de décider.
table v_ecran_membres_equipe
	lineageTag: af1c352a-35f8-527a-a668-a943c0334835

	/// La connexion de la personne connectée si elle est membre de l'équipe du client choisi, vide sinon.
	measure 'Membre de l equipe connecte' = VAR u = USERPRINCIPALNAME () VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( v_ecran_membres_equipe ) ) RETURN IF ( u <> "" && NOT ISBLANK ( c ), CALCULATE ( MAX ( v_ecran_membres_equipe[connexion] ), FILTER ( ALL ( v_ecran_membres_equipe ), v_ecran_membres_equipe[entite] = c && v_ecran_membres_equipe[connexion] = u ) ) )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 037e13b5-a7d4-5ae9-9da5-bb9a3fdbedf0

	/// La connexion de la personne connectée si elle décide les réouvertures du client choisi, vide sinon.
	measure 'Superviseur connecte CLOTURE' = VAR u = USERPRINCIPALNAME () VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( v_ecran_membres_equipe ) ) RETURN IF ( u <> "" && NOT ISBLANK ( c ), CALCULATE ( MAX ( v_ecran_membres_equipe[connexion] ), FILTER ( ALL ( v_ecran_membres_equipe ), v_ecran_membres_equipe[entite] = c && v_ecran_membres_equipe[connexion] = u && v_ecran_membres_equipe[decide_reouverture] = TRUE () ) ) )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: b4fda356-51eb-5c09-b022-9be2a50b7b1f

