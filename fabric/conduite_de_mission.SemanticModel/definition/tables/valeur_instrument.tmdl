/// Valeurs actuelles saisies des instruments financiers de classe 3.
table valeur_instrument
	lineageTag: 20a432f1-70dc-4977-a26c-88aa0fbae53a

	/// valeur de la ligne de valeur_instrument de l’instrument choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( valeur_instrument[code_actif] ), valeur_instrument[code_actif] = c ) ; vide sans ligne choisie
	measure 'Valeur de l instrument choisi' = FORMAT ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( valeur_instrument[code_actif] ), valeur_instrument[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( SUM ( valeur_instrument[valeur_actuelle] ), t ) ), "#,0" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: e5e74569-862f-41f1-8d04-69fa719d4f47

	/// source de la ligne de valeur_instrument de l’instrument choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( valeur_instrument[code_actif] ), valeur_instrument[code_actif] = c ) ; vide sans ligne choisie
	measure 'Source de l instrument choisi' = ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( valeur_instrument[code_actif] ), valeur_instrument[code_actif] = c ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( valeur_instrument[source] ), t ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 75c2d80b-06b9-4d74-809b-6caf2339f74e

	/// piece_id de la ligne de valeur_instrument de l’instrument choisi à l’arrêté : VAR c = [Actif choisi], puis FILTER ( ALL ( valeur_instrument[code_actif] ), valeur_instrument[code_actif] = c ), puis LOOKUPVALUE ( piece[nom_fichier], piece[id], piece_id ) ; vide sans ligne choisie
	measure 'Piece de l instrument choisi' = ( VAR c = [Actif choisi] VAR t = FILTER ( ALL ( valeur_instrument[code_actif] ), valeur_instrument[code_actif] = c ) VAR p = CALCULATE ( MAX ( valeur_instrument[piece_id] ), t ) RETURN IF ( NOT ISBLANK ( p ), LOOKUPVALUE ( piece[nom_fichier], piece[id], p ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: f3216631-c15f-4505-bc5f-09261abf3427

	/// « Aucun instrument choisi » ; « à remplir : aucune valeur à l’arrêté » ; vide sinon
	measure 'Absence de valeur de l instrument' = IF ( ISBLANK ( [Actif choisi] ), "Aucun instrument choisi", IF ( [Valeur de l instrument choisi] = "", "à remplir : aucune valeur à l’arrêté" ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 53e0ec38-33d0-4169-a496-6a973a850190

	/// lignes du véhicule et de ses filiales à l’arrêté ; 0 sans ligne
	measure 'Valeurs d instruments saisies' = VAR ent = VALUES ( v_ecran_valeurs_arrete[entite] ) RETURN COUNTROWS ( FILTER ( valeur_instrument, valeur_instrument[entite] IN ent ) ) + 0
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 450a57b8-e24f-4aeb-b97d-e403f5895992

