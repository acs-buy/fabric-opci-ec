/// Par arrete de mission portant une annexe, chaque article de l'annexe du recueil : son intitule, son rang, s'il est un article de principe, le texte de l'article de principe, un alinea par ligne, et le nombre de ses cellules, dont les cellules a remplir.
table v_annexe_article
	lineageTag: 89eb0392-ab1d-4dd2-a12f-bc1271407402

	measure 'Alinea 1 de l article de principe' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = COALESCE ( SELECTEDVALUE ( v_annexe_article[article] ), [Article choisi] ) VAR t = MAXX ( FILTER ( ALL ( v_annexe_article ), v_annexe_article[entite] = e && v_annexe_article[arrete] = a && v_annexe_article[article] = ar && v_annexe_article[principe] = TRUE () ), v_annexe_article[texte_principe] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || ISBLANK ( ar ) || ISBLANK ( t ), "", PATHITEM ( SUBSTITUTE ( t, UNICHAR ( 10 ), "|" ), 1 ) & "" )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: a72366b8-87b6-4e84-bd6f-66d786c87c0b

	measure 'Alinea 2 de l article de principe' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = COALESCE ( SELECTEDVALUE ( v_annexe_article[article] ), [Article choisi] ) VAR t = MAXX ( FILTER ( ALL ( v_annexe_article ), v_annexe_article[entite] = e && v_annexe_article[arrete] = a && v_annexe_article[article] = ar && v_annexe_article[principe] = TRUE () ), v_annexe_article[texte_principe] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || ISBLANK ( ar ) || ISBLANK ( t ), "", PATHITEM ( SUBSTITUTE ( t, UNICHAR ( 10 ), "|" ), 2 ) & "" )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 6c626725-72e4-46d7-bab3-88bb42f9204f

	measure 'Mention de l article de principe' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = COALESCE ( SELECTEDVALUE ( v_annexe_article[article] ), [Article choisi] ) VAR t = MAXX ( FILTER ( ALL ( v_annexe_article ), v_annexe_article[entite] = e && v_annexe_article[arrete] = a && v_annexe_article[article] = ar && v_annexe_article[principe] = TRUE () ), v_annexe_article[texte_principe] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || ISBLANK ( ar ) || ISBLANK ( t ), "", "Article de principe : aucune information à remplir" )
		displayFolder: Ecran 2 etape 6 menu des etats
		lineageTag: 19241617-98d0-4387-abbb-c20e065a9183

