/// Etape 2 de l'ecran Revision, contrat du 28/09/2026.
table v_programme_selection
	lineageTag: f285bcc6-25b9-4258-9c64-a961fd476aa7

	measure 'Question choisie au programme' = IF ( HASONEVALUE ( v_programme_selection[Réf.] ), SELECTEDVALUE ( v_programme_selection[Réf.] ) )
		lineageTag: e503fdf2-fe9b-464c-a582-c89bf9e0e6e1

	measure 'Question ajoutable' = VAR r = [Question choisie au programme] RETURN IF ( NOT ISBLANK ( r ) && NOT SELECTEDVALUE ( v_programme_selection[actif] ), r )
		lineageTag: 2a01c64d-b412-4ed2-ab29-e252a9c63c28

	measure 'Question retirable' = VAR r = [Question choisie au programme] RETURN IF ( NOT ISBLANK ( r ) && SELECTEDVALUE ( v_programme_selection[actif] ) && NOT SELECTEDVALUE ( v_programme_selection[repondue] ), r )
		lineageTag: a2013289-9b22-4ab9-a25b-b56aa6f14a7b

	measure 'Fond revProgAjouterauprogr' = IF ( ISBLANK ( [Question ajoutable] ), "#D9DFE6", "#FFFFFF" )
		lineageTag: cfa811a8-b5cf-4a48-b3e5-c0bfff0302df

	measure 'Fond revProgRetirerduprogr' = IF ( ISBLANK ( [Question retirable] ), "#D9DFE6", "#FFFFFF" )
		lineageTag: 8d459a12-5faa-4ff5-8b18-444a0740b65d

