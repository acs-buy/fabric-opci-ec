/// Les copies des livrables chez le client, et la marque de celles que la réouverture périme.
table v_copie_livrable
	lineageTag: 2e358d4a-3ffa-51f2-b948-695bdff5455e

	/// Le nombre de copies chez le client que la réouverture a marquées périmées.
	measure 'Copies perimees du client' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( v_copie_livrable ) ) RETURN CALCULATE ( COUNTROWS ( v_copie_livrable ), FILTER ( ALL ( v_copie_livrable ), v_copie_livrable[entite] = c && NOT ISBLANK ( v_copie_livrable[perimee_le] ) ) ) + 0
		formatString: 0
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 9757c954-d660-56f8-a86c-8e92d741f16e

