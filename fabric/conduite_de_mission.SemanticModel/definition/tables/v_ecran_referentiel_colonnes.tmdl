/// Écran 5, objet n° 44 : table du segment « Colonne » ; relation referentiel → v_ecran_referentiel_choix[table_nom]
table v_ecran_referentiel_colonnes
	lineageTag: 152bde4c-6642-465e-b548-63cc861f065a

	/// n° 105, avec une colonne choisie au segment « Colonne » : « « libellé » : annexe à recalculer pour n véhicules » quand marque_annexe = 1, « « libellé » : aucun effet » sinon, suivi de « ; ajout, suppression, code : annexe à recalculer pour n véhicules » quand le référentiel a un déclencheur de retar
	measure 'Effet d une modification' = VAR c = [Referentiel choisi] VAR col = [Colonne du referentiel choisie] VAR tc = FILTER ( ALL ( v_ecran_referentiel_colonnes ), v_ecran_referentiel_colonnes[referentiel] = c && v_ecran_referentiel_colonnes[colonne] = col ) VAR lib = MAXX ( tc, v_ecran_referentiel_colonnes[libelle_colonne] ) VAR mk = MAXX ( tc, v_ecran_referentiel_colonnes[marque_annexe] ) VAR n = CALCULATE ( MAX ( v_ecran_inventaire_referentiel[effet_annexe] ), FILTER ( ALL ( v_ecran_inventaire_referentiel ), v_ecran_inventaire_referentiel[table_nom] = c ) ) RETURN IF ( ISBLANK ( col ) || col = "", [Effet sur l annexe du referentiel choisi], "«" & UNICHAR ( 8239 ) & lib & UNICHAR ( 8239 ) & "»" & " : " & IF ( mk = 1, "annexe à recalculer pour " & FORMAT ( n, "0" ) & IF ( n < 2, " véhicule", " véhicules" ), "aucun effet" ) & IF ( n > 0, " ; ajout, suppression, code : annexe à recalculer pour " & FORMAT ( n, "0" ) & IF ( n < 2, " véhicule", " véhicules" ), "" ) )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 009be487-9deb-4e37-b049-0438528e3a42

	/// n° 112, SELECTEDVALUE(colonne) du segment « Colonne » : le nom de la colonne que lisent [Effet d une modification] et [Blocage modifier la valeur] ; l’écran ne montre que le libellé
	measure 'Colonne du referentiel choisie' = SELECTEDVALUE ( v_ecran_referentiel_colonnes[colonne] )
		displayFolder: Ecran 5 Referentiels
		lineageTag: 4d98495a-775b-429a-9e70-97198ba16f5a

