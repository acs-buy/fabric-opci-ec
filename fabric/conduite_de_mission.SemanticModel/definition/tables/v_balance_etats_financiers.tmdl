/// La balance de l'arrete apres OD de revision, celle que lisent les etats.
table v_balance_etats_financiers
	lineageTag: 5ed9fc18-efa7-4e98-9c5f-1e1b4f48f421

	measure 'Titre de la balance' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR den = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), ref_entite[Dénomination] ) VAR de = IF ( CONTAINSSTRING ( "aeiouyhéèêàâîôûAEIOUYHÉÈÊÀÂÎÔÛ", LEFT ( den, 1 ) ), "de l’", "de " ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), "Balance " & de & den & " au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) & ", après OD de révision" )
		displayFolder: Ecran 2 etape 6
		lineageTag: bbd8514f-b03f-43af-883b-4d17ca9996a1

	measure 'Aff Titre de la balance' = [Titre de la balance] & ""
		lineageTag: 5b2d74b8-0cd3-407f-9629-29d80d4a0630

