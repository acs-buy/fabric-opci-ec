	measure 'Infobulle e5bBouton0' = SWITCH ( TRUE (), ISBLANK ( [Client selectionne] ), "Aucun client choisi dans la liste des clients.", NOT ISBLANK ( [Refus demande reouverture] ), [Refus demande reouverture], "Inscrit la demande ; le chef de mission la décide." )
		displayFolder: Ecran Client boutons
		lineageTag: 3e8b0ff2-2e24-4376-9c9d-21bec94c1b0b

	measure 'Fond e5bBouton1' = IF ( ISBLANK ( [Client selectionne] ) || NOT ISBLANK ( [Refus accord reouverture] ), "#E4E9EF", "#0F5C8C" )
