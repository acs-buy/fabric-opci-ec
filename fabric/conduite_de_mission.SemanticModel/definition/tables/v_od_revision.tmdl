	partition v_od_revision = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_v_od_revision = Value.NativeQuery(Source, "SELECT entite, arrete, cycle, cote, reference, etat, lot_id, journal_code, compte_num, libelle, debit, credit, piece_ref, code_actif, par, DATETIME2FROMPARTS(YEAR(le), MONTH(le), DAY(le), DATEPART(HOUR, le), DATEPART(MINUTE, le), DATEPART(SECOND, le), 0, 0) AS le, brouillon_id FROM dbo.v_od_revision", null, [EnableFolding = true])
				in
				    dbo_v_od_revision

