/// Etape 5 : les feuilles de cycle hors Q- du perimetre du vehicule, par vehicule.
table v_feuilles_du_cycle
	lineageTag: c67bda57-6d76-4e56-8d2f-6db4c8779e34

	measure 'Sous-titre de la synthese des feuilles' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR c = [Cycle selectionne] VAR t = FILTER ( ALL ( v_feuilles_du_cycle ), v_feuilles_du_cycle[vehicule] = e && v_feuilles_du_cycle[arrete] = a && v_feuilles_du_cycle[cycle] = c ) VAR n = COUNTROWS ( t ) + 0 VAR k = COUNTROWS ( FILTER ( t, NOT ISBLANK ( v_feuilles_du_cycle[conclue_le] ) ) ) + 0 VAR f = COUNTROWS ( FILTER ( DISTINCT ( SELECTCOLUMNS ( t, "x", v_feuilles_du_cycle[entite] ) ), [x] <> e ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || ISBLANK ( c ), BLANK (), FORMAT ( n, "0" ) & IF ( n > 1, " feuilles", " feuille" ) & " au périmètre, " & FORMAT ( k, "0" ) & IF ( k > 1, " conclues", " conclue" ) & IF ( f > 0, ", " & FORMAT ( f, "0" ) & IF ( f > 1, " entités", " entité" ) & " de filiale", "" ) )
		displayFolder: Ecran 2 etape 5
		lineageTag: f0550d63-1c70-4d9d-91bf-f746dce83a90

	measure 'Synthèse de la feuille' = VAR e = MAX ( v_feuilles_du_cycle[entite] ) VAR c = MAX ( v_feuilles_du_cycle[conclue_le] ) VAR g = MAX ( v_feuilles_du_cycle[gabarit] ) VAR o = MAX ( v_feuilles_du_cycle[objectif_libelle] ) VAR f = MAX ( v_feuilles_du_cycle[forme_libelle] ) VAR cp = MAX ( v_feuilles_du_cycle[conclue_par] ) VAR ncp = IF ( SEARCH ( "@", cp, 1, 0 ) > 1, LEFT ( cp, SEARCH ( "@", cp, 1, 0 ) - 1 ), cp ) VAR l1 = e & " · " & IF ( ISBLANK ( c ), "non conclue", "conclue" ) & " · " & IF ( ISBLANK ( g ), "sans gabarit", "gabarit " & g ) & " · objectif " & IF ( ISBLANK ( o ), "à remplir", o ) VAR pd = ADDCOLUMNS ( GENERATESERIES ( 1, LEN ( l1 ), 1 ), "p", VAR u = UNICODE ( MID ( l1, [Value], 1 ) ) RETURN IF ( ( u >= 65 && u <= 90 ) || ( u >= 48 && u <= 57 ), 1.65, 1 ) ) VAR k = MAXX ( FILTER ( pd, VAR i = [Value] RETURN SUMX ( FILTER ( pd, [Value] <= i ), [p] ) <= 69 ), [Value] ) VAR l1c = IF ( SUMX ( pd, [p] ) <= 70, l1, LEFT ( l1, k ) & "…" ) RETURN IF ( HASONEVALUE ( v_feuilles_du_cycle[Feuille] ), l1c & IF ( ISBLANK ( c ), "", UNICHAR ( 10 ) & IF ( ISBLANK ( f ), "", f & ". " ) & MAX ( v_feuilles_du_cycle[conclusion] ) & UNICHAR ( 10 ) & "conclue par " & ncp & ", le " & FORMAT ( c, "dd/MM/yyyy" ) ) )
		lineageTag: 8f80aedb-11c5-474a-8460-c7d7d8fa4abe

