	measure 'Condition sommes distribuables visees' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR typ = MAXX ( FILTER ( ALL ( ref_arrete ), ref_arrete[entite] = e && ref_arrete[Arrêté] = a ), ref_arrete[Type] ) VAR tob = FILTER ( ALL ( obligation_distribution ), obligation_distribution[entite] = e && LEFT ( obligation_distribution[exercice], 4 ) = LEFT ( a, 4 ) ) VAR nob = COUNTROWS ( ALLNOBLANKROW ( ref_obligation_distribution ) ) + 0 VAR vis = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( tob, obligation_distribution[etat] = "VISEE" ), "c", obligation_distribution[categorie] ) ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || typ <> "ANNUEL", BLANK (), IF ( vis >= nob, "Oui", "Non" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: e5b2cdba-f492-4ff5-bdf3-cd8244be819b

	measure 'Lecture sommes distribuables visees' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR typ = MAXX ( FILTER ( ALL ( ref_arrete ), ref_arrete[entite] = e && ref_arrete[Arrêté] = a ), ref_arrete[Type] ) VAR tob = FILTER ( ALL ( obligation_distribution ), obligation_distribution[entite] = e && LEFT ( obligation_distribution[exercice], 4 ) = LEFT ( a, 4 ) ) VAR nob = COUNTROWS ( ALLNOBLANKROW ( ref_obligation_distribution ) ) + 0 VAR vis = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( tob, obligation_distribution[etat] = "VISEE" ), "c", obligation_distribution[categorie] ) ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || typ <> "ANNUEL", BLANK (), FORMAT ( vis, "0" ) & " / " & FORMAT ( nob, "0" ) & ", catégories de l’exercice, à l’arrêté annuel" )
		displayFolder: Ecran 2 etape 6
		lineageTag: b8ea6ba2-f1cf-449a-9ec9-7d1289804a2a

