/// Expertises des immeubles, une par actif et date de valeur. Aucune relation : l actif choisi et la date de l arrete par mesure.
table expertise
	lineageTag: 91e8e5ef-f9e4-4f2e-933e-a4c9e63ccc00

	/// VAR c = [Actif choisi] ; 1 quand SELECTEDVALUE ( expertise[code_actif] ) = c ; filtre de visuel = 1 du tableEx des expertises, évalué ligne par ligne parce que code_actif est dans sa granularité : sans lui, une date et un expert communs à plusieurs actifs forment une seule ligne ({ex_grain_expertise
	measure 'Filtre expertises de l actif choisi' = VAR c = [Actif choisi] RETURN IF ( NOT ISBLANK ( c ) && SELECTEDVALUE ( expertise[code_actif] ) = c, 1 )
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 84aa6ec4-820e-4580-8a35-0be549c8be4f

	/// écart avec l’expertise précédente du même actif (barre de données)
	measure 'Variation de l expertise' = VAR a = SELECTEDVALUE ( expertise[code_actif] ) VAR d = SELECTEDVALUE ( expertise[date_valeur] ) VAR v = SELECTEDVALUE ( expertise[valeur_actuelle] ) VAR dp = CALCULATE ( MAX ( expertise[date_valeur] ), FILTER ( ALL ( expertise ), expertise[code_actif] = a && expertise[date_valeur] < d ) ) VAR vp = CALCULATE ( SUM ( expertise[valeur_actuelle] ), FILTER ( ALL ( expertise ), expertise[code_actif] = a && expertise[date_valeur] = dp ) ) RETURN IF ( NOT ISBLANK ( dp ) && NOT ISBLANK ( v ), v - vp )
		formatString: #,0
		displayFolder: Ecran 3 Valorisation
		lineageTag: e73f356c-99eb-4243-bd99-5a37b9febcff

	/// expert de l’expertise de l’actif choisi à la date de l’arrêté : VAR c = [Actif choisi], VAR d = la date de l’arrêté choisi, puis FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ; vide quand la base ne le porte pas (D7) ; vide sans ligne choisie
	measure 'Expert du rapport de l actif' = ( VAR c = [Actif choisi] VAR a = [Arrete selectionne] VAR d = IF ( NOT ISBLANK ( a ), DATE ( VALUE ( LEFT ( a, 4 ) ), VALUE ( MID ( a, 6, 2 ) ), VALUE ( RIGHT ( a, 2 ) ) ) ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( expertise[expert] ), FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 0f3dd4b7-f1ca-495d-b688-2bec505ddd74

	/// methode de l’expertise de l’actif choisi à la date de l’arrêté : VAR c = [Actif choisi], VAR d = la date de l’arrêté choisi, puis FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ; idem ; vide sans ligne choisie
	measure 'Methode du rapport de l actif' = ( VAR c = [Actif choisi] VAR a = [Arrete selectionne] VAR d = IF ( NOT ISBLANK ( a ), DATE ( VALUE ( LEFT ( a, 4 ) ), VALUE ( MID ( a, 6, 2 ) ), VALUE ( RIGHT ( a, 2 ) ) ) ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( expertise[methode] ), FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 8577c395-078b-44c2-91b5-84b3780d457a

	/// date_valeur de l’expertise de l’actif choisi à la date de l’arrêté : VAR c = [Actif choisi], VAR d = la date de l’arrêté choisi, puis FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ; vide sans ligne choisie
	measure 'Date de valeur du rapport de l actif' = FORMAT ( VAR c = [Actif choisi] VAR a = [Arrete selectionne] VAR d = IF ( NOT ISBLANK ( a ), DATE ( VALUE ( LEFT ( a, 4 ) ), VALUE ( MID ( a, 6, 2 ) ), VALUE ( RIGHT ( a, 2 ) ) ) ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( expertise[date_valeur] ), FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ) ), "dd/MM/yyyy" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: dd1097a2-851f-4878-9cc0-487f67fd8a5e

	/// valeur_actuelle de l’expertise de l’actif choisi à la date de l’arrêté : VAR c = [Actif choisi], VAR d = la date de l’arrêté choisi, puis FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ; vide sans ligne choisie
	measure 'Valeur d expertise du rapport de l actif' = FORMAT ( VAR c = [Actif choisi] VAR a = [Arrete selectionne] VAR d = IF ( NOT ISBLANK ( a ), DATE ( VALUE ( LEFT ( a, 4 ) ), VALUE ( MID ( a, 6, 2 ) ), VALUE ( RIGHT ( a, 2 ) ) ) ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( SUM ( expertise[valeur_actuelle] ), FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ) ), "#,0.00" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 5aea6dd8-fc2e-4d12-a834-5fc149e13432

	/// enregistre_le de l’expertise de l’actif choisi à la date de l’arrêté : VAR c = [Actif choisi], VAR d = la date de l’arrêté choisi, puis FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ; vide sans ligne choisie
	measure 'Enregistree le du rapport de l actif' = FORMAT ( VAR c = [Actif choisi] VAR a = [Arrete selectionne] VAR d = IF ( NOT ISBLANK ( a ), DATE ( VALUE ( LEFT ( a, 4 ) ), VALUE ( MID ( a, 6, 2 ) ), VALUE ( RIGHT ( a, 2 ) ) ) ) RETURN IF ( NOT ISBLANK ( c ), CALCULATE ( MAX ( expertise[enregistre_le] ), FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ) ), "dd/MM/yyyy" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 0fa00726-109e-478f-94b9-90b1895b6bce

	/// piece_id de l’expertise de l’actif choisi à la date de l’arrêté : VAR c = [Actif choisi], VAR d = la date de l’arrêté choisi, puis FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ), puis LOOKUPVALUE ( piece[nom_fichier], piece[id], piece_id ) ; vide sans ligne cho
	measure 'Fichier du rapport de l actif' = ( VAR c = [Actif choisi] VAR a = [Arrete selectionne] VAR d = IF ( NOT ISBLANK ( a ), DATE ( VALUE ( LEFT ( a, 4 ) ), VALUE ( MID ( a, 6, 2 ) ), VALUE ( RIGHT ( a, 2 ) ) ) ) VAR p = CALCULATE ( MAX ( expertise[piece_id] ), FILTER ( ALL ( expertise ), expertise[code_actif] = c && expertise[date_valeur] = d ) ) RETURN IF ( NOT ISBLANK ( p ), LOOKUPVALUE ( piece[nom_fichier], piece[id], p ) ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 801c8cde-ce43-4257-9cb7-c3c06ea6161c

	/// « Aucun actif choisi » ; « à remplir : aucune expertise à l’arrêté » ; vide quand l’expertise de l’arrêté existe
	measure 'Absence du rapport de l actif' = IF ( ISBLANK ( [Actif choisi] ), "Aucun actif choisi", IF ( [Valeur d expertise du rapport de l actif] = "", "à remplir : aucune expertise à l’arrêté" ) ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 4add04b3-c866-4876-b4cf-edc0a14560ab

