	measure 'Libelle e5bBouton1' = "Rouvrir l'arrêté"
		displayFolder: Ecran Client boutons
		lineageTag: 76a5d4b1-675e-445a-bdcd-0bb38d4e9ee9

	measure 'Infobulle e5bBouton1' = SWITCH ( TRUE (), ISBLANK ( [Client selectionne] ), "Aucun client choisi dans la liste des clients.", NOT ISBLANK ( [Refus accord reouverture] ), [Refus accord reouverture], "Rouvre l'arrêté de la demande ; la personne connectée décide." )
		displayFolder: Ecran Client boutons
		lineageTag: 33b4635c-36fa-4127-a448-77a925dfae86

	measure 'Fond e5bBouton2' = IF ( ISBLANK ( [Client selectionne] ) || NOT ISBLANK ( [Refus ecart reouverture] ), "#E4E9EF", "#FFFFFF" )
		displayFolder: Ecran Client boutons
		lineageTag: dd5f4774-82af-4fde-b70d-358053b4a404

	measure 'Libelle e5bBouton2' = "Écarter la demande"
		displayFolder: Ecran Client boutons
		lineageTag: 40c1a994-6a87-49d1-b64d-cd9514c8047c

	measure 'Infobulle e5bBouton2' = SWITCH ( TRUE (), ISBLANK ( [Client selectionne] ), "Aucun client choisi dans la liste des clients.", NOT ISBLANK ( [Refus ecart reouverture] ), [Refus ecart reouverture], "Écarte la demande ; l'arrêté reste clos." )
		displayFolder: Ecran Client boutons
		lineageTag: 5f9efce6-5ee3-45c0-8446-2ecbe1fb260b

	/// « CMF, art. L. 214-69, I ; art. 321-4 du règlement ANC n° 2021-09, modifié par le règlement ANC n° 2024-01 » pour une SPPICAV, art. L. 214-81, I pour un FPI (forme_vehicule) ; article 321-4, Sommes distribuables : recueil, page 91 du fichier PDF, imprimée 90
	measure 'Fondement des sommes distribuables' = VAR e = [Client selectionne] VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) RETURN IF ( fv = "FPI", "CMF, art. L. 214-81, I", "CMF, art. L. 214-69, I" ) & " ; art. 321-4 du règlement ANC n° 2021-09, modifié par le règlement ANC n° 2024-01"
		displayFolder: Ecran 4 Arrete
		lineageTag: 22d0c316-6088-4c0d-acd1-60fb6c97a34c

