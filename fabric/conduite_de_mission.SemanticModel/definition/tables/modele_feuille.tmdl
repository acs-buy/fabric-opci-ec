/// Écran 5, objet n° 53 : carte « Gabarits sans fichier »
table modele_feuille
	lineageTag: d7e936b8-3b82-49cf-b823-301520d11d6d

	/// n° 84, modèles sans nom de fichier ni chemin (carte 5)
	measure 'Gabarits sans fichier' = COUNTROWS ( FILTER ( ALL ( modele_feuille ), ISBLANK ( modele_feuille[nom_fichier] ) && ISBLANK ( modele_feuille[chemin_coffre] ) ) ) + 0
		formatString: #,0
		displayFolder: Ecran 5 Referentiels
		lineageTag: 3385d0e5-c325-411c-bd4c-055b841165ca

	/// n° 85, « sur n modèles de feuille, n sans objectif » (carte 5)
	measure 'Sous-ligne gabarits sans fichier' = VAR n = COUNTROWS ( ALLNOBLANKROW ( modele_feuille ) ) + 0 VAR s = COUNTROWS ( FILTER ( ALL ( modele_feuille ), ISBLANK ( modele_feuille[objectif] ) ) ) + 0 RETURN "sur " & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( n, "#,0" ), UNICHAR ( 160 ), " " ), UNICHAR ( 8239 ), " " ) & " modèles de feuille, " & SUBSTITUTE ( SUBSTITUTE ( FORMAT ( s, "#,0" ), UNICHAR ( 160 ), " " ), UNICHAR ( 8239 ), " " ) & " sans objectif"
		displayFolder: Ecran 5 Referentiels
		lineageTag: af62ec7f-5159-4822-b6ec-3a7294a4111f

	/// n° 86, alerte au-dessus de 0, vert à 0 (carte 5)
	measure 'Couleur gabarits sans fichier' = IF ( [Gabarits sans fichier] > 0, "#9A2A2A", "#1F6D4A" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: f33960c5-2d60-4c2a-8b00-32209b5339e5

