table feuille_travail
	lineageTag: 95c3267f-d659-4ac9-a1f2-b125d9340401

	/// Nombre de feuilles de travail du périmètre filtré.
	measure 'Feuilles de travail' = COUNTROWS(feuille_travail)
		formatString: #,0
		displayFolder: Révision
		lineageTag: 7b429334-d858-4233-bbd6-701827c3079c

	/// Feuilles dont la conclusion est posée.
	measure 'Feuilles conclues' = CALCULATE(COUNTROWS(feuille_travail), NOT ISBLANK(feuille_travail[conclue_le])) + 0
		formatString: #,0
		displayFolder: Révision
		lineageTag: e9deee0f-558c-4df0-9b04-e910613f18f5

	/// Feuilles ouvertes sans conclusion.
	measure 'Feuilles a conclure' = [Feuilles de travail] - [Feuilles conclues]
		formatString: #,0
		displayFolder: Révision
		lineageTag: 570a0b38-96a3-43ec-9ed1-02a3ded1fd7d

	/// Part des feuilles conclues.
	measure 'Part conclue' = DIVIDE([Feuilles conclues], [Feuilles de travail])
		formatString: 0.0 %
		displayFolder: Révision
		lineageTag: 3e5dc169-4c5f-420d-92f8-4c5841378415

	/// Feuilles portant une revue.
	measure 'Feuilles revisees' = CALCULATE(COUNTROWS(feuille_travail), NOT ISBLANK(feuille_travail[revise_le])) + 0
		formatString: #,0
		displayFolder: Révision
		lineageTag: 9f448571-a4b7-4de8-9b6e-54aa7188dba8

	/// Jours moyens entre la préparation et la conclusion.
	measure 'Delai de conclusion' = AVERAGEX(FILTER(feuille_travail, NOT ISBLANK(feuille_travail[conclue_le])), DATEDIFF(feuille_travail[prepare_le], feuille_travail[conclue_le], DAY))
		formatString: 0.0
		displayFolder: Révision
		lineageTag: b06afe56-b390-4355-a0a6-c3deeeaa7b6b

