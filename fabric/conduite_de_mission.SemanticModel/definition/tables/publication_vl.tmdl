	partition publication_vl = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_publication_vl = Value.NativeQuery(Source, "SELECT id, entite, arrete, valeur_liquidative, nombre_parts, publie_par, DATETIME2FROMPARTS(YEAR(publie_le), MONTH(publie_le), DAY(publie_le), DATEPART(HOUR, publie_le), DATEPART(MINUTE, publie_le), DATEPART(SECOND, publie_le), 0, 0) AS publie_le, DATETIME2FROMPARTS(YEAR(perimee_le), MONTH(perimee_le), DAY(perimee_le), DATEPART(HOUR, perimee_le), DATEPART(MINUTE, perimee_le), DATEPART(SECOND, perimee_le), 0, 0) AS perimee_le FROM dbo.publication_vl", null, [EnableFolding = true])
				in
				    dbo_publication_vl

