	measure 'Message de l etat du livrable' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR pl = MAXX ( tv, document_produit[produit_le] ) VAR pp = MAXX ( tv, document_produit[produit_par] ) VAR pe = MAXX ( tv, document_produit[perime_le] ) VAR pm = MAXX ( tv, document_produit[perime_motif] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR tdv = FILTER ( tq, demande_document[version] = dv ) VAR dd = MAXX ( tdv, demande_document[etat] ) VAR dl = MAXX ( tdv, demande_document[demande_le] ) VAR dm = MAXX ( tdv, demande_document[motif_refus] ) VAR du = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR fl = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR fs = SUBSTITUTE ( fl, ",", "|" ) VAR fx = "," & CONCATENATEX ( tv, document_produit[format], "," ) & "," VAR fm = FILTER ( GENERATESERIES ( 1, IF ( ISBLANK ( fl ), 0, PATHLENGTH ( fs ) ) ), NOT CONTAINSSTRING ( fx, "," & PATHITEM ( fs, [Value] ) & "," ) ) VAR nm = COUNTROWS ( fm ) + 0 VAR mq = CONCATENATEX ( fm, SWITCH ( PATHITEM ( fs, [Value] ), "DOCX", "Word", "XLSX", "classeur Excel", PATHITEM ( fs, [Value] ) ), " et ", [Value], ASC ) VAR dvm = MAXX ( FILTER ( tq, demande_document[version] = vm ), demande_document[etat] ) VAR et = IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), NOT du, "sans objet", dd IN { "DEMANDEE", "REFUSEE" } && ( ISBLANK ( pl ) || dl > pl ), IF ( dd = "DEMANDEE", "demande posée", "refusé" ), ISBLANK ( vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) VAR nd = MINX ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[livrable] = "DIP" && v_livrables_dus[arrete] > a ), v_livrables_dus[arrete] ) VAR ndt = MAXX ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[livrable] = "DIP" && v_livrables_dus[arrete] = nd ), v_livrables_dus[type_arrete] ) VAR k = SEARCH ( " : ", pm, 1, 0 ) RETURN IF ( ISBLANK ( et ), BLANK (), SWITCH ( et, "demande posée", "demandée le " & FORMAT ( dl, "dd/MM/yyyy" ), "refusé", dm & "", "périmé", IF ( k > 0, LEFT ( pm, k - 1 ), pm & "" ), "incomplet", mi, "sans objet", IF ( l = "DIP" && NOT ISBLANK ( nd ), "dû à l’arrêté " & LOWER ( ndt ) & " du " & MID ( nd, 9, 2 ) & "/" & MID ( nd, 6, 2 ) & "/" & LEFT ( nd, 4 ), "" ), "" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: b7d2cca8-5a54-462c-b420-eb10fb7b9743

	measure 'Message du livrable' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = [Livrable choisi] VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR pl = MAXX ( tv, document_produit[produit_le] ) VAR pp = MAXX ( tv, document_produit[produit_par] ) VAR pe = MAXX ( tv, document_produit[perime_le] ) VAR pm = MAXX ( tv, document_produit[perime_motif] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR tdv = FILTER ( tq, demande_document[version] = dv ) VAR dd = MAXX ( tdv, demande_document[etat] ) VAR dl = MAXX ( tdv, demande_document[demande_le] ) VAR dm = MAXX ( tdv, demande_document[motif_refus] ) VAR du = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR fl = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR fs = SUBSTITUTE ( fl, ",", "|" ) VAR fx = "," & CONCATENATEX ( tv, document_produit[format], "," ) & "," VAR fm = FILTER ( GENERATESERIES ( 1, IF ( ISBLANK ( fl ), 0, PATHLENGTH ( fs ) ) ), NOT CONTAINSSTRING ( fx, "," & PATHITEM ( fs, [Value] ) & "," ) ) VAR nm = COUNTROWS ( fm ) + 0 VAR mq = CONCATENATEX ( fm, SWITCH ( PATHITEM ( fs, [Value] ), "DOCX", "Word", "XLSX", "classeur Excel", PATHITEM ( fs, [Value] ) ), " et ", [Value], ASC ) VAR dvm = MAXX ( FILTER ( tq, demande_document[version] = vm ), demande_document[etat] ) VAR et = IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), NOT du, "sans objet", dd IN { "DEMANDEE", "REFUSEE" } && ( ISBLANK ( pl ) || dl > pl ), IF ( dd = "DEMANDEE", "demande posée", "refusé" ), ISBLANK ( vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) VAR rv = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), IF ( v_revision_indicateurs[revue_visee], 1, 0 ) ) + 0 VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) VAR sc = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), IF ( ISBLANK ( ref_entite[soumise_commissariat_comptes] ), BLANK (), IF ( ref_entite[soumise_commissariat_comptes], 1, 0 ) ) ) VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR fa = MAXX ( tr, v_rapport_expert_comptable[forme_arretee] ) VAR al = MAXX ( tr, v_rapport_expert_comptable[arretee_le] ) VAR mc = MAXX ( tr, v_rapport_expert_comptable[motif_considerations_particulieres] ) VAR m0 = [Message de l etat du livrable] VAR eca = CALCULATE ( [Etat du livrable], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "COMPTES_ANNUELS" ) VAR actif = NOT ( et IN { "produit", "sans objet" } ) VAR g1 = IF ( l = "ATTESTATION", IF ( ISBLANK ( al ), "forme non arrêtée", IF ( fa IN { "SANS_OBSERVATION", "AVEC_OBSERVATION", "IMPOSSIBILITE" } && ( ISBLANK ( sc ) || sc = 1 ) && LEN ( TRIM ( mc ) ) = 0, "attestation sans motif de considérations particulières" ) ), IF ( et = "demande posée", "demande en cours" ) ) VAR g2 = IF ( l = "ATTESTATION", IF ( eca <> "produit", "comptes annuels non produits" ), IF ( rv <> 1, "revue non visée" ) ) VAR g3 = IF ( cl = "VISE", "arrêté validé pour le client" ) VAR pr = MAXX ( FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ), IF ( v_annexe_produisible[produisible], 1, 0 ) ) VAR g5 = IF ( l = "COMPTES_ANNUELS" && actif && NOT ISBLANK ( pr ) && pr = 0, "tableau 333-3 non rapproché du bilan" ) VAR p = { ( 1, m0 ), ( 2, IF ( actif, g1 ) ), ( 3, IF ( actif, g2 ) ), ( 4, IF ( actif, g3 ) ), ( 5, IF ( actif, g5 ) ) } RETURN IF ( ISBLANK ( et ), BLANK (), CONCATENATEX ( FILTER ( p, [Value2] <> "" ), [Value2], " ; ", [Value1], ASC ) & "" )
