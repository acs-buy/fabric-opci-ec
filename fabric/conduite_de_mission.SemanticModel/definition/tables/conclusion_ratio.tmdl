/// Conclusions du reviseur, une par limite et par arrete. Lue par mesures, sans relation.
table conclusion_ratio
	lineageTag: 95da8efd-976f-4f2d-9570-420bedf92c1a

	/// « conclue le jj/mm/aaaa », la date de conclu_le de la ligne de conclusion_ratio de la limite à l’arrêté (FORMAT « dd/MM/yyyy », la date que rend aussi [Conclusion inscrite de la limite]) ; un texte vide sans ligne, une limite sans objet comprise ; une ligne écrite avant que la limite ne devienne san
	measure 'Conclusion de la limite a l ecran' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) VAR d = MAXX ( FILTER ( ALL ( conclusion_ratio ), conclusion_ratio[entite] = e && conclusion_ratio[arrete] = a && conclusion_ratio[code] = c ), conclusion_ratio[conclu_le] ) RETURN IF ( vide, BLANK (), ( IF ( ISBLANK ( d ), "", "conclue le " & FORMAT ( d, "dd/MM/yyyy" ) ) ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: 2f4c7124-aef8-4505-9843-b030f90066e9

	/// « conclusion, par x le jj/mm/aaaa » ; « à remplir » sans ligne ; vide quand le segment ne porte pas exactement 1 limite, test HASONEVALUE ( ref_ratio_memoire[code] )
	measure 'Conclusion inscrite de la limite' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) VAR tc = FILTER ( ALL ( conclusion_ratio ), conclusion_ratio[entite] = e && conclusion_ratio[arrete] = a && conclusion_ratio[code] = c ) VAR kc = MAXX ( tc, conclusion_ratio[conclusion] ) VAR p = MAXX ( tc, conclusion_ratio[conclu_par] ) VAR d = MAXX ( tc, conclusion_ratio[conclu_le] ) RETURN IF ( vide, BLANK (), ( IF ( NOT une, "", IF ( ISBLANK ( kc ), "à remplir", kc & ", par " & p & " le " & FORMAT ( d, "dd/MM/yyyy" ) ) ) ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: fe7ac80a-8c6c-4619-b63e-e7dd22a06b04

