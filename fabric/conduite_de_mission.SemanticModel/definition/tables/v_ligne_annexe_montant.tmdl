	measure 'Article de la cellule a enregistrer' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = [Article choisi] VAR np = COUNTROWS ( FILTER ( ALL ( v_annexe_cellule ), v_annexe_cellule[entite] = e && v_annexe_cellule[arrete] = a && v_annexe_cellule[article] = ar && ( v_annexe_cellule[nature] IN { "texte", "source" } || v_annexe_cellule[etat] = "A_REMPLIR" ) ) ) + 0 RETURN IF ( NOT ISBLANK ( ar ) && np > 0 && ISBLANK ( [Obstacle a la saisie de la cellule] ), ar )
