	measure 'Copie a la validation' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR u = MAXX ( FILTER ( ALL ( v_espace_client ), v_espace_client[entite] = e ), v_espace_client[site_url] ) VAR p = IF ( ISBLANK ( u ), 0, SEARCH ( "/sites/", u, 1, 0 ) ) VAR s = IF ( p > 0, MID ( u, p + 7, 200 ), "" ) RETURN IF ( ISBLANK ( e ) || [Refus de validation au connecte] & "" <> "", "", IF ( s = "", "site du véhicule", "site " & s ) & ", bibliothèque Livrables" )
		lineageTag: f87701a1-7b3f-41c4-bef4-bcc13a5364d0

	measure 'Filet Carte validation' = VAR c = [Carte validation encre] RETURN SWITCH ( c, "#8A6710", "#C8961E", "#9A2A2A", "#9A2A2A", "#1F6D4A", "#1F6D4A", "#0F5C8C" )
		lineageTag: 1f780e31-5415-4160-9b4c-e6aa372a25df

	measure 'Libelle de la ligne de validation' = IF ( [Refus de validation au connecte] & "" <> "", "VALIDATION", "COPIE À LA VALIDATION" )
		lineageTag: a113b2ec-ec5d-4ed4-9eab-da95a423ed46

	measure 'Refus de validation ligne 1' = VAR t = [Refus de validation au connecte] & "" VAR k = IF ( t = "", 0, SEARCH ( ", ", t, 30, 0 ) ) RETURN IF ( k > 0, LEFT ( t, k ), t )
		lineageTag: 90f90c78-c00b-4757-bd4f-3bee23eafa55

	measure 'Refus de validation ligne 2' = VAR t = [Refus de validation au connecte] & "" VAR k = IF ( t = "", 0, SEARCH ( ", ", t, 30, 0 ) ) RETURN IF ( k > 0, MID ( t, k + 2, 400 ), "" )
		lineageTag: ca46fbbb-97ac-49a4-8942-598632435500

	measure 'Pied comptes annuels du menu' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR v = CALCULATE ( [Version du livrable], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "COMPTES_ANNUELS" ) VAR et = CALCULATE ( [Etat du livrable], REMOVEFILTERS ( ref_livrable ), ref_livrable[code] = "COMPTES_ANNUELS" ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Livrable : comptes annuels, bilan, compte de résultat et annexe · Version : " & IF ( ISBLANK ( v ) || v = "", "aucune", v ) & " · État : " & IF ( ISBLANK ( et ) || et = "", "non dû à cet arrêté", et ) )
		lineageTag: 278a416e-1bf8-4961-bd20-dca86e393a4b

	measure 'Pied annexe du menu' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR tp = FILTER ( ALL ( v_annexe_produisible ), v_annexe_produisible[entite] = e && v_annexe_produisible[arrete] = a ) VAR rem = MAXX ( tp, v_annexe_produisible[cellules_a_remplir] ) + 0 VAR blo = MAXX ( tp, v_annexe_produisible[bloquantes] ) + 0 VAR tot = SUMX ( FILTER ( ALL ( v_cellules_a_remplir ), v_cellules_a_remplir[entite] = e && v_cellules_a_remplir[arrete] = a ), v_cellules_a_remplir[cellules] ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || COUNTROWS ( tp ) = 0, "", IF ( [Carte annexe] = "Sans objet", "annexe : sans objet à cet arrêté", "annexe : " & FORMAT ( rem, "0" ) & IF ( rem > 1, " cellules", " cellule" ) & " à remplir sur " & FORMAT ( tot, "0" ) & ", " & FORMAT ( blo, "0" ) & IF ( blo > 1, " bloquantes", " bloquante" ) ) )
		lineageTag: 9c44a042-29f1-496a-bfcb-63abf5ff02a1

	/// « Arrêté, étape 3 » quand [Libelle condition sommes] n’est pas vide, vide sinon
	measure 'Ecran condition sommes' = IF ( [Libelle condition sommes] <> "", "Arrêté, étape 3", "" )
		displayFolder: Ecran 4 Arrete
		lineageTag: ad0b4684-8acc-4865-be98-68441c046cb4

	/// « Arrêté, étape 2 » quand [Libelle condition rang 4] n’est pas vide, vide sinon
	measure 'Ecran condition rang 4' = IF ( [Libelle condition rang 4] <> "", "Arrêté, étape 2", "" )
		displayFolder: Ecran 4 Arrete
		lineageTag: a0723984-64a0-49b2-a2f0-5b8c5eeea92b

	/// « Révision, étape 6 Livrables » quand [Libelle condition rapport] n’est pas vide ; « Arrêté, étape 2 » quand la ligne porte la VL ; vide sinon
	measure 'Ecran condition rang 3' = IF ( [Libelle condition rapport] <> "", "Révision, étape 6 Livrables", IF ( [Libelle condition rang 3] <> "", "Arrêté, étape 2", "" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: 769ace76-5b71-4782-9953-986a559cd688

	/// « Révision, étape 6 Livrables » quand [Libelle condition comptes] ou [Libelle condition dip] n’est pas vide (ligne 2, 2 visuels superposés comme sur ec02)
	measure 'Ecran condition comptes ou dip' = IF ( [Libelle condition comptes] <> "" || [Libelle condition dip] <> "", "Révision, étape 6 Livrables", "" )
		displayFolder: Ecran 4 Arrete
		lineageTag: d398ca7c-dd8a-4f14-82f0-f6563b170385

	/// « Révision, étape 5 Conclure » quand [Libelle condition revue] n’est pas vide, vide sinon
	measure 'Ecran condition revue' = IF ( [Libelle condition revue] <> "", "Révision, étape 5 Conclure", "" )
		displayFolder: Ecran 4 Arrete
		lineageTag: e3122c73-6789-4fe2-95b3-f3de1d8c4414

	/// vert quand [Blocage conclure la limite] vaut « conditions réunies », alerte sinon
	measure 'Couleur blocage conclusion' = IF ( [Blocage conclure la limite] = "conditions réunies", "#1F6D4A", "#9A2A2A" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 90ce4561-d2db-4e74-9805-3cff9cc27cee

	/// « arrêté validé pour le client » quand le dernier visa de clôture est VISE ; « limite sans objet pour ce véhicule » quand [Statut de la limite] le dit ; joints par « · » ; « conditions réunies » sinon ; une limite non choisie ne bloque pas, la fonction refuse en français
	measure 'Blocage conclure la limite' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) VAR dcl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) VAR p1 = IF ( dcl = "VISE", "arrêté validé pour le client" ) VAR j1 = p1 VAR p2 = IF ( so, "limite sans objet pour ce véhicule" ) VAR j2 = IF ( j1 <> "" && p2 <> "", j1 & " · " & p2, j1 & p2 ) RETURN IF ( vide, BLANK (), ( IF ( j2 = "", "conditions réunies", j2 ) ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: 6312fcca-de04-45f1-aeed-30eeb780c83c

	/// vert quand [Arrete etape 4 faite] vaut 1, gris sinon
	measure 'Fond arrete etape 4' = IF ( [Arrete etape 4 faite] = 1, "#1F6D4A", "#D5DCE4" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 60b5f463-bd93-4330-bb18-9077d7b6e165

	/// dernier visa de clôture VISE
	measure 'Arrete etape 4 faite' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR dcl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) RETURN IF ( dcl = "VISE", 1, 0 )
		formatString: 0
		displayFolder: Ecran 4 Arrete
		lineageTag: d697614b-7d40-4fcc-9f8a-58ef0e0d1d8d

