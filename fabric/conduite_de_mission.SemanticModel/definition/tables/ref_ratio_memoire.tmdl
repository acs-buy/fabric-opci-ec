/// Les 18 limites des 6 familles du memoire.
table ref_ratio_memoire
	lineageTag: 6e6ce11d-8441-4b70-bdfc-376365564ea7

	/// nombre de limites de ref_ratio_memoire dont [Statut de la limite] n’est pas « sans objet » pour le véhicule et qui n’ont pas de ligne de conclusion_ratio à l’arrêté (VAR e, a puis FILTER ALL (ref_ratio_memoire) et FILTER ALL (conclusion_ratio)), à la française ; valeur de la carte 1, « Limites à con
	measure 'Carte limites a conclure' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR ntot = COUNTROWS ( ALLNOBLANKROW ( ref_ratio_memoire ) ) VAR nso = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ), 1, 0 ) ) + 0 VAR nconc = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( NOT ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ) && COUNTROWS ( FILTER ( ALL ( conclusion_ratio ), conclusion_ratio[entite] = e && conclusion_ratio[arrete] = a && conclusion_ratio[code] = ref_ratio_memoire[code] ) ) > 0, 1, 0 ) ) + 0 VAR ncalc = COUNTROWS ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ) ) + 0 VAR necart = SUMX ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ), VAR cc = v_ratio_conclusion[code] VAR lf = CALCULATE ( MAX ( ref_ratio_memoire[forme_vehicule] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR lsp = CALCULATE ( MAX ( ref_ratio_memoire[statut_professionnel] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR so = ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) RETURN IF ( NOT so && ( ( v_ratio_conclusion[sens] = "MINIMUM" && v_ratio_conclusion[ratio] < v_ratio_conclusion[seuil] ) || ( v_ratio_conclusion[sens] = "MAXIMUM" && v_ratio_conclusion[ratio] > v_ratio_conclusion[seuil] ) ), 1, 0 ) ) + 0 VAR nacon = ntot - nso - nconc RETURN FORMAT ( nacon, "0" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 5eedfb6c-664f-4358-8bfb-c2b45a435657

	/// « n limites, n sans objet · n calculées, n en écart au seuil », chaque nombre compté en limites sur toutes les limites de ref_ratio_memoire (ALL), quelle que soit la limite cochée : sans objet par [Statut de la limite] ; calculées, les limites qui ont une ligne de v_ratio_conclusion à l’arrêté (VAR
	measure 'Sous-ligne limites' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR ntot = COUNTROWS ( ALLNOBLANKROW ( ref_ratio_memoire ) ) VAR nso = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ), 1, 0 ) ) + 0 VAR nconc = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( NOT ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ) && COUNTROWS ( FILTER ( ALL ( conclusion_ratio ), conclusion_ratio[entite] = e && conclusion_ratio[arrete] = a && conclusion_ratio[code] = ref_ratio_memoire[code] ) ) > 0, 1, 0 ) ) + 0 VAR ncalc = COUNTROWS ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ) ) + 0 VAR necart = SUMX ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ), VAR cc = v_ratio_conclusion[code] VAR lf = CALCULATE ( MAX ( ref_ratio_memoire[forme_vehicule] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR lsp = CALCULATE ( MAX ( ref_ratio_memoire[statut_professionnel] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR so = ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) RETURN IF ( NOT so && ( ( v_ratio_conclusion[sens] = "MINIMUM" && v_ratio_conclusion[ratio] < v_ratio_conclusion[seuil] ) || ( v_ratio_conclusion[sens] = "MAXIMUM" && v_ratio_conclusion[ratio] > v_ratio_conclusion[seuil] ) ), 1, 0 ) ) + 0 VAR nacon = ntot - nso - nconc RETURN FORMAT ( ntot, "0" ) & " limites, " & FORMAT ( nso, "0" ) & " sans objet · " & FORMAT ( ncalc, "0" ) & IF ( ncalc > 1, " calculées", " calculée" ) & ", " & FORMAT ( necart, "0" ) & " en écart"
		displayFolder: Ecran 4 Arrete
		lineageTag: fe9c468c-8bb4-4c3f-9ea8-696931099815

	/// alerte quand une limite calculée à l’arrêté, qui n’est pas sans objet pour le véhicule, est en écart au seuil, comptée comme [Sous-ligne limites] (carte 1)
	measure 'Encre limites' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR ntot = COUNTROWS ( ALLNOBLANKROW ( ref_ratio_memoire ) ) VAR nso = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ), 1, 0 ) ) + 0 VAR nconc = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( NOT ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ) && COUNTROWS ( FILTER ( ALL ( conclusion_ratio ), conclusion_ratio[entite] = e && conclusion_ratio[arrete] = a && conclusion_ratio[code] = ref_ratio_memoire[code] ) ) > 0, 1, 0 ) ) + 0 VAR ncalc = COUNTROWS ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ) ) + 0 VAR necart = SUMX ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ), VAR cc = v_ratio_conclusion[code] VAR lf = CALCULATE ( MAX ( ref_ratio_memoire[forme_vehicule] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR lsp = CALCULATE ( MAX ( ref_ratio_memoire[statut_professionnel] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR so = ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) RETURN IF ( NOT so && ( ( v_ratio_conclusion[sens] = "MINIMUM" && v_ratio_conclusion[ratio] < v_ratio_conclusion[seuil] ) || ( v_ratio_conclusion[sens] = "MAXIMUM" && v_ratio_conclusion[ratio] > v_ratio_conclusion[seuil] ) ), 1, 0 ) ) + 0 VAR nacon = ntot - nso - nconc RETURN IF ( necart > 0, "#9A2A2A", "#12233C" )
		displayFolder: Ecran 4 Arrete
		lineageTag: cd6707d9-d8c3-491c-b3d8-14ad4727f450

	/// 1 quand chaque limite de ref_ratio_memoire qui n’est pas sans objet pour le véhicule ([Statut de la limite]) porte sa ligne de conclusion_ratio à l’arrêté, que la base la calcule ou non, et qu’il existe au moins 1 telle limite ; 0 sinon ; sur toutes les limites (VAR e, a puis FILTER ALL (ref_ratio_m
	measure 'Arrete etape 1 faite' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR ntot = COUNTROWS ( ALLNOBLANKROW ( ref_ratio_memoire ) ) VAR nso = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ), 1, 0 ) ) + 0 VAR nconc = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( NOT ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ) && COUNTROWS ( FILTER ( ALL ( conclusion_ratio ), conclusion_ratio[entite] = e && conclusion_ratio[arrete] = a && conclusion_ratio[code] = ref_ratio_memoire[code] ) ) > 0, 1, 0 ) ) + 0 VAR ncalc = COUNTROWS ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ) ) + 0 VAR necart = SUMX ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ), VAR cc = v_ratio_conclusion[code] VAR lf = CALCULATE ( MAX ( ref_ratio_memoire[forme_vehicule] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR lsp = CALCULATE ( MAX ( ref_ratio_memoire[statut_professionnel] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR so = ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) RETURN IF ( NOT so && ( ( v_ratio_conclusion[sens] = "MINIMUM" && v_ratio_conclusion[ratio] < v_ratio_conclusion[seuil] ) || ( v_ratio_conclusion[sens] = "MAXIMUM" && v_ratio_conclusion[ratio] > v_ratio_conclusion[seuil] ) ), 1, 0 ) ) + 0 VAR nacon = ntot - nso - nconc RETURN IF ( ntot - nso > 0 && nconc = ntot - nso, 1, 0 )
		formatString: 0
		displayFolder: Ecran 4 Arrete
		lineageTag: 6383b339-b24b-42c0-8077-6d5762f014ce

	/// vert quand [Arrete etape 1 faite] vaut 1, gris sinon (mécanisme etape0 de la page ec01)
	measure 'Fond arrete etape 1' = IF ( [Arrete etape 1 faite] = 1, "#1F6D4A", "#D5DCE4" )
		displayFolder: Ecran 4 Arrete
		lineageTag: b15e5186-f558-4766-975b-7198376698fa

	/// « OPCI professionnel » ou « OPCI grand public » (ref_entite[est_professionnel]) puis « n limites des 6 familles : n à conclure, n sans objet · n/n conclues », chaque nombre compté en limites, comme [Sous-ligne limites]
	measure 'Sous-titre grille des limites' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR ntot = COUNTROWS ( ALLNOBLANKROW ( ref_ratio_memoire ) ) VAR nso = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ), 1, 0 ) ) + 0 VAR nconc = SUMX ( ALLNOBLANKROW ( ref_ratio_memoire ), IF ( NOT ( ( NOT ISBLANK ( ref_ratio_memoire[forme_vehicule] ) && ref_ratio_memoire[forme_vehicule] <> fv ) || ( pro && ref_ratio_memoire[statut_professionnel] = "SANS_OBJET" ) ) && COUNTROWS ( FILTER ( ALL ( conclusion_ratio ), conclusion_ratio[entite] = e && conclusion_ratio[arrete] = a && conclusion_ratio[code] = ref_ratio_memoire[code] ) ) > 0, 1, 0 ) ) + 0 VAR ncalc = COUNTROWS ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ) ) + 0 VAR necart = SUMX ( FILTER ( ALL ( v_ratio_conclusion ), v_ratio_conclusion[entite] = e && v_ratio_conclusion[arrete] = a ), VAR cc = v_ratio_conclusion[code] VAR lf = CALCULATE ( MAX ( ref_ratio_memoire[forme_vehicule] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR lsp = CALCULATE ( MAX ( ref_ratio_memoire[statut_professionnel] ), FILTER ( ALL ( ref_ratio_memoire ), ref_ratio_memoire[code] = cc ) ) VAR so = ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) RETURN IF ( NOT so && ( ( v_ratio_conclusion[sens] = "MINIMUM" && v_ratio_conclusion[ratio] < v_ratio_conclusion[seuil] ) || ( v_ratio_conclusion[sens] = "MAXIMUM" && v_ratio_conclusion[ratio] > v_ratio_conclusion[seuil] ) ), 1, 0 ) ) + 0 VAR nacon = ntot - nso - nconc RETURN IF ( pro, "OPCI professionnel", "OPCI grand public" ) & " · " & FORMAT ( ntot, "0" ) & " limites des 6 familles : " & FORMAT ( nacon, "0" ) & " à conclure, " & FORMAT ( nso, "0" ) & " sans objet · " & FORMAT ( nconc, "0" ) & "/" & FORMAT ( ntot - nso, "0" ) & " conclues"
		displayFolder: Ecran 4 Arrete
		lineageTag: c86c9452-faa4-4a3b-a4e8-63ff2edb98d2

	/// « sans objet » quand forme_vehicule de la limite est renseignée et diffère de celle du véhicule ; sinon, pour un véhicule marqué OPCI professionnel (est_professionnel = 1), statut_professionnel à la française : « applicable », « sans objet », « retenue par le cabinet », « à arrêter » ; pour un véhicule non marqué (NULL ou 0), statut_grand_public : « applicable », « sous condition » ; colonne « Pour ce véhicule » de la grille, fiche ; « fixée par les statuts » pour une limite retenue par le cabinet que le seuil des statuts du véhicule remplace (décision D9)
	measure 'Statut de la limite' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lt = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[limite_texte] ) ) VAR lignes = SELECTCOLUMNS ( ALL ( ref_ratio_vehicule ), "entite", ref_ratio_vehicule[entite], "code", ref_ratio_vehicule[code], "seuil", ref_ratio_vehicule[seuil], "source", ref_ratio_vehicule[source] ) VAR t2 = FILTER ( lignes, [entite] = e && [code] = c && ( [source] = "GESTIONNAIRE" || ( [source] = "STATUTS" && pro ) ) ) VAR s = MAXX ( t2, [seuil] ) VAR src = MAXX ( t2, [source] ) VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) RETURN IF ( vide, BLANK (), ( IF ( une, IF ( so, "sans objet", IF ( pro, SWITCH ( lsp, "APPLICABLE", "applicable", "SANS_OBJET", "sans objet", "RETENUE", IF ( src = "STATUTS", "fixée par les statuts", "retenue par le cabinet" ), "A_ARRETER", "à arrêter", lsp ), SWITCH ( lsg, "APPLICABLE", "applicable", "CONDITION", "sous condition", lsg ) ) ), "" ) ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: c69eff08-1b3d-440e-a64a-b5382c285eee

	/// gris « sans objet », attente « à arrêter » et « sous condition », encre sinon (police de la colonne « Pour ce véhicule »)
	measure 'Couleur statut de la limite' = VAR s = [Statut de la limite] RETURN IF ( ISBLANK ( s ), BLANK (), SWITCH ( TRUE (), s = "sans objet", "#5B6B7D", s IN { "à arrêter", "sous condition" }, "#8A6710", "#12233C" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: cb62dfce-e56d-41d8-ac5d-d5e1d97719fb

	/// statut de la limite pour un OPCI grand public de la forme du véhicule et son fondement : « applicable », « sous condition : … » (statut_grand_public, fondement_grand_public), ou « sans objet, SPPICAV seulement » (forme_vehicule) ; vide sans exactement 1 limite cochée, test HASONEVALUE ( ref_ratio_me
	measure 'Fiche limite grand public' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) VAR fg = SELECTEDVALUE ( ref_ratio_memoire[fondement_grand_public] ) RETURN IF ( vide, BLANK (), ( IF ( NOT une, "", IF ( NOT ISBLANK ( lf ) && lf <> fv, "sans objet, " & lf & " seulement", SWITCH ( lsg, "APPLICABLE", "applicable", "CONDITION", "sous condition : " & fg, lsg ) ) ) & "" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: f4b1751e-55e5-49b2-b177-247be10c0f5e

	/// statut de la limite pour un OPCI professionnel et son fondement : « sans objet, R. 214-199 », « retenue par le cabinet : L. 214-39 et R. 214-104, retenus par le cabinet ; R. 214-196 et R. 214-200 permettent aux statuts d’y déroger », « à arrêter : … », « applicable : … » (statut_professionnel, fonde
	measure 'Fiche limite professionnel' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) VAR fp = SELECTEDVALUE ( ref_ratio_memoire[fondement_professionnel] ) RETURN IF ( vide, BLANK (), ( IF ( NOT une, "", IF ( NOT ISBLANK ( lf ) && lf <> fv, "sans objet, " & lf & " seulement", SWITCH ( lsp, "SANS_OBJET", "sans objet : " & fp, "RETENUE", "retenue par le cabinet : " & fp, "A_ARRETER", "à arrêter : " & fp, "APPLICABLE", "applicable : " & fp, lsp ) ) ) & "" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: 6c3f41ec-b207-49a7-975c-4dd0aab2ddcb

	/// le libellé de la limite cochée ; « aucune limite choisie » ; « n limites cochées » (fiche et conclusion de la limite)
	measure 'Sous-titre fiche de la limite' = VAR sel = ISFILTERED ( ref_ratio_memoire[libelle] ) || ISFILTERED ( ref_ratio_memoire[code] ) VAR k = COUNTROWS ( VALUES ( ref_ratio_memoire[code] ) ) RETURN IF ( sel && k = 1, SELECTEDVALUE ( ref_ratio_memoire[libelle] ), IF ( NOT sel || k = 0, "aucune limite choisie", FORMAT ( k, "0" ) & " limites cochées" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: cef54dad-913f-45b5-9bc3-d6cb90d1e60b

	/// « Aucune limite choisie » sans case cochée ; vide avec 1 case cochée et plus (carte collée, & "") : à 2 cases cochées, seule la carte [Avis limite cochee] énonce le nombre coché, à droite de « Conclure la limite » (décision 10) ; posée dans la fiche et dans la conclusion de la limite, à la place du
	measure 'Absence de limite choisie' = VAR sel = ISFILTERED ( ref_ratio_memoire[libelle] ) || ISFILTERED ( ref_ratio_memoire[code] ) VAR k = COUNTROWS ( VALUES ( ref_ratio_memoire[code] ) ) RETURN IF ( NOT sel || k = 0, "Aucune limite choisie", "" ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 1d784663-0e6c-4534-bb8b-5d3c9ba9117b

	/// « n limites cochées » quand le segment porte 2 valeurs ou plus ; vide sinon (carte collée, & "") : le service désactive alors « Conclure la limite » avec une bulle anglaise (guide, § 17.29.1), et la carte, à côté du bouton, énonce le fait en français (décision du candidat du 15/10/2026, « Garder, av
	measure 'Avis limite cochee' = VAR sel = ISFILTERED ( ref_ratio_memoire[libelle] ) || ISFILTERED ( ref_ratio_memoire[code] ) VAR k = COUNTROWS ( VALUES ( ref_ratio_memoire[code] ) ) RETURN IF ( sel && k >= 2, FORMAT ( k, "0" ) & " limites cochées", "" ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: a2d75f45-ded2-4be0-9232-1060721645fa

	/// famille de la limite cochée ; vide sans exactement 1 limite cochée, test HASONEVALUE ( ref_ratio_memoire[code] )
	measure 'Fiche limite famille' = IF ( HASONEVALUE ( ref_ratio_memoire[code] ), SELECTEDVALUE ( ref_ratio_memoire[famille] ) ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: 61080521-05f5-43e9-ba4c-fb9c71f0988c

	/// article de la limite cochée ; vide sans exactement 1 limite cochée, test HASONEVALUE ( ref_ratio_memoire[code] )
	measure 'Fiche limite article' = IF ( HASONEVALUE ( ref_ratio_memoire[code] ), SELECTEDVALUE ( ref_ratio_memoire[article] ) ) & ""
