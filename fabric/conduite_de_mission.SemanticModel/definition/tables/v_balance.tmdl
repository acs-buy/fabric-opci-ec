table v_balance
	lineageTag: 04c2527e-e104-4764-8f48-5fa6cbef9103

	/// Somme des soldes débiteurs de la balance d'entrée.
	measure 'Debit initial' = CALCULATE(SUM(v_balance[b0_initiale]), v_balance[b0_initiale] > 0)
		formatString: #,0.00
		displayFolder: Balance
		lineageTag: cd32aa8f-06b0-45e4-ba4b-2638e6211f3f

	/// Somme des soldes après écritures de révision et de valorisation.
	measure 'Balance finale' = SUM(v_balance[balance_finale])
		formatString: #,0.00
		displayFolder: Balance
		lineageTag: beba7db9-58c0-48bd-b231-32c4eb5e661a

	/// Somme des écritures de révision.
	measure 'Ecritures de revision' = SUM(v_balance[od_revision])
		formatString: #,0.00
		displayFolder: Balance
		lineageTag: 9c3956a8-eefc-415c-a979-4c545690d370

	/// Somme des écritures de valorisation.
	measure 'Ecritures de valorisation' = SUM(v_balance[od_valorisation])
		formatString: #,0.00
		displayFolder: Balance
		lineageTag: 2169705c-4db1-4eb3-ae61-59001fe2866e

	/// Nombre de comptes mouvementés.
	measure 'Comptes de la balance' = DISTINCTCOUNT(v_balance[compte])
		formatString: #,0
		displayFolder: Balance
		lineageTag: 422a42f8-4d4c-4efd-93d3-e1928a172d8b

	/// Carte 3.5, Comptes de la balance. Arbitree le 15/09/2026 par la session de la base.
	measure 'R35 Comptes de la balance' = COUNTROWS ( v_balance )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 55614471-d719-4b80-a5b8-f18ff5bf5ec2

