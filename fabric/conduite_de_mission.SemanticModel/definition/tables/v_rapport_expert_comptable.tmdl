	measure 'Texte rempli de la forme choisie' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t0 = [Texte de la forme choisie] VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR ar = "à remplir" VAR mot = MAXX ( tr, v_rapport_expert_comptable[comptes_annuels_ou_intermediaires] ) & "" VAR jd = MAXX ( tr, v_rapport_expert_comptable[date_arrete] ) VAR ent = MAXX ( tr, v_rapport_expert_comptable[entite_concernee] ) & "" VAR lm = MAXX ( tr, v_rapport_expert_comptable[lettre_de_mission_du] ) VAR tb = MAXX ( tr, v_rapport_expert_comptable[total_du_bilan] ) VAR ca = MAXX ( tr, v_rapport_expert_comptable[chiffre_d_affaires] ) VAR rn = MAXX ( tr, v_rapport_expert_comptable[resultat_net_comptable] ) VAR dp = MAXX ( tr, v_rapport_expert_comptable[description_des_points] ) & "" VAR ls = MAXX ( tr, v_rapport_expert_comptable[lieu_date_signature] ) & "" VAR m = IF ( mot = "", ar, mot ) VAR per = IF ( mot = "annuels" && NOT ISBLANK ( jd ), "l’exercice clos le " & FORMAT ( jd, "dd/MM/yyyy" ), IF ( mot = "intermédiaires" && NOT ISBLANK ( jd ), "la période close le " & FORMAT ( jd, "dd/MM/yyyy" ), ar ) ) VAR de = IF ( ent = "", "de " & ar, IF ( CONTAINSSTRING ( "aeiouyhéèêàâîôû", LEFT ( ent, 1 ) ), "d’", "de " ) & ent ) VAR x1 = SUBSTITUTE ( t0, UNICHAR ( 13 ), "" ) VAR x2 = SUBSTITUTE ( x1, "comptes … (préciser « annuels », « intermédiaires »)", "comptes " & m ) VAR x3 = SUBSTITUTE ( x2, "de … (préciser l’entité concernée)", de ) VAR x4 = SUBSTITUTE ( x3, "relatifs à … (préciser la période ou l’exercice concerné)", "relatifs à " & per ) VAR x5 = SUBSTITUTE ( x4, "en date du …", "en date du " & IF ( ISBLANK ( lm ), ar, FORMAT ( lm, "dd/MM/yyyy" ) ) ) VAR x6 = SUBSTITUTE ( SUBSTITUTE ( x5, "annuels (ou « intermédiaires »)", m ), "annuels (ou intermédiaires)", m ) VAR p0 = SUBSTITUTE ( x6, "· Total du bilan ;", "· Total du bilan : " & IF ( ISBLANK ( tb ), ar, FORMAT ( tb, "#,##0.00" ) ) & " ;" ) VAR p1 = SUBSTITUTE ( p0, "· Chiffre d’affaires ;", "· Chiffre d’affaires : " & IF ( ISBLANK ( ca ), ar, FORMAT ( ca, "#,##0.00" ) ) & " ;" ) VAR p2 = SUBSTITUTE ( p1, "· Résultat net comptable.", "· Résultat net comptable : " & IF ( ISBLANK ( rn ), ar, FORMAT ( rn, "#,##0.00" ) ) & "." ) VAR d1 = SUBSTITUTE ( SUBSTITUTE ( p2, "(Description du (des) point(s) relevé(s) et de son (leur) incidence sur les comptes)", IF ( dp = "", ar, dp ) ), "(Description motivée et chiffrée des désaccords, incertitudes ou limitations faisant l’objet de l’ (des) observation(s))", IF ( dp = "", ar, dp ) ) VAR s1 = SUBSTITUTE ( d1, "Lieu, date et signature", "Lieu, date et signature : " & IF ( ls = "", ar, ls ) ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ) || ISBLANK ( t0 ), "", s1 )
		lineageTag: d65197db-a539-4de0-984d-0892e963cb95

	measure 'Rapport devise' = IF ( ISBLANK ( [Entite selectionnee] ), "", "à remplir, devise sans source en base" )
		lineageTag: 11ea8371-6cc3-45de-aac5-ef7f86b5c0f9

	measure 'Rapport lecture du chiffre d affaires ligne 1' = VAR t = [Rapport lecture du chiffre d affaires] & "" VAR k = SEARCH ( " : ", t, 1, 0 ) RETURN IF ( k > 0, LEFT ( t, k + 1 ), t )
		lineageTag: ac08f169-7939-4661-9595-308ef5ac9f73

	measure 'Rapport lecture du chiffre d affaires ligne 2' = VAR t = [Rapport lecture du chiffre d affaires] & "" VAR k = SEARCH ( " : ", t, 1, 0 ) RETURN IF ( k > 0, MID ( t, k + 3, 300 ), "" )
		lineageTag: 8de4174d-3a7a-4fc3-8120-497f146a1148

	measure 'Rapport source ligne 1' = VAR t = [Rapport source] & "" VAR k = SEARCH ( ", ", t, 30, 0 ) RETURN IF ( k > 0, LEFT ( t, k ), t )
		lineageTag: c3f4f1b8-a454-491c-bc25-2f8b0a8480f0

	measure 'Rapport source ligne 2' = VAR t = [Rapport source] & "" VAR k = SEARCH ( ", ", t, 30, 0 ) RETURN IF ( k > 0, MID ( t, k + 2, 300 ), "" )
		lineageTag: 7f82ef89-8017-44bf-9617-c865b6401077

