/// Detail de l actif net reevalue des filiales, cascade de l etape 3.
table v_ecran_anr_filiale_detail
	lineageTag: a9a52234-9a3d-46c6-a879-f28c7c9af870

	/// VAR c = SELECTEDVALUE ( v_titres_valeur_actuelle[entite_fille] ), la filiale du segment ; CALCULATE ( SUM ( v_ecran_anr_filiale_detail[montant] ), FILTER ( ALL ( v_ecran_anr_filiale_detail[entite] ), v_ecran_anr_filiale_detail[entite] = c ) ) : seule l’entité est remplacée, la référence de la colonn
