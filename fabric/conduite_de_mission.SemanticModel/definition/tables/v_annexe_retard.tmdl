		dataType: string
		sourceProviderType: nvarchar(128)
		lineageTag: e99e4a1a-df2d-49f2-bd3a-8a79728be3e5
		summarizeBy: none
		sourceColumn: origine

		annotation SummarizationSetBy = Automatic

	column ecritures
		dataType: int64
		isNullable: false
		formatString: 0
		sourceProviderType: int
		lineageTag: 562ad7a8-bc2e-4e13-8581-5cac897fccf0
		summarizeBy: none
		sourceColumn: ecritures

		annotation SummarizationSetBy = Automatic

	column dernier_calcul
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		sourceProviderType: datetime2
		lineageTag: 3837beb5-b315-46a8-9098-a9bb826474d9
		summarizeBy: none
		sourceColumn: dernier_calcul

		annotation SummarizationSetBy = Automatic

	column en_retard
		dataType: boolean
		sourceProviderType: bit
		lineageTag: 8593439b-ba39-41d1-a29a-10ea62c42a17
		summarizeBy: none
		sourceColumn: en_retard

		annotation SummarizationSetBy = Automatic

