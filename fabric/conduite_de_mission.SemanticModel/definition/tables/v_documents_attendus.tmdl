/// Les pieces attendues par entite et arrete, avec leur etat (MANQUANTE, FOURNIE, FACULTATIVE). Tableau de bord Client et collecte. Ajoutee le 09/09/2026.
table v_documents_attendus
	lineageTag: 4b83c3aa-b157-4423-8c1b-329243da959f

	measure 'Pieces attendues' = CALCULATE ( COUNTROWS ( v_documents_attendus ), FILTER ( v_documents_attendus, v_documents_attendus[etat] <> "FACULTATIVE" ), FILTER ( ALL ( ref_entite ), ref_entite[est_client] = TRUE () ) ) + 0
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: 7dcc4ec5-3683-4c74-ae29-165ad791e015

	/// Pieces attendues non recues.
	measure 'Pieces attendues manquantes' = CALCULATE(COUNTROWS(v_documents_attendus), v_documents_attendus[etat] = "MANQUANTE") + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 6af2efe7-3561-4d67-876c-ed07ed8fb0cc

	/// Pieces attendues recues.
	measure 'Pieces attendues fournies' = CALCULATE(COUNTROWS(v_documents_attendus), v_documents_attendus[etat] = "FOURNIE") + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: a202f915-6a97-47bf-bcd7-bdf8ca2f1d3d

	/// Pieces attendues manquantes, entite et arrete affiches.
	measure 'Pieces manquantes du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Pieces attendues manquantes], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: b370adc5-e72b-4c98-89ee-09957356f6aa

	/// Pieces attendues fournies, entite et arrete affiches.
	measure 'Pieces fournies du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Pieces attendues fournies], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: c4fad6a3-c226-4dac-89cb-7c494028799c

	measure 'Pieces attendues 2' = CALCULATE ( COUNTROWS ( v_documents_attendus ), v_documents_attendus[etat] <> "FACULTATIVE", ref_entite[est_client] = TRUE () )
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: 00e9b4f2-c90a-4063-93ea-9f15c375f000

	measure 'Pieces sous ligne' = VAR n = [Pieces manquantes] RETURN IF ( ISBLANK ( n ) || n = 0, "toutes fournies", "manquantes : " & FORMAT ( n, "#,0" ) )
		displayFolder: Ecran 1 Client
		lineageTag: d2c544f1-a447-4bac-85b2-f28869e7b914

	measure 'Pièces attendues' = [Pieces attendues 2]
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: 4d791ac9-5e07-4742-ace5-24376a5d9ae3

	measure 'Sous-ligne pieces' = VAR n = [Pieces manquantes] RETURN IF ( ISBLANK ( n ) || n = 0, "toutes fournies", "manquantes : " & FORMAT ( n, "#,0" ) )
		displayFolder: Ecran 1 Client
		lineageTag: 11fa4abb-223a-4d1f-ad1a-157b3351bb05

	measure 'Pieces attendues du client' = VAR c = [Client selectionne] RETURN CALCULATE ( COUNTROWS ( v_documents_attendus ), FILTER ( ALL ( v_documents_attendus ), v_documents_attendus[entite] = c && v_documents_attendus[etat] <> "FACULTATIVE" ) ) + 0
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: 57c6f028-36f5-4af7-9c6d-78c2de7a8c71

	measure 'Pieces manquantes du client' = VAR c = [Client selectionne] RETURN CALCULATE ( COUNTROWS ( v_documents_attendus ), FILTER ( ALL ( v_documents_attendus ), v_documents_attendus[entite] = c && v_documents_attendus[etat] = "MANQUANTE" ) ) + 0
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: 9e12bafa-eb56-40dd-891c-159f065a9157

