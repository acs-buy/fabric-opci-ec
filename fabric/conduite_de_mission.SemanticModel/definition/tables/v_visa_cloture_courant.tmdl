/// Le dernier visa de cloture de chaque arrete.
table v_visa_cloture_courant
	lineageTag: 5bd2228b-b4f9-44d3-9273-8efffe4e3847

	measure 'Carte validation' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( cl = "VISE", "Validée", "Non validée" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 11d4924c-cbd5-425a-8629-600f242985bc

	measure 'Carte validation sous-titre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) VAR cll = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decide_le] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( cl = "VISE", "clôture visée le " & FORMAT ( cll, "dd/MM/yyyy" ), IF ( NOT ISBLANK ( cl ), "dernier visa de clôture : " & IF ( cl = "RENVOYE", "renvoyé", LOWER ( cl ) ) & " le " & FORMAT ( cll, "dd/MM/yyyy" ), "aucun visa de clôture" ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 4c65a350-2acc-445c-a9e6-f456d0dc1cca

	measure 'Carte validation encre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "#12233C", IF ( cl = "VISE", "#1F6D4A", "#9A2A2A" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 71adab5d-978a-4717-83f7-8bc47a71817d

	measure 'Condition revue visee' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR rv = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), IF ( v_revision_indicateurs[revue_visee], 1, 0 ) ) + 0 VAR vr = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), IF ( v_revision_indicateurs[verrouille], 1, 0 ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( rv = 1 && vr = 1, "Oui", "Non" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: e86cdbe4-53fa-4142-af32-a8acf46b667d

	measure 'Lecture revue visee' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR cv = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), v_revision_indicateurs[cycles_vises] ) + 0 VAR cy = MAXX ( FILTER ( ALL ( v_revision_indicateurs ), v_revision_indicateurs[entite] = e && v_revision_indicateurs[arrete] = a ), v_revision_indicateurs[cycles] ) + 0 VAR vle = MAXX ( FILTER ( ALL ( v_etat_revue ), v_etat_revue[entite] = e && v_etat_revue[arrete] = a && v_etat_revue[verrouille] = TRUE () ), v_etat_revue[verrouille_le] ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), FORMAT ( cv, "0" ) & IF ( cv > 1, " cycles visés", " cycle visé" ) & " sur " & FORMAT ( cy, "0" ) & " ; " & IF ( ISBLANK ( vle ), "dossier non verrouillé", "verrouillé le " & FORMAT ( vle, "dd/MM/yyyy" ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 00029535-6fc7-4081-be17-28c6435f3558

	measure 'Condition comptes annuels produits' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = "COMPTES_ANNUELS" VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR pl = MAXX ( tv, document_produit[produit_le] ) VAR pp = MAXX ( tv, document_produit[produit_par] ) VAR pe = MAXX ( tv, document_produit[perime_le] ) VAR pm = MAXX ( tv, document_produit[perime_motif] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR tdv = FILTER ( tq, demande_document[version] = dv ) VAR dd = MAXX ( tdv, demande_document[etat] ) VAR dl = MAXX ( tdv, demande_document[demande_le] ) VAR dm = MAXX ( tdv, demande_document[motif_refus] ) VAR du = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR fl = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR fs = SUBSTITUTE ( fl, ",", "|" ) VAR fx = "," & CONCATENATEX ( tv, document_produit[format], "," ) & "," VAR fm = FILTER ( GENERATESERIES ( 1, IF ( ISBLANK ( fl ), 0, PATHLENGTH ( fs ) ) ), NOT CONTAINSSTRING ( fx, "," & PATHITEM ( fs, [Value] ) & "," ) ) VAR nm = COUNTROWS ( fm ) + 0 VAR mq = CONCATENATEX ( fm, SWITCH ( PATHITEM ( fs, [Value] ), "DOCX", "Word", "XLSX", "classeur Excel", PATHITEM ( fs, [Value] ) ), " et ", [Value], ASC ) VAR dvm = MAXX ( FILTER ( tq, demande_document[version] = vm ), demande_document[etat] ) VAR et = IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), NOT du, "sans objet", dd IN { "DEMANDEE", "REFUSEE" } && ( ISBLANK ( pl ) || dl > pl ), IF ( dd = "DEMANDEE", "demande posée", "refusé" ), ISBLANK ( vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) RETURN IF ( NOT du || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( et = "produit", "Oui", "Non" ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 83319022-aee1-407d-ad26-0c0bb07d08db

	measure 'Lecture comptes annuels produits' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR l = "COMPTES_ANNUELS" VAR td = FILTER ( ALL ( document_produit ), document_produit[entite] = e && document_produit[arrete] = a && document_produit[livrable] = l ) VAR vm = MAXX ( td, document_produit[version] ) VAR tv = FILTER ( td, document_produit[version] = vm ) VAR pl = MAXX ( tv, document_produit[produit_le] ) VAR pp = MAXX ( tv, document_produit[produit_par] ) VAR pe = MAXX ( tv, document_produit[perime_le] ) VAR pm = MAXX ( tv, document_produit[perime_motif] ) VAR tq = FILTER ( ALL ( demande_document ), demande_document[entite] = e && demande_document[arrete] = a && demande_document[livrable] = l ) VAR dv = MAXX ( tq, demande_document[version] ) VAR tdv = FILTER ( tq, demande_document[version] = dv ) VAR dd = MAXX ( tdv, demande_document[etat] ) VAR dl = MAXX ( tdv, demande_document[demande_le] ) VAR dm = MAXX ( tdv, demande_document[motif_refus] ) VAR du = COUNTROWS ( FILTER ( ALL ( v_livrables_dus ), v_livrables_dus[entite] = e && v_livrables_dus[arrete] = a && v_livrables_dus[livrable] = l ) ) > 0 VAR fl = MAXX ( FILTER ( ALL ( ref_livrable ), ref_livrable[code] = l ), ref_livrable[formats] ) VAR fs = SUBSTITUTE ( fl, ",", "|" ) VAR fx = "," & CONCATENATEX ( tv, document_produit[format], "," ) & "," VAR fm = FILTER ( GENERATESERIES ( 1, IF ( ISBLANK ( fl ), 0, PATHLENGTH ( fs ) ) ), NOT CONTAINSSTRING ( fx, "," & PATHITEM ( fs, [Value] ) & "," ) ) VAR nm = COUNTROWS ( fm ) + 0 VAR mq = CONCATENATEX ( fm, SWITCH ( PATHITEM ( fs, [Value] ), "DOCX", "Word", "XLSX", "classeur Excel", PATHITEM ( fs, [Value] ) ), " et ", [Value], ASC ) VAR dvm = MAXX ( FILTER ( tq, demande_document[version] = vm ), demande_document[etat] ) VAR et = IF ( ISBLANK ( l ) || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), SWITCH ( TRUE (), NOT du, "sans objet", dd IN { "DEMANDEE", "REFUSEE" } && ( ISBLANK ( pl ) || dl > pl ), IF ( dd = "DEMANDEE", "demande posée", "refusé" ), ISBLANK ( vm ), "à produire", NOT ISBLANK ( pe ), "périmé", nm > 0 || dvm = "DEMANDEE", "incomplet", "produit" ) ) VAR mi = IF ( nm > 0, mq & " à produire", "demande de la version " & FORMAT ( vm, "0" ) & " en cours" ) RETURN IF ( NOT du || ISBLANK ( e ) || ISBLANK ( a ), BLANK (), IF ( ISBLANK ( vm ), "aucune version", IF ( et = "périmé", "version " & FORMAT ( vm, "0" ) & " périmée le " & FORMAT ( pe, "dd/MM/yyyy" ), IF ( et = "incomplet", "version " & FORMAT ( vm, "0" ) & " : " & mi, "version " & FORMAT ( vm, "0" ) & " produite le " & FORMAT ( pl, "dd/MM/yyyy" ) ) ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 0defbf8d-253d-4beb-901a-238ed40efc6e

