/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table ref_arrete
	lineageTag: 8ceccea3-e3c4-4c88-8571-79449f35e86a

	measure 'Message arrete' = CALCULATE ( MAX ( ref_arrete[message_ecran] ), ref_arrete[est_arrete_client] = TRUE () )
		displayFolder: Ecran 1 Client
		lineageTag: 7f12305e-596a-4210-a6f4-bb1f2cab054f

	measure 'Arrete ouvert' = VAR e = SELECTEDVALUE ( ref_arrete[entite] ) VAR a = SELECTEDVALUE ( ref_arrete[arrete] ) VAR o = CALCULATE ( MAX ( arrete_mission[ouvert_le] ), FILTER ( ALL ( arrete_mission ), arrete_mission[entite] = e && arrete_mission[arrete] = a ) ) RETURN IF ( ISBLANK ( o ), "à ouvrir", "ouvert le " & FORMAT ( o, "dd/mm/yyyy" ) )
		displayFolder: Ecran 1 Client
		lineageTag: b619a3c5-911e-41b3-a2dd-f780f988ba86

