	measure 'Carte livrables sous-titre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = ADDCOLUMNS ( FILTER ( ALL ( ref_livrable ), ref_livrable[produit_etape_6] = TRUE () ), "et", CALCULATE ( [Etat du livrable] ) ) VAR n1 = COUNTROWS ( FILTER ( t, [et] = "demande posée" ) ) + 0 VAR n2 = COUNTROWS ( FILTER ( t, [et] = "refusé" ) ) + 0 VAR n3 = COUNTROWS ( FILTER ( t, [et] = "périmé" ) ) + 0 VAR n4 = COUNTROWS ( FILTER ( t, [et] = "à produire" ) ) + 0 VAR n5 = COUNTROWS ( FILTER ( t, [et] = "incomplet" ) ) + 0 VAR nh = COUNTROWS ( FILTER ( t, [et] = "sans objet" ) ) + 0 VAR hb = MAXX ( FILTER ( t, [et] = "sans objet" ), SWITCH ( ref_livrable[code], "COMPTES_ANNUELS", "comptes annuels", "ATTESTATION", "rapport", "DIP", "DIP", ref_livrable[code] ) ) VAR p = { ( 1, IF ( n1 > 0, FORMAT ( n1, "0" ) & IF ( n1 > 1, " demandes posées", " demande posée" ) ) ), ( 2, IF ( n2 > 0, FORMAT ( n2, "0" ) & IF ( n2 > 1, " refusés", " refusé" ) ) ), ( 3, IF ( n3 > 0, FORMAT ( n3, "0" ) & IF ( n3 > 1, " périmés", " périmé" ) ) ), ( 4, IF ( n5 > 0, FORMAT ( n5, "0" ) & IF ( n5 > 1, " incomplets", " incomplet" ) ) ), ( 5, IF ( n4 > 0, FORMAT ( n4, "0" ) & " à produire" ) ), ( 6, IF ( nh = 1, hb & " sans objet", IF ( nh > 1, FORMAT ( nh, "0" ) & " sans objet" ) ) ) } RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), CONCATENATEX ( FILTER ( p, [Value2] <> "" ), [Value2], ", ", [Value1], ASC ) & "" )
		displayFolder: Ecran 2 etape 6
		lineageTag: bf6a0801-06c2-4ff0-bc39-d4e7f6f42d01

	measure 'Carte livrables encre' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR t = ADDCOLUMNS ( FILTER ( ALL ( ref_livrable ), ref_livrable[produit_etape_6] = TRUE () ), "et", CALCULATE ( [Etat du livrable] ) ) VAR nd = COUNTROWS ( FILTER ( t, [et] <> "sans objet" ) ) + 0 VAR np = COUNTROWS ( FILTER ( t, [et] = "produit" ) ) + 0 RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "#12233C", IF ( np = nd, "#1F6D4A", "#8A6710" ) )
