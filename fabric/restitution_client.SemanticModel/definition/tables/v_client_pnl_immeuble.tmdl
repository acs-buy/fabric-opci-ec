/// Le compte de resultat locatif, immeuble par immeuble : loyers, entretien, interets, resultat, rendement. Script 141, analytique du 145.
table v_client_pnl_immeuble
	lineageTag: 399993da-1e6b-4090-82fe-2d1755b6c195

	measure 'Immeubles du groupe' = COUNTROWS ( v_client_pnl_immeuble )
		lineageTag: 285f66ae-66f2-4c7f-8bed-67771cdedd03

