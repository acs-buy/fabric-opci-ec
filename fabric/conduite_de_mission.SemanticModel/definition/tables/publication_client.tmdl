	partition publication_client = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_publication_client = Value.NativeQuery(Source, "SELECT id, entite, arrete, visa_id, etat, DATETIME2FROMPARTS(YEAR(publiee_le), MONTH(publiee_le), DAY(publiee_le), DATEPART(HOUR, publiee_le), DATEPART(MINUTE, publiee_le), DATEPART(SECOND, publiee_le), 0, 0) AS publiee_le, publiee_par, motif, DATETIME2FROMPARTS(YEAR(terminee_le), MONTH(terminee_le), DAY(terminee_le), DATEPART(HOUR, terminee_le), DATEPART(MINUTE, terminee_le), DATEPART(SECOND, terminee_le), 0, 0) AS terminee_le FROM dbo.publication_client", null, [EnableFolding = true])
				in
				    dbo_publication_client

