	/// Le véhicule choisi dans le sélecteur de la Révision, sans le filtre de la ligne choisie.
	measure 'Dossier de la revision' = CALCULATE ( SELECTEDVALUE ( ref_entite[Entité] ), REMOVEFILTERS ( liste_clients[cle_ecran], liste_clients[Client], liste_clients[vehicule_denomination], liste_clients[entite], liste_clients[Dénomination], liste_clients[forme_sociale], liste_clients[est_vehicule], liste_clients[quote_part], liste_clients[rang], liste_clients[message_ecran], liste_clients[Entité], liste_clients[ordre_affichage] ) )
		displayFolder: Ecran Client
		lineageTag: d60ce69c-4615-40b7-835f-cee93198228e

	/// 1 quand le sélecteur de la Révision est sur le client de l'écran ou une de ses filiales, vide sinon.
	measure 'Revision sur le client choisi' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( ref_entite ) ) VAR v = [Dossier de la revision] VAR vc = IF ( NOT ISBLANK ( v ), CALCULATE ( [Client selectionne], REMOVEFILTERS ( liste_clients[cle_ecran], liste_clients[Client], liste_clients[vehicule_denomination], liste_clients[entite], liste_clients[Dénomination], liste_clients[forme_sociale], liste_clients[est_vehicule], liste_clients[quote_part], liste_clients[rang], liste_clients[message_ecran], liste_clients[Entité], liste_clients[ordre_affichage] ) ) ) RETURN IF ( NOT ISBLANK ( c ) && vc = c, 1 )
		displayFolder: Ecran Client
		lineageTag: 9910c42d-5bb4-4441-bce5-965dabac53e8

	/// Gris quand la Révision est sur un autre client que celui de l'écran.
	measure 'Fond e5Bouton1' = IF ( [Revision sur le client choisi] = 1, "#FFFFFF", "#E4E9EF" )
		displayFolder: Ecran Client
		lineageTag: 9cb4c1e1-f7bc-4411-bcb6-3b212c6ff726

	measure 'Libelle e5Bouton1' = "Passer à la Révision"
		displayFolder: Ecran Client
		lineageTag: 8d237686-02d2-486c-bfa9-e2a41bede022

	/// L'infobulle du bouton : la page et le véhicule qu'il ouvre, ou pourquoi il est gris.
	measure 'Infobulle e5Bouton1' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( ref_entite ) ) VAR v = [Dossier de la revision] RETURN SWITCH ( TRUE (), ISBLANK ( c ), "Aucun client choisi dans la liste des clients.", [Revision sur le client choisi] = 1, "Ouvre la page Révision sur " & v & ".", ISBLANK ( v ), "Choisissez " & c & " dans « Véhicule » de la page Révision.", "La Révision est ouverte sur " & v & " : choisissez " & c & " dans « Véhicule » de la page Révision." )
		displayFolder: Ecran Client
		lineageTag: 9b7a2aa8-1f92-42be-859f-bb4d40752905

	/// La page que le bouton ouvre, vide quand il est gris.
	measure 'Destination e5Bouton1' = IF ( [Revision sur le client choisi] = 1, "Révision" )
		displayFolder: Ecran Client
		lineageTag: 08db3e2e-637c-4ffb-b286-664354e7346c

	/// Le titre du sous-état 3c : le client, ses pièces et ses rattachements au dossier.
	measure 'En-tête étape 3c' = VAR c = [Client selectionne] VAR np = CALCULATE ( DISTINCTCOUNT ( v_ecran_pieces_du_dossier[piece_id] ), FILTER ( ALL ( v_ecran_pieces_du_dossier ), v_ecran_pieces_du_dossier[entite] = c ) ) + 0 VAR nr = CALCULATE ( COUNTROWS ( v_ecran_pieces_du_dossier ), FILTER ( ALL ( v_ecran_pieces_du_dossier ), v_ecran_pieces_du_dossier[entite] = c ) ) + 0 RETURN IF ( ISBLANK ( c ), "Retirer une pièce du dossier", "Retirer une pièce du dossier · " & c & " · " & IF ( np = 0, "aucune pièce", np & IF ( np = 1, " pièce", " pièces" ) ) & ", " & IF ( nr = 0, "aucun rattachement", nr & IF ( nr = 1, " rattachement", " rattachements" ) ) )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 1bfdb3a8-a6c7-52fd-abe0-5d1e7de0f519

	/// Le titre du sous-état 5b.
	measure 'En-tête étape 5b' = VAR c = [Client selectionne] RETURN IF ( ISBLANK ( c ), "Rouvrir un arrêté clos", c & " · rouvrir un arrêté clos : la demande, puis la décision" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 1ab8bae1-9fac-571d-a67e-0d11a0989979

	measure 'Fond e3cBouton0' = IF ( ISBLANK ( [Client selectionne] ) || NOT ISBLANK ( [Retrait de piece refuse] ), "#E4E9EF", "#0F5C8C" )
		displayFolder: Ecran Client boutons
		lineageTag: 7891930c-838a-4a28-a76e-68ef99b1739f

	measure 'Libelle e3cBouton0' = "Retirer la pièce"
