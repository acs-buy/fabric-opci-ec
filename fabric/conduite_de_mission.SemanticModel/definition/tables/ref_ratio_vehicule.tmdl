/// Seuils propres a un vehicule. Lue par la seule mesure [Seuil propre au vehicule].
table ref_ratio_vehicule
	lineageTag: 82d0fc63-d478-4940-a049-7268aa6d3591

	/// le seuil de ref_ratio_vehicule pour le véhicule et la limite cochée (VAR e, c puis FILTER ALL), à la française, avec sa source : STATUTS « règlement ou statuts du véhicule », GESTIONNAIRE « fixé par le gestionnaire » ; sans ligne, « à remplir » pour une limite qui reçoit un seuil propre pour ce véhi
	measure 'Seuil propre au vehicule' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR pro = COUNTROWS ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e && ref_entite[est_professionnel] = TRUE () ) ) > 0 VAR fv = CALCULATE ( MAX ( ref_entite[forme_vehicule] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ) ) VAR vide = HASONEVALUE ( ref_ratio_memoire[code] ) && ISBLANK ( SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR une = HASONEVALUE ( ref_ratio_memoire[code] ) && NOT vide VAR c = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[code] ) ) VAR lf = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[forme_vehicule] ) ) VAR lsp = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_professionnel] ) ) VAR lsg = IF ( une, SELECTEDVALUE ( ref_ratio_memoire[statut_grand_public] ) ) VAR so = une && ( ( NOT ISBLANK ( lf ) && lf <> fv ) || ( pro && lsp = "SANS_OBJET" ) ) VAR t2 = FILTER ( ALL ( ref_ratio_vehicule ), ref_ratio_vehicule[entite] = e && ref_ratio_vehicule[code] = c ) VAR s = MAXX ( t2, ref_ratio_vehicule[seuil] ) VAR src = MAXX ( t2, ref_ratio_vehicule[source] ) RETURN IF ( vide, BLANK (), ( IF ( NOT une, "", IF ( NOT ISBLANK ( s ), FORMAT ( s, "#,0.00" ) & ", " & IF ( src = "STATUTS", "règlement ou statuts du véhicule", "fixé par le gestionnaire" ), IF ( c = "LEVIER_MAX" || ( pro && c = "EMPRUNT_ESPECES_10" ), "à remplir", "aucun" ) ) ) ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: b098f50b-c11f-4c59-af0a-eb886cbc0a51

