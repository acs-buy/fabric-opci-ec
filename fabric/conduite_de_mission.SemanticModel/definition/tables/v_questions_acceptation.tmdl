/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table v_questions_acceptation
	lineageTag: b1dcde84-77bf-42f2-bd3d-54b0c5bd49ed

	measure 'Reference acceptation selectionnee' = SELECTEDVALUE ( v_questions_acceptation[Réf.] )
		displayFolder: Ecran 1 Client
		lineageTag: 8dc4ed26-4597-4464-b268-bd31847596f4

	measure 'Pieces du questionnaire' = SUM ( v_questions_acceptation[Pièces] )
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: 312a512f-4762-401e-8f14-75f044546037

	measure 'Est questionnaire courant' = VAR c = CALCULATE ( [Cote questionnaire], REMOVEFILTERS ( v_questions_acceptation ) ) RETURN IF ( SELECTEDVALUE ( v_questions_acceptation[cote] ) = c, 1 )
		formatString: 0
		displayFolder: Ecran 1 Client
		lineageTag: 4d8fae93-ac2b-44df-a94f-11d69bf5d959

	measure 'Questions dues du questionnaire' = VAR c = [Cote questionnaire] RETURN CALCULATE ( COUNTROWS ( v_questions_acceptation ), FILTER ( ALL ( v_questions_acceptation ), v_questions_acceptation[cote] = c ) )
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: b482eeb2-8d02-4a6f-84bf-77426cdded8c

	measure 'Questions repondues du questionnaire' = VAR c = [Cote questionnaire] RETURN CALCULATE ( COUNTROWS ( v_questions_acceptation ), FILTER ( ALL ( v_questions_acceptation ), v_questions_acceptation[cote] = c && v_questions_acceptation[etat_ligne] = "REPONDUE" ) )
		formatString: #,0
		displayFolder: Ecran 1 Client
		lineageTag: c47ba6df-7bb9-46b5-90c9-d05d953f773e

	measure 'Sous-titre questionnaire' = VAR r = [Questions repondues du questionnaire] VAR q = [Questions dues du questionnaire] VAR p = [Pieces du client] RETURN IF ( ISBLANK ( q ), "aucun questionnaire ouvert", ( r + 0 ) & " sur " & q & IF ( r > 1, " répondues", " répondue" ) & " · " & ( p + 0 ) & IF ( p > 1, " pièces", " pièce" ) & " · une ligne par question, on y répond directement" )
		displayFolder: Ecran 1 Client
		lineageTag: 74b03cd8-0867-429b-95f7-b9f55b9c7fd9

	measure 'Compteur grille questionnaire' = VAR r = [Questions repondues du questionnaire] VAR q = [Questions dues du questionnaire] VAR aff = MIN ( 10, q ) RETURN IF ( ISBLANK ( q ), BLANK (), ( r + 0 ) & " sur " & q & IF ( r > 1, " répondues", " répondue" ) & " · " & aff & " affichées" & IF ( q > 10, ", la grille défile", "" ) )
		displayFolder: Ecran 1 Client
		lineageTag: b66b97c7-88d5-4a44-8177-db780064d9af

	measure 'Question selectionnee' = VAR c = [Cote questionnaire] VAR r = [Reference acceptation selectionnee] VAR e = CALCULATE ( SELECTEDVALUE ( v_questions_acceptation[Question] ), FILTER ( ALL ( v_questions_acceptation ), v_questions_acceptation[cote] = c && v_questions_acceptation[Réf.] = r ) ) RETURN IF ( ISBLANK ( r ), "Cliquez une question dans la grille pour y répondre", r & " · " & IF ( LEN ( e ) > 90, LEFT ( e, 90 ) & "…", e ) )
		displayFolder: Ecran 1 Client
		lineageTag: 533d97cc-7b3c-4603-98b1-aebd54cc5bfb

	measure 'Questions du client' = VAR a = [Cote acceptation] VAR r = CALCULATE ( COUNTROWS ( v_questions_acceptation ), FILTER ( ALL ( v_questions_acceptation ), v_questions_acceptation[cote] = a && v_questions_acceptation[etat_ligne] = "REPONDUE" ) ) VAR q = CALCULATE ( COUNTROWS ( v_questions_acceptation ), FILTER ( ALL ( v_questions_acceptation ), v_questions_acceptation[cote] = a ) ) RETURN IF ( ISBLANK ( q ), "aucune question ouverte", ( r + 0 ) & " sur " & q )
		displayFolder: Ecran 1 Client

