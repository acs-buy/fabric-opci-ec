	measure 'SIREN du client' = VAR c = [Client selectionne] VAR s = CALCULATE ( SELECTEDVALUE ( ref_entite[siren] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) RETURN IF ( ISBLANK ( s ), "sans SIREN", "SIREN " & LEFT ( s, 3 ) & " " & MID ( s, 4, 3 ) & " " & RIGHT ( s, 3 ) )
		displayFolder: Ecran 1 Client
		lineageTag: 8101ef6b-43ce-4802-b622-8db261b1b355

	measure 'Cloture et VL' = VAR c = [Client selectionne] VAR cl = CALCULATE ( SELECTEDVALUE ( ref_entite[cloture] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) VAR vl = CALCULATE ( SELECTEDVALUE ( ref_entite[periodicite_vl] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) RETURN SUBSTITUTE ( cl, "-", "/" ) & " · " & IF ( ISBLANK ( vl ), "VL à fixer", LOWER ( vl ) )
		displayFolder: Ecran 1 Client
		lineageTag: d227bdcf-d1b3-49dd-8ea5-d0ca23487249

	measure 'Adresse du client' = VAR c = [Client selectionne] VAR x = CALCULATE ( SELECTEDVALUE ( ref_entite[adresse_1] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) VAR p = SEARCH ( " (", x, 1, 0 ) VAR net = IF ( p > 0, TRIM ( LEFT ( x, p - 1 ) ), x ) RETURN IF ( LEN ( net ) > 32, LEFT ( net, 31 ) & "…", net )
		displayFolder: Ecran 1 Client
		lineageTag: d23c5e88-0737-44e6-9f4e-ea0fa78a77c9

	measure 'Dirigeant du client' = VAR c = [Client selectionne] VAR x = CALCULATE ( SELECTEDVALUE ( ref_entite[dirigeant_nom] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) VAR p = SEARCH ( " (", x, 1, 0 ) VAR net = IF ( p > 0, TRIM ( LEFT ( x, p - 1 ) ), x ) RETURN IF ( LEN ( net ) > 32, LEFT ( net, 31 ) & "…", net )
		displayFolder: Ecran 1 Client
		lineageTag: c0ff727a-f9fb-4417-ba03-edb3a76f8c01

	measure 'Contact du client' = VAR c = [Client selectionne] VAR x = CALCULATE ( SELECTEDVALUE ( ref_entite[contact_nom] ), FILTER ( ALL ( ref_entite ), ref_entite[Entité] = c ) ) VAR p = SEARCH ( " (", x, 1, 0 ) VAR net = IF ( p > 0, TRIM ( LEFT ( x, p - 1 ) ), x ) RETURN IF ( LEN ( net ) > 32, LEFT ( net, 31 ) & "…", net )
		displayFolder: Ecran 1 Client
		lineageTag: 16d119f0-f909-4061-990d-15612873259f

