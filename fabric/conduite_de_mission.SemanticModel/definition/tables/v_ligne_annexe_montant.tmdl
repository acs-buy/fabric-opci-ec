/// Les lignes de l'annexe et leurs 7 colonnes, par vehicule et arrete.
table v_ligne_annexe_montant
	lineageTag: e640a2e3-e7c9-4c0e-aca6-44f8ec075ab7

	measure 'Article choisi' = IF ( HASONEVALUE ( v_ligne_annexe_montant[article] ), SELECTEDVALUE ( v_ligne_annexe_montant[article] ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: f1176300-d290-41be-98b8-9d940a2c1e08

	measure 'Ligne choisie' = VAR s = IF ( HASONEVALUE ( v_annexe_cellule[ligne] ), SELECTEDVALUE ( v_annexe_cellule[ligne] ) ) RETURN IF ( NOT ISBLANK ( s ), s, VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR ar = [Article choisi] VAR p = FILTER ( ALL ( v_annexe_cellule ), v_annexe_cellule[entite] = e && v_annexe_cellule[arrete] = a && v_annexe_cellule[article] = ar && ( v_annexe_cellule[nature] IN { "texte", "source" } || v_annexe_cellule[etat] = "A_REMPLIR" ) ) RETURN IF ( COUNTROWS ( p ) = 1, MAXX ( p, v_annexe_cellule[ligne] ) ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 1eafcc7e-2f82-49e5-acaa-647e34d0ed8a

	measure 'Obstacle a la saisie de la cellule' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR u = USERPRINCIPALNAME () VAR j = TODAY () VAR ar = [Article choisi] VAR li = [Ligne choisie] VAR co = [Colonne choisie] VAR ae = COUNTROWS ( FILTER ( ALL ( v_arrete_etat ), v_arrete_etat[entite] = e && v_arrete_etat[arrete] = a ) ) + 0 VAR pr = MAXX ( FILTER ( ALL ( v_arrete_etat ), v_arrete_etat[entite] = e && v_arrete_etat[arrete] = a ), IF ( v_arrete_etat[premier_exercice], 1, 0 ) ) + 0 VAR ee = SWITCH ( ar, "321-2", "BILAN_ACTIF", "321-6", "BILAN_PASSIF", "322-2", "RESULTAT" ) VAR detail = COUNTROWS ( FILTER ( ALL ( v_ligne_etat_montant ), v_ligne_etat_montant[etat] = ee && v_ligne_etat_montant[code] = li && v_ligne_etat_montant[type_ligne] = "DETAIL" ) ) + 0 VAR nl = COUNTROWS ( FILTER ( ALL ( v_annexe_cellule ), v_annexe_cellule[entite] = e && v_annexe_cellule[arrete] = a && v_annexe_cellule[article] = ar && v_annexe_cellule[ligne] = li ) ) + 0 VAR sa = COUNTROWS ( FILTER ( ALL ( role_mission ), role_mission[entite] = e && ( role_mission[connexion] = u || role_mission[personne] = u ) && role_mission[du] <= j && ( ISBLANK ( role_mission[au] ) || role_mission[au] > j ) && role_mission[role] IN { "ASSOCIE", "CHEF_MISSION", "PREPARATEUR", "REVISEUR" } ) ) + 0 VAR cl = MAXX ( FILTER ( ALL ( v_visa_cloture_courant ), v_visa_cloture_courant[entite] = e && v_visa_cloture_courant[arrete] = a ), v_visa_cloture_courant[decision] ) RETURN SWITCH ( TRUE (), ISBLANK ( co ) || NOT ( co IN { "1", "2", "3", "4", "5", "6", "7" } ), "Saisie refusée : la colonne est numérotée de 1 à 7.", ae = 0, "Saisie refusée : l'arrêté " & IF ( ISBLANK ( a ), "vide", a ) & " de l'entité " & IF ( ISBLANK ( e ), "vide", e ) & " n'est pas un arrêté de mission d'un véhicule ; il n'a pas d'annexe.", NOT ISBLANK ( ee ) && detail = 0, "Saisie refusée : la ligne " & IF ( ISBLANK ( li ), "vide", li ) & " n'existe pas à l'article " & ar & ", ou elle se calcule sur les autres lignes.", NOT ISBLANK ( ee ) && ( co <> "2" || pr = 0 ), "Saisie refusée : la colonne N-1 d'un état ne se saisit qu'au 1er exercice suivi.", ISBLANK ( ee ) && NOT ISBLANK ( li ) && nl = 0, "Saisie refusée : la ligne " & li & " n'existe pas à l'article " & IF ( ISBLANK ( ar ), "vide", ar ) & ".", sa = 0, "Saisie refusée : cette personne ne peut pas saisir l'annexe de l'entité " & e & " : elle n'y tient aucun rôle de mission.", cl = "VISE", "Saisie refusée : l'arrêté est validé pour le client ; la saisie suppose sa réouverture.", BLANK () )
		displayFolder: Ecran 2 etape 6
		lineageTag: cf1e4474-cb9d-4f69-9a7b-0e836d811882

	measure 'Ligne de la cellule a enregistrer' = VAR li = [Ligne choisie] RETURN IF ( NOT ISBLANK ( li ) && ISBLANK ( [Obstacle a la saisie de la cellule] ), li )
		displayFolder: Ecran 2 etape 6
		lineageTag: f7ed9c05-dde8-45ab-b497-e398867c14d3

	measure 'Titre de l annexe' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR den = MAXX ( FILTER ( ALL ( ref_entite ), ref_entite[Entité] = e ), ref_entite[Dénomination] ) VAR de = IF ( CONTAINSSTRING ( "aeiouyhéèêàâîôûAEIOUYHÉÈÊÀÂÎÔÛ", LEFT ( den, 1 ) ), "de l’", "de " ) VAR ar = [Article choisi] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), BLANK (), "Annexe " & de & den & " au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) & IF ( ISBLANK ( ar ), "", ", article " & ar ) )
		displayFolder: Ecran 2 etape 6
		lineageTag: 93acbbf9-f2e5-43a5-8d94-ec9b12648764

	measure 'Article choisi libelle' = VAR ar = [Article choisi] RETURN IF ( ISBLANK ( ar ), "", "Article " & ar )
		lineageTag: 0d144076-36c8-42fe-834c-370508a0457f

	measure 'Intitule de l article choisi' = VAR ar = [Article choisi] RETURN IF ( ISBLANK ( ar ), "choisir un article", MAXX ( FILTER ( ALL ( v_ligne_annexe_montant ), v_ligne_annexe_montant[article] = ar ), v_ligne_annexe_montant[tableau] ) & "" )
		lineageTag: bff1f9a7-5502-45ad-bb81-161974a97df0

