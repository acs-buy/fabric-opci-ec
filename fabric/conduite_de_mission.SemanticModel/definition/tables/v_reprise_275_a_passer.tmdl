/// Reste a passer au compte 275, titres de filiales.
table v_reprise_275_a_passer
	lineageTag: d7050fdb-75d9-4fdf-916a-81012ac1dcd2

	/// l’entité quand le reste à passer n’est pas nul, vide sinon
	measure 'Entite si reprise 275' = VAR c = [Client selectionne] VAR a = SUM ( v_reprise_275_a_passer[a_passer] ) VAR lp = CALCULATE ( COUNTROWS ( v_lots_perimetre ), v_lots_perimetre[Entité] = c, v_lots_perimetre[famille] = "DERIVABLE", v_lots_perimetre[Cycle] = "PART", v_lots_perimetre[Statut du lot] = "PROPOSE" ) + 0 RETURN IF ( NOT ISBLANK ( a ) && ABS ( a ) >= 0.005 && lp = 0, c )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 9893bf80-b72b-43d3-a16e-1afb51ecf120

	/// gris quand le reste à passer est nul
	measure 'Fond reprendre 275' = IF ( ISBLANK ( [Entite si reprise 275] ), "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: a0305b34-6bbd-40be-aef6-5fd1714a0138

	/// « reste à passer nul » ; « conditions réunies »
	measure 'Blocage reprise 275' = VAR c = [Client selectionne] VAR a = SUM ( v_reprise_275_a_passer[a_passer] ) VAR lp = CALCULATE ( COUNTROWS ( v_lots_perimetre ), v_lots_perimetre[Entité] = c, v_lots_perimetre[famille] = "DERIVABLE", v_lots_perimetre[Cycle] = "PART", v_lots_perimetre[Statut du lot] = "PROPOSE" ) + 0 RETURN IF ( lp > 0, "lot de reprise proposé, en attente du visa", IF ( ISBLANK ( a ) || ABS ( a ) < 0.005, "reste à passer nul", "conditions réunies" ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 22acd445-db49-40f3-adde-2374af037d8f

