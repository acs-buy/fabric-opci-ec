/// Écran 5, objet n° 45 : relation referentiel → v_ecran_referentiel_choix[table_nom]
table v_ecran_articles_du_referentiel
	lineageTag: 4415729d-abb5-4224-8d70-c45811cf94a0

	/// n° 146, « n articles », n le nombre d’articles distincts du référentiel choisi
	measure 'Sous-titre articles cites' = VAR r = [Referentiel choisi] VAR n = CALCULATE ( DISTINCTCOUNT ( v_ecran_articles_du_referentiel[article] ), FILTER ( ALL ( v_ecran_articles_du_referentiel ), v_ecran_articles_du_referentiel[referentiel] = r ) ) + 0 RETURN IF ( n = 0, "aucun article", FORMAT ( n, "0" ) & IF ( n < 2, " article", " articles" ) )
		displayFolder: Ecran 5 Referentiels
		lineageTag: f19bec00-4b6c-481d-b069-be8eb5d6867b

	/// n° 156, « Aucun article cité par une clé » quand la table est vide
	measure 'Absence d article cite' = VAR r = [Referentiel choisi] RETURN IF ( NOT ISBLANK ( r ) && ISEMPTY ( FILTER ( ALL ( v_ecran_articles_du_referentiel ), v_ecran_articles_du_referentiel[referentiel] = r ) ), "Aucun article cité par une clé", "" )
		displayFolder: Ecran 5 Referentiels
		lineageTag: e4a4f15e-783d-4321-a579-13e995836de2

