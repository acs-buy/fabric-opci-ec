                    "rootFolder": "Files"
                  },
                  "annotations": []
                }
              },
              "annotations": []
            }
          },
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "typeConversionSettings": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          },
          "enableStaging": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "ecrire_le_profil_analytique",
        "description": "Les 22 colonnes du profil analytique, destine au logiciel de production du cabinet et jamais remis a l'administration. Son nom porte le code de l'entite, l'arrete et le profil, et ne porte pas la forme de l'article : paragraphe 5.4 de la conception.",
        "dependsOn": [
          {
            "activity": "ecrire_le_profil_fiscal",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "entite": {
        "type": "string"
      },
      "arrete": {
        "type": "string"
      }
    }
  }
