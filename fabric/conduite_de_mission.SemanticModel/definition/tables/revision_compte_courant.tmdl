/// Revisions a la baisse des avances en compte courant, art. 213-4.
table revision_compte_courant
	lineageTag: 2490c167-0159-475a-bdb2-de4b430a4236

	/// le montant révisé de l’avance de la ligne (grille 1b)
	measure 'Montant revise de l avance' = VAR f = SELECTEDVALUE ( v_differences_comptes_courants[entite_liee] ) RETURN IF ( NOT ISBLANK ( f ), CALCULATE ( SUM ( revision_compte_courant[montant_revise] ), FILTER ( ALL ( revision_compte_courant[entite_fille] ), revision_compte_courant[entite_fille] = f ) ) )
		formatString: #,0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 2d16846b-b1df-4612-a60e-47ee839dd50e

	/// les révisions de la filiale liée à l’avance choisie ; filtre de visuel = 1, évalué révision par révision : l’id de la révision est dans la granularité du tableEx
	measure 'Filtre revisions de l avance choisie' = VAR c = [Avance choisie] VAR f = CALCULATE ( MAX ( v_differences_comptes_courants[entite_liee] ), FILTER ( ALL ( v_differences_comptes_courants[code_actif] ), v_differences_comptes_courants[code_actif] = c ) ) RETURN IF ( NOT ISBLANK ( f ) && SELECTEDVALUE ( revision_compte_courant[entite_fille] ) = f, 1 )
		formatString: 0
		displayFolder: Ecran 3 Valorisation
		lineageTag: 54cdd9ef-2d13-426e-9ea1-669ba0e1017e

	/// « n révisions » ; « aucune »
	measure 'Revisions de l arrete' = VAR n = COUNTROWS ( revision_compte_courant ) + 0 RETURN IF ( n > 0, FORMAT ( n, "0" ) & " révisions", "aucune" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 86c6f82c-8ecf-433f-894e-c97e16aa67fc

