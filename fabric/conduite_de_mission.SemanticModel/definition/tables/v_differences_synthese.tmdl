/// Les differences d'estimation par famille d'actif, entite et arrete : valeur comptable, valeur actuelle, difference, article du reglement ANC 2021-09. Source du pont comptable vers actuel du tableau de bord du dossier. Ajoutee le 09/09/2026.
table v_differences_synthese
	lineageTag: 68a75602-4701-4f3f-a37a-abb234c4f948

	/// Valeur comptable des actifs des familles filtrees.
	measure 'Valeur comptable des actifs' = SUM(v_differences_synthese[valeur_comptable])
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 56098b47-20fb-4129-85b9-9919479ef78a

	/// Valeur actuelle des actifs, articles 211-6, 212-4 et 213-4.
	measure 'Valeur actuelle des actifs' = SUM(v_differences_synthese[valeur_actuelle])
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 37648b93-ce93-4cfc-ba47-c88af26629a1

	/// Ecart entre valeur actuelle et valeur comptable, par famille.
	measure 'Difference d estimation des actifs' = SUM(v_differences_synthese[difference_estimation])
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 5bf0655b-2859-4886-b15a-d5ea8805ba89

	/// Nombre d'actifs portes par les familles filtrees.
	measure 'Actifs evalues' = SUM(v_differences_synthese[nombre_actifs]) + 0
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 710134d2-11dd-4db5-8ff4-af52becb3c9c

	/// Ecart entre la difference d'estimation lue sur les actifs (vue de synthese) et celle comptabilisee dans les ecritures (v_anr_entite). Un ecart non nul est une anomalie du dossier, controle 153 du 09/09/2026.
	measure 'Ecart actifs moins ecritures' = [Difference d estimation des actifs] - [Differences d estimation]
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: d5d38e8a-d26a-4c86-ab13-1ff9a09144ed

	/// Differences d'estimation lues sur les actifs, entite et arrete affiches.
	measure 'Differences des actifs du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Difference d estimation des actifs], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 68170126-ee9e-4f6b-a7f9-871a314680aa

	/// Valeur comptable des actifs, entite et arrete affiches.
	measure 'Valeur comptable du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Valeur comptable des actifs], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: a10f370f-968a-4a32-8618-8d3f0afdb2b0

	/// Valeur actuelle des actifs, entite et arrete affiches.
	measure 'Valeur actuelle du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Valeur actuelle des actifs], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: e94f5830-437b-4eb6-b681-99e1410bb3ef

	/// Ecart actifs moins ecritures, entite et arrete affiches ; controle 153.
	measure 'Ecart du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Ecart actifs moins ecritures], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 0f1a5651-79a7-412e-89d0-947a416467ab

	/// Carte 3.2, Valeur comptable. Arbitree le 15/09/2026 par la session de la base.
	measure 'R32 Valeur comptable' = SUM ( v_differences_synthese[valeur_comptable] )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 63eff262-b1cc-4bdf-9364-926ae0c2ff10

	/// Carte 3.2, Valeur actuelle. Arbitree le 15/09/2026 par la session de la base.
	measure 'R32 Valeur actuelle' = SUM ( v_differences_synthese[valeur_actuelle] )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: e1b329de-affc-4c4c-8cb9-d80d136f75b2

	/// Carte 3.2, Difference d estimation. Arbitree le 15/09/2026 par la session de la base.
	measure 'R32 Difference d estimation' = SUM ( v_differences_synthese[difference_estimation] )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: aa0bd572-a4f9-427c-bf98-4c8644913ae2

	/// Carte 3.2, sous-titre de la carte Valeur comptable. Arbitree le 15/09/2026 par la session de la base.
	measure 'R32 Actifs valorises' = SUM ( v_differences_synthese[nombre_actifs] )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 1993aeb7-e4ab-4619-9dc0-cf9f18a15201

	/// Carte 3.2, Familles servies. Arbitree le 15/09/2026 par la session de la base.
	measure 'R32 Familles servies' = CALCULATE ( DISTINCTCOUNT ( v_differences_synthese[famille] ), v_differences_synthese[nombre_actifs] > 0 )
		formatString: #,0
		displayFolder: Rapports V2
		lineageTag: 505a1e6f-b6ab-472e-ab8e-6cf6ec949fad

