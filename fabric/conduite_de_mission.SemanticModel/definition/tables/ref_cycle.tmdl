table ref_cycle
	lineageTag: bd25e0c8-963f-499e-8c9d-0d6912dcee61

	measure 'Cycle selectionne' = IF ( HASONEVALUE ( ref_cycle[code] ), SELECTEDVALUE ( ref_cycle[code] ) )

	column code
		dataType: string
		isNullable: false
		sourceProviderType: varchar(10)
		lineageTag: e44b2b09-2f49-4fd1-97dc-4cb7a3569f5e
