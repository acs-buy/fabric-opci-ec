	partition modele_feuille = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_modele_feuille = Value.NativeQuery(Source, "SELECT code, libelle, standard, nom_fichier, chemin_coffre, empreinte_sha256, version, en_vigueur_depuis, modifie_par, DATETIME2FROMPARTS(YEAR(modifie_le), MONTH(modifie_le), DAY(modifie_le), DATEPART(HOUR, modifie_le), DATEPART(MINUTE, modifie_le), DATEPART(SECOND, modifie_le), 0, 0) AS modifie_le, objectif, ecartee_le, ecartee_par, motif_ecart FROM dbo.modele_feuille", null, [EnableFolding = true])
				in
				    dbo_modele_feuille

