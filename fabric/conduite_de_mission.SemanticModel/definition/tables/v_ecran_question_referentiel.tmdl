	partition v_ecran_question_referentiel = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_v_ecran_question_referentiel = Value.NativeQuery(Source, "SELECT cle_ecran, question_id, reference, cycle, phase, section, enonce, type_reponse, options, doc_attendu, obligatoire, applicabilite, statut, ordre, en_vigueur_depuis, modifie_par, DATETIME2FROMPARTS(YEAR(modifie_le), MONTH(modifie_le), DAY(modifie_le), DATEPART(HOUR, modifie_le), DATEPART(MINUTE, modifie_le), DATEPART(SECOND, modifie_le), 0, 0) AS modifie_le, fondement_articles, fondement_paragraphes, fondement_texte, modele_ecriture, modele_feuille, cycle_ou_phase, niveau_programme, repondue_dans, statut_libelle, applicabilite_libelle, modele_ecriture_libelle, niveau_libelle, derniere_modification FROM dbo.v_ecran_question_referentiel", null, [EnableFolding = true])
