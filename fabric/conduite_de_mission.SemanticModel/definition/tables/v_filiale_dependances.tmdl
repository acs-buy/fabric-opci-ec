		lineageTag: 80696b7a-f854-48c8-9841-6c4b6a05baf0

	/// Pourquoi la filiale choisie ne se supprime pas, vide quand elle se supprime.
	measure 'Retrait de filiale refuse' = VAR f = [Filiale selectionnee] VAR s = CALCULATE ( SELECTEDVALUE ( v_filiale_dependances[supprimable] ), FILTER ( ALL ( v_filiale_dependances ), v_filiale_dependances[Filiale] = f ) ) RETURN IF ( NOT ISBLANK ( f ) && s <> TRUE (), f & " porte des arrêtés, des pièces ou des écritures : elle ne se supprime pas." )
		displayFolder: Ecran Client
		lineageTag: 95abc706-7657-4626-be17-ae9d89d78cf6

