/// Les valeurs liquidatives publiees.
table publication_vl
	lineageTag: 8083646f-e922-4995-b90f-db9608b5faac

	/// « par x, le jj/mm/aaaa » de la dernière publication
	measure 'VL publiee par le' = VAR t = TOPN ( 1, publication_vl, publication_vl[publie_le], DESC ) RETURN MAXX ( t, "par " & publication_vl[publie_par] & ", le " & FORMAT ( publication_vl[publie_le], "dd/MM/yyyy" ) )
		displayFolder: Ecran 3 Valorisation
		lineageTag: 47478f2b-788f-4610-b3a1-2b409465c6e7

	/// alerte quand la VL publiée diffère de [R41 Valeur liquidative] (fiche de la VL)
	measure 'Couleur ecart publiee' = VAR p = [VL publiee de la ligne] VAR v = [R41 Valeur liquidative] RETURN IF ( NOT ISBLANK ( p ) && NOT ISBLANK ( v ) && ROUND ( p - v, 2 ) <> 0, "#9A2A2A", "#12233C" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 124feecc-7e29-4f52-9ada-9cc4690d3cba

	/// VL publiée moins [R41 Valeur liquidative], « + x » à la française ; vide sans publication ou sans valeur calculée (carte collée, & "")
	measure 'Ecart publiee moins calculee' = VAR p = [VL publiee de la ligne] VAR v = [R41 Valeur liquidative] RETURN IF ( ISBLANK ( p ) || ISBLANK ( v ), "", IF ( ROUND ( ( p - v ), 2 ) < 0, "-" & FORMAT ( ABS ( ( p - v ) ), "#,0.00" ), IF ( ROUND ( ( p - v ), 2 ) > 0, "+ " & FORMAT ( ( p - v ), "#,0.00" ), "0,00" ) ) ) & ""
		displayFolder: Ecran 4 Arrete
		lineageTag: c71496df-28c7-4688-ab86-26d70590508d

	/// jj/mm/aaaa de la publication de l’arrêté de la ligne
	measure 'Publiee le de la ligne' = VAR a2 = COALESCE ( SELECTEDVALUE ( v_valeur_liquidative[arrete] ), [Arrete selectionne] ) VAR e = [Client selectionne] RETURN FORMAT ( MAXX ( FILTER ( ALL ( publication_vl ), publication_vl[entite] = e && publication_vl[arrete] = a2 && ISBLANK ( publication_vl[perimee_le] ) ), publication_vl[publie_le] ), "dd/MM/yyyy" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 2946092b-f490-47c8-9a92-ee509fd74ccf

	/// la VL publiée de l’arrêté de la ligne (VAR a puis FILTER ALL), la grille ne joignant pas 2 tables côté plusieurs
	measure 'VL publiee de la ligne' = VAR a2 = COALESCE ( SELECTEDVALUE ( v_valeur_liquidative[arrete] ), [Arrete selectionne] ) VAR e = [Client selectionne] RETURN MAXX ( FILTER ( ALL ( publication_vl ), publication_vl[entite] = e && publication_vl[arrete] = a2 && ISBLANK ( publication_vl[perimee_le] ) ), publication_vl[valeur_liquidative] )
		formatString: #,0.00
		displayFolder: Ecran 4 Arrete
		lineageTag: 647419fd-468b-4918-8917-cfd30cb0ac19

	/// vert quand [Arrete etape 2 faite] vaut 1, gris sinon
	measure 'Fond arrete etape 2' = IF ( [Arrete etape 2 faite] = 1, "#1F6D4A", "#D5DCE4" )
		displayFolder: Ecran 4 Arrete
		lineageTag: bfb5bd6e-c1b9-4347-bcb4-af068c78efcd

	/// 1 quand l’arrêté porte une publication non périmée (perimee_le vide) ; 0 sinon, après une réouverture comprise
	measure 'Arrete etape 2 faite' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] RETURN IF ( COUNTROWS ( FILTER ( ALL ( publication_vl ), publication_vl[entite] = e && publication_vl[arrete] = a && ISBLANK ( publication_vl[perimee_le] ) ) ) > 0, 1, 0 )
		formatString: 0
		displayFolder: Ecran 4 Arrete
		lineageTag: a0546364-c7fb-4c93-a88d-7af6057cb0e2

	/// alerte quand la VL publiée diffère de la calculée (carte 3)
	measure 'Encre VL publiee' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR p = MAXX ( FILTER ( ALL ( publication_vl ), publication_vl[entite] = e && publication_vl[arrete] = a && ISBLANK ( publication_vl[perimee_le] ) ), publication_vl[valeur_liquidative] ) VAR v = [R41 Valeur liquidative] RETURN IF ( NOT ISBLANK ( p ) && NOT ISBLANK ( v ) && ROUND ( p - v, 2 ) <> 0, "#9A2A2A", "#12233C" )
		displayFolder: Ecran 4 Arrete
		lineageTag: 6be8579f-9187-4129-b16a-8eb01abc9915

	/// « le jj/mm/aaaa · écart x sur la calculée » ; « le jj/mm/aaaa » sans valeur calculée ; « aucune publication à l’arrêté » (carte 3, ligne « Publication à l’arrêté » de l’étape 2)
	measure 'Sous-ligne VL publiee' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR t = FILTER ( ALL ( publication_vl ), publication_vl[entite] = e && publication_vl[arrete] = a && ISBLANK ( publication_vl[perimee_le] ) ) VAR p = MAXX ( t, publication_vl[valeur_liquidative] ) VAR d = MAXX ( t, publication_vl[publie_le] ) VAR v = [R41 Valeur liquidative] RETURN IF ( ISBLANK ( d ), "aucune publication à l’arrêté", "le " & FORMAT ( d, "dd/MM/yyyy" ) & IF ( ISBLANK ( v ), "", " · écart " & IF ( ROUND ( ( p - v ), 2 ) < 0, "-" & FORMAT ( ABS ( ( p - v ) ), "#,0.00" ), IF ( ROUND ( ( p - v ), 2 ) > 0, "+ " & FORMAT ( ( p - v ), "#,0.00" ), "0,00" ) ) & " sur la calculée" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: da5aa2cd-bf43-46cf-8ac2-0a671438f690

	/// la VL de la publication non périmée de l’arrêté (perimee_le vide) ; « aucune » (carte 3)
	measure 'VL publiee de l arrete' = VAR e = [Client selectionne] VAR a = [Arrete selectionne] VAR p = MAXX ( FILTER ( ALL ( publication_vl ), publication_vl[entite] = e && publication_vl[arrete] = a && ISBLANK ( publication_vl[perimee_le] ) ), publication_vl[valeur_liquidative] ) RETURN IF ( ISBLANK ( p ), "aucune", FORMAT ( p, "#,0.00" ) )
		displayFolder: Ecran 4 Arrete
		lineageTag: 67e061e4-1fb9-4f8e-afde-432e97a4d376

