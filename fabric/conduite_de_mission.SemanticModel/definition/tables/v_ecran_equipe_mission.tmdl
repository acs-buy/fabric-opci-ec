/// Ajoutee le 15/09/2026 pour la V2 du front office. Colonnes lues en base. Sa relation vers ref_entite reste a poser : la colonne d'entite est arbitree par la session de la base.
table v_ecran_equipe_mission
	lineageTag: bf82b2e4-a9c3-443d-b9fa-0fbb25f797e5

	measure 'Est equipe du client courant' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( v_ecran_equipe_mission ) ) RETURN IF ( SELECTEDVALUE ( v_ecran_equipe_mission[entite] ) = c, 1 )
		formatString: 0

	measure 'Role selectionne' = SELECTEDVALUE ( v_ecran_equipe_mission[role_code] )

	measure 'Titre equipe' = VAR c = [Client selectionne] VAR n = CALCULATE ( COUNTROWS ( v_ecran_equipe_mission ), FILTER ( ALL ( v_ecran_equipe_mission ), v_ecran_equipe_mission[entite] = c && v_ecran_equipe_mission[a_designer] = FALSE () ) ) VAR t = CALCULATE ( COUNTROWS ( v_ecran_equipe_mission ), FILTER ( ALL ( v_ecran_equipe_mission ), v_ecran_equipe_mission[entite] = c && TRUE () ) ) RETURN ( n + 0 ) & " rôle(s) sur " & ( t + 0 ) & " tenu(s)"

	measure 'Alerte equipe' = VAR c = [Client selectionne] VAR cumul = CALCULATE ( COUNTROWS ( v_ecran_equipe_mission ), FILTER ( ALL ( v_ecran_equipe_mission ), v_ecran_equipe_mission[entite] = c && v_ecran_equipe_mission[cumul_a_signaler] = TRUE () ) ) VAR manquants = CALCULATE ( COUNTROWS ( v_ecran_equipe_mission ), FILTER ( ALL ( v_ecran_equipe_mission ), v_ecran_equipe_mission[entite] = c && v_ecran_equipe_mission[a_designer] = TRUE () ) ) VAR sans = CALCULATE ( COUNTROWS ( v_ecran_equipe_mission ), FILTER ( ALL ( v_ecran_equipe_mission ), v_ecran_equipe_mission[entite] = c && v_ecran_equipe_mission[sans_connexion] = TRUE () ) ) RETURN IF ( cumul > 0, "L'associé signataire et le chef de mission sont la même personne : la séparation des fonctions n'est pas tenue sur ce dossier.", IF ( manquants > 0, ( manquants + 0 ) & " rôle(s) à désigner : le visa attend un associé signataire.", IF ( sans > 0, ( sans + 0 ) & " personne(s) sans connexion : elles ne seront pas reconnues à l'écran.", BLANK () ) ) )

	measure 'Fond alerte equipe' = IF ( ISBLANK ( [Alerte equipe] ), "#FFFFFF", "#FAF2E2" )

