/// Les demandes de réouverture d'un arrêté clos, leur auteur, leur décision.
table v_ecran_demandes_reouverture
	lineageTag: c2928105-7691-5805-928e-b2e8bdd6b4cd

	/// 1 quand la ligne est une demande du client choisi.
	measure 'Est demande du client courant' = VAR c = CALCULATE ( [Client selectionne], REMOVEFILTERS ( v_ecran_demandes_reouverture ) ) RETURN IF ( NOT ISBLANK ( c ) && NOT ISEMPTY ( FILTER ( v_ecran_demandes_reouverture, v_ecran_demandes_reouverture[entite] = c ) ), 1 )
		formatString: 0
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: e5a8580e-5fb1-5e13-8bb8-8087b10ff810

	/// La demande en attente sur l'arrêté choisi, ou son absence.
	measure 'Demande en attente' = VAR c = [Client selectionne] VAR a = [Arrete choisi reouverture] VAR d = FILTER ( ALL ( v_ecran_demandes_reouverture ), v_ecran_demandes_reouverture[entite] = c && v_ecran_demandes_reouverture[arrete] = a && v_ecran_demandes_reouverture[etat] = "EN_ATTENTE" ) VAR jour = CALCULATE ( MAX ( v_ecran_arretes[Arrêté] ), FILTER ( ALL ( v_ecran_arretes ), v_ecran_arretes[entite] = c && v_ecran_arretes[arrete] = a ) ) VAR p = MAXX ( d, v_ecran_demandes_reouverture[Demandée par] ) VAR de = IF ( CONTAINSSTRING ( "AEIOUYÉÈÊÀÂÎÔÛ", LEFT ( p, 1 ) ), "d'", "de " ) RETURN IF ( ISBLANK ( a ), "", IF ( ISEMPTY ( d ), "Aucune demande n'attend sur l'arrêté du " & jour & ".", "Demande " & de & p & " du " & MAXX ( d, v_ecran_demandes_reouverture[Demandée le] ) & " pour l'arrêté du " & jour & ", en attente de décision." ) )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: 5cc8ae6b-39d8-5902-a11d-f4e40ef15efb

	/// Le fond de la cellule « État » d'une demande en attente.
	measure 'Fond etat demande' = IF ( SELECTEDVALUE ( v_ecran_demandes_reouverture[État] ) = "En attente", "#FAF2E2" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: e1a421f4-a779-5bc6-9d4d-55f6093636f1

	/// L'encre de la cellule « État » d'une demande en attente.
	measure 'Encre etat demande' = IF ( SELECTEDVALUE ( v_ecran_demandes_reouverture[État] ) = "En attente", "#8A6710", "#12233C" )
		displayFolder: Ecran Client retirer et rouvrir
		lineageTag: e7d2d77b-5eb4-5af7-ad1f-00181edcae12

