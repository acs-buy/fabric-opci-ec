		mode: directQuery
		source =
				let
				    Source = Sql.Database("ra6uvi3ttf5e5kzvtpixiyxumu-5pgdmplbuqqu5iuftzacs77jay.database.fabric.microsoft.com", "DossierOPCI-fd9080bb-e3ae-4aab-bf09-edbfcc8606d1"),
				    dbo_v_rapport_expert_comptable = Value.NativeQuery(Source, "SELECT entite, arrete, soumise_commissariat_comptes, forme_arretee, forme_arretee_libelle, arretee_par, DATETIME2FROMPARTS(YEAR(arretee_le), MONTH(arretee_le), DAY(arretee_le), DATEPART(HOUR, arretee_le), DATEPART(MINUTE, arretee_le), DATEPART(SECOND, arretee_le), 0, 0) AS arretee_le, forme_proposee, forme_proposee_libelle, forme_du_texte, intitule, texte, motif_limitation, motif_considerations_particulieres, comptes_annuels_ou_intermediaires, entite_concernee, exercice, date_arrete, total_du_bilan, chiffre_d_affaires, chiffre_d_affaires_lecture, resultat_net_comptable, lettre_de_mission_du, description_des_points, lieu_date_signature, source FROM dbo.v_rapport_expert_comptable", null, [EnableFolding = true])
