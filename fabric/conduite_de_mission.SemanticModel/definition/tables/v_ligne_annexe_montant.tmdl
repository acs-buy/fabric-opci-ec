	measure 'Titre du tableau 335-8' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR d = [Devise de l annexe] RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", "Revenus financiers au " & MID ( a, 9, 2 ) & "/" & MID ( a, 6, 2 ) & "/" & LEFT ( a, 4 ) & IF ( ISBLANK ( d ) || d = "", "", IF ( d = "à remplir", ", devise à remplir", " en " & d ) ) )
