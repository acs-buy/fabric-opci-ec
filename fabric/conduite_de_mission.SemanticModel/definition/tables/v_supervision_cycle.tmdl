/// La supervision par entite, arrete et cycle : a viser, vises, renvoyes, decisions, etat du cycle. Tableau de bord Revision et supervision. Ajoutee le 09/09/2026.
table v_supervision_cycle
	lineageTag: 7a26f8ae-9370-4891-9ccc-3e3eba9f44a1

	/// Lignes entite, arrete, cycle.
	measure 'Lignes de supervision' = COUNTROWS(v_supervision_cycle) + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: c5f9925b-81ec-46ce-b21e-7f09bc1f6507

	/// Objets en attente de visa.
	measure 'En attente de visa' = SUM(v_supervision_cycle[a_viser]) + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 81beb009-5fcd-497b-8201-78acb1829285

	/// Objets vises.
	measure 'Objets vises' = SUM(v_supervision_cycle[vises]) + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: 25c518e5-35a5-4fb2-84ba-2d93adc2b6bb

	/// Objets renvoyes.
	measure 'Objets renvoyes' = SUM(v_supervision_cycle[renvoyes]) + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: e1ac899f-e8a3-4960-bf32-54eb907b3aac

	/// Decisions prises.
	measure 'Decisions prises' = SUM(v_supervision_cycle[decisions]) + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: e591d83e-c9d0-4e8f-be6f-3375db84ba0e

	/// Lignes de cycle, a ventiler par etat_cycle.
	measure 'Cycles par etat' = COUNTROWS(v_supervision_cycle) + 0
		formatString: #,0
		displayFolder: Parcours
		lineageTag: d1de1131-a875-489d-a74b-e1c0748d6f4e

	/// En attente de visa, entite et arrete affiches.
	measure 'En attente du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([En attente de visa], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: bc917a3a-5845-4298-9a09-de018e3deb6e

	/// Objets vises, entite et arrete affiches.
	measure 'Vises du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Objets vises], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: dfc3d0de-65b5-4c37-86fd-dc63fb6f99d2

	/// Objets renvoyes, entite et arrete affiches.
	measure 'Renvoyes du dossier' = VAR e = [Entite courante] VAR a = [Arrete courant] RETURN CALCULATE([Objets renvoyes], ref_entite[Entité] = e, v_dim_arrete[arrete] = a)
		formatString: #,0
		displayFolder: Le dossier
		lineageTag: 67c1410e-7128-43ba-95d8-a9bf228e2f3d

