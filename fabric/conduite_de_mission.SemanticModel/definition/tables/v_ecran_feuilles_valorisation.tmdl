/// Feuilles VALO et PART, conclusions et derogations.
table v_ecran_feuilles_valorisation
	lineageTag: 99d3b3e0-a0ea-499b-b1cb-17a84d1fa0b9

	/// même règle, segment « Feuille »
	measure 'Avis creer la derogation' = VAR p1 = IF ( ISFILTERED ( v_ecran_feuilles_valorisation[cote] ) && COUNTROWS ( VALUES ( v_ecran_feuilles_valorisation[cote] ) ) >= 2, "Une seule valeur à cocher dans « Feuille »." ) VAR j1 = p1 RETURN IF ( j1 = "", "", j1 ) & ""
		displayFolder: Ecran 3 Valorisation
		lineageTag: 27e4e78d-d15f-4744-b8f2-6e34049e0e17

	/// gris quand [Avis creer la derogation] n’est pas vide
	measure 'Fond creer la derogation' = IF ( [Avis creer la derogation] <> "", "#D9DFE6", "#0F5C8C" )
		displayFolder: Ecran 3 Valorisation
		lineageTag: e74e4a07-62b1-4fa8-98d1-e9ddf8b2f536

