	measure 'Rapport comptes' = VAR e = [Entite selectionnee] VAR a = [Arrete selectionne] VAR tr = FILTER ( ALL ( v_rapport_expert_comptable ), v_rapport_expert_comptable[entite] = e && v_rapport_expert_comptable[arrete] = a ) VAR x = VAR c = MAXX ( tr, v_rapport_expert_comptable[comptes_annuels_ou_intermediaires] ) RETURN IF ( ISBLANK ( c ), BLANK (), c & ", exercice clos le " & FORMAT ( MAXX ( tr, v_rapport_expert_comptable[date_arrete] ), "dd/MM/yyyy" ) ) RETURN IF ( ISBLANK ( e ) || ISBLANK ( a ), "", IF ( ISBLANK ( x ) || x = "", "à remplir", x & "" ) )
